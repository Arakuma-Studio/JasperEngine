{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 27, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Editor tree (editor + shared engine). tools/build.sh overrides binaryDir with -B and adds the ccache launcher; see docs/testing.md",
      "binaryDir": "${sourceDir}/build/presets/${presetName}",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/presets/${presetName}-install"
      }
    },
    { "name": "release", "hidden": true, "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "debug", "hidden": true, "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    {
      "name": "asan", "hidden": true, "inherits": "debug",
      "cacheVariables": { "JASPERENGINE_SANITIZE": "address;undefined", "JASPERENGINE_TESTS": "ON" }
    },
    {
      "name": "msvc", "hidden": true,
      "description": "Needs the MSVC developer environment (vcvars64 / ilammy/msvc-dev-cmd)",
      "cacheVariables": { "CMAKE_C_COMPILER": "cl", "CMAKE_CXX_COMPILER": "cl" }
    },

    { "name": "linux-release", "displayName": "Linux Release (OpenGL)", "inherits": "release" },
    { "name": "linux-debug", "displayName": "Linux Debug (OpenGL)", "inherits": "debug" },
    {
      "name": "linux-vulkan-release", "displayName": "Linux Release (Vulkan)", "inherits": "release",
      "cacheVariables": { "GRAPHIC_BACKEND": "vulkan" }
    },
    { "name": "linux-asan", "displayName": "Linux Debug, ASan + UBSan, with tests", "inherits": "asan" },
    {
      "name": "linux-tsan", "displayName": "Linux Debug, TSan, with tests", "inherits": "debug",
      "cacheVariables": { "JASPERENGINE_SANITIZE": "thread", "JASPERENGINE_TESTS": "ON" }
    },
    {
      "name": "linux-unity", "displayName": "Linux Release, unity build (checks unity-safety; not faster enough to recommend, docs/testing.md)", "inherits": "release",
      "cacheVariables": { "JASPERENGINE_UNITY_BUILD": "ON" }
    },
    {
      "name": "linux-ci", "displayName": "Linux RelWithDebInfo, tests, warnings as errors", "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "JASPERENGINE_TESTS": "ON", "JASPERENGINE_WERROR": "ON" }
    },

    { "name": "windows-msvc-release", "displayName": "Windows MSVC Release (Ninja)", "inherits": ["release", "msvc"] },
    { "name": "windows-msvc-debug", "displayName": "Windows MSVC Debug (Ninja)", "inherits": ["debug", "msvc"] },
    {
      "name": "windows-msvc-asan", "displayName": "Windows MSVC Debug, ASan, with tests (Ninja)", "inherits": ["debug", "msvc"],
      "cacheVariables": { "JASPERENGINE_SANITIZE": "address", "JASPERENGINE_TESTS": "ON" }
    },
    {
      "name": "windows-vs2022", "displayName": "Windows Visual Studio 2022 (IDE)", "inherits": "base",
      "generator": "Visual Studio 17 2022", "architecture": "x64",
      "cacheVariables": { "JASPERENGINE_TESTS": "ON" }
    },

    { "name": "macos-release", "displayName": "macOS Release (Metal)", "inherits": "release" },
    {
      "name": "macos-universal-release", "displayName": "macOS Release, universal (x86_64 + arm64)", "inherits": "release",
      "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "x86_64;arm64" }
    },
    { "name": "macos-asan", "displayName": "macOS Debug, ASan + UBSan, with tests", "inherits": "asan" }
  ],
  "buildPresets": [
    { "name": "linux-release", "configurePreset": "linux-release", "targets": ["jasperengine-editor"] },
    { "name": "linux-debug", "configurePreset": "linux-debug", "targets": ["jasperengine-editor"] },
    { "name": "linux-vulkan-release", "configurePreset": "linux-vulkan-release", "targets": ["jasperengine-editor"] },
    { "name": "linux-asan", "configurePreset": "linux-asan", "targets": ["jasperengine-editor", "jasperengine-editor-tests"] },
    { "name": "linux-tsan", "configurePreset": "linux-tsan", "targets": ["jasperengine-editor", "jasperengine-editor-tests"] },
    { "name": "linux-unity", "configurePreset": "linux-unity", "targets": ["jasperengine-editor"] },
    { "name": "linux-ci", "configurePreset": "linux-ci", "targets": ["jasperengine-editor", "jasperengine-editor-tests"] },
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc-release", "targets": ["jasperengine-editor", "jasperengine-editor-cmd"] },
    { "name": "windows-msvc-debug", "configurePreset": "windows-msvc-debug", "targets": ["jasperengine-editor", "jasperengine-editor-cmd"] },
    { "name": "windows-msvc-asan", "configurePreset": "windows-msvc-asan", "targets": ["jasperengine-editor", "jasperengine-editor-tests"] },
    { "name": "windows-vs2022", "configurePreset": "windows-vs2022", "configuration": "Release", "targets": ["jasperengine-editor"] },
    { "name": "macos-release", "configurePreset": "macos-release", "targets": ["jasperengine-editor"] },
    { "name": "macos-universal-release", "configurePreset": "macos-universal-release", "targets": ["jasperengine-editor"] },
    { "name": "macos-asan", "configurePreset": "macos-asan", "targets": ["jasperengine-editor", "jasperengine-editor-tests"] }
  ],
  "testPresets": [
    {
      "name": "base", "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "linux-ci", "inherits": "base", "configurePreset": "linux-ci", "filter": { "include": { "label": "unit" } } },
    { "name": "linux-asan", "inherits": "base", "configurePreset": "linux-asan", "filter": { "include": { "label": "unit" } } },
    { "name": "linux-tsan", "inherits": "base", "configurePreset": "linux-tsan", "filter": { "include": { "label": "unit" } } },
    { "name": "windows-msvc-asan", "inherits": "base", "configurePreset": "windows-msvc-asan", "filter": { "include": { "label": "unit" } } },
    { "name": "windows-vs2022", "inherits": "base", "configurePreset": "windows-vs2022", "configuration": "Release", "filter": { "include": { "label": "unit" } } },
    { "name": "macos-asan", "inherits": "base", "configurePreset": "macos-asan", "filter": { "include": { "label": "unit" } } }
  ]
}
