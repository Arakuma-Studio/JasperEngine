  "format": "jasperengine.palette",
  "version": 1,
  "name": "Commodore 64 (Pepto)",
  "author": "Philip \"Pepto\" Timmermann",
  "description": "The VIC-II's 16 colours in index order, as Pepto calculated them in 2001 (the gamma-corrected PAL table of his 'Commodore VIC-II Color Analysis'): the 'pepto' palette of emulators such as VICE. His 2017 revision is Lospec's 'colodore'.",
  "source": {"kind": "builtin", "id": "commodore-64", "url": "https://www.pepto.de/projects/colorvic/2001/"},
  "columns": 8,
  "colors": [
    "#000000", "#ffffff", "#68372b", "#70a4b2", "#6f3d86", "#588d43", "#352879", "#b8c76f",
    "#6f4f25", "#433900", "#9a6759", "#444444", "#6c6c6c", "#9ad284", "#6c5eb5", "#959595"
  ],
  "names": {"0": "black", "1": "white", "2": "red", "3": "cyan", "4": "purple", "5": "green", "6": "blue", "7": "yellow", "8": "orange", "9": "brown", "10": "light red", "11": "dark grey", "12": "grey", "13": "light green", "14": "light blue", "15": "light grey"}
}
