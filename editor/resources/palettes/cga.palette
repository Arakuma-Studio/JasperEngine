  "columns": 8,
  "colors": [
    "#000000", "#0000aa", "#00aa00", "#00aaaa", "#aa0000", "#aa00aa", "#aa5500", "#aaaaaa",
    "#555555", "#5555ff", "#55ff55", "#55ffff", "#ff5555", "#ff55ff", "#ffff55", "#ffffff"
  ],
  "names": {"0": "black", "1": "blue", "2": "green", "3": "cyan", "4": "red", "5": "magenta", "6": "brown", "7": "light grey", "8": "dark grey", "9": "light blue", "10": "light green", "11": "light cyan", "12": "light red", "13": "light magenta", "14": "yellow", "15": "white"}
}
