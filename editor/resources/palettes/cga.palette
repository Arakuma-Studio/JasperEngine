{
  "format": "jasperengine.palette",
  "version": 1,
  "name": "CGA",
  "author": "IBM",
  "description": "The IBM Color Graphics Adapter's 16 RGBI colours in hardware index order (colour 6 is the brown the monitor makes of dark yellow); colours from Lospec's 'Color Graphics Adapter'.",
