  ],
  "names": {"0": "black", "1": "blue", "2": "red", "3": "magenta", "4": "green", "5": "cyan", "6": "yellow", "7": "white", "8": "bright blue", "9": "bright red", "10": "bright magenta", "11": "bright green", "12": "bright cyan", "13": "bright yellow", "14": "bright white"}
