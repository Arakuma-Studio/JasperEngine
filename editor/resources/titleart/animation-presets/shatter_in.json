{
  "format": "jasperengine.titleanimpreset",
  "version": 1,
  "id": "shatter_in",
  "name": "Shatter In",
  "group": "in",
  "role": "intro",
  "duration": 0.7,
  "wrap": "once",
  "loop_start": 0,
  "overlay": false,
  "description": "The main text flies together from pieces, with a closing flash.",
  "params": [
    {
      "name": "pieces",
      "label": "Pieces",
      "type": "number",
      "default": 60,
      "min": 10,
      "max": 400
    },
    {
      "name": "pattern",
      "label": "Pattern",
      "type": "enum",
      "default": "glass",
      "options": [
        "glass",
        "voronoi",
        "triangles"
      ]
    },
    {
      "name": "spin",
      "label": "Spin (deg)",
      "type": "number",
      "default": 90,
      "min": 0,
      "max": 720
    }
  ],
  "adds": [
    {
      "id": "shatter",
      "kind": "effect",
      "type": "shatter",
      "params": {
        "pieces": "pieces",
        "pattern": "$pattern"
      }
    }
  ],
  "tracks": [
    {
      "target": "add:shatter",
      "field": "fx:shatter.progress",
      "keys": [
        [
          0,
          1,
          "cubic_out"
        ],
        [
          "D",
          0
        ]
      ]
    },
    {
      "target": "add:shatter",
      "field": "fx:shatter.rotation",
      "keys": [
        [
          0,
          "spin",
          "cubic_out"
        ],
        [
          "D",
          0
        ]
      ]
    },
    {
      "target": "title",
      "field": "opacity",
      "keys": [
        [
          0,
          0
        ],
        [
          "0.2*D",
          1
        ]
      ]
    },
    {
      "target": "title",
      "field": "flash.amount",
      "keys": [
        [
          0,
          0,
          "step"
        ],
        [
          "0.9*D",
          0.8
        ],
        [
          "D",
          0
        ]
      ]
    }
  ],
  "markers": [
    {
      "time": "D",
      "name": "onAssemble"
    }
  ]
}
