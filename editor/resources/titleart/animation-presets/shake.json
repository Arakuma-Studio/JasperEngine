{
  "format": "jasperengine.titleanimpreset",
  "version": 1,
  "id": "shake",
  "name": "Shake",
  "group": "emphasis",
  "role": "emphasis",
  "duration": 0.4,
  "wrap": "once",
  "loop_start": 0,
  "overlay": true,
  "description": "Shakes and settles (an overlay over what plays).",
  "params": [
    {
      "name": "amplitude",
      "label": "Amplitude (px)",
      "type": "number",
      "default": 16,
      "min": 0,
      "max": 200
    },
    {
      "name": "frequency",
      "label": "Frequency (Hz)",
      "type": "number",
      "default": 25,
      "min": 1,
      "max": 60
    },
    {
      "name": "rotation",
      "label": "Rotation (deg)",
      "type": "number",
      "default": 2,
      "min": 0,
      "max": 45
    },
    {
      "name": "decay",
      "label": "Decay",
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 4
    },
    {
      "name": "seed",
      "label": "Seed",
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 999
    }
  ],
  "tracks": [
    {
      "target": "title",
      "field": "transform.position",
      "relative": true,
      "generate": {
        "kind": "shake",
        "length": "D",
        "frequency": "frequency",
        "amplitude": "amplitude",
        "decay": "decay",
        "seed": "seed"
      }
    },
    {
      "target": "title",
      "field": "transform.rotation",
      "relative": true,
      "generate": {
        "kind": "shake",
        "length": "D",
        "frequency": "frequency",
        "amplitude": "rotation",
        "decay": "decay",
        "seed": "seed+1"
      }
    }
  ],
  "markers": []
}
