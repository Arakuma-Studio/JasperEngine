{
  "format": "jasperengine.titleanimpreset",
  "version": 1,
  "id": "heartbeat",
  "name": "Heartbeat",
  "group": "emphasis",
  "role": "emphasis",
  "duration": 0.6,
  "wrap": "once",
  "loop_start": 0,
  "overlay": false,
  "description": "Beats twice: a strong pulse and a weaker one.",
  "params": [
    {
      "name": "scale",
      "label": "Scale",
      "type": "number",
      "default": 1.12,
      "min": 1,
      "max": 2
    }
  ],
  "tracks": [
    {
      "target": "title",
      "field": "transform.scale",
      "relative": true,
      "keys": [
        [
          0,
          1,
          "sine_out"
        ],
        [
          "0.15*D",
          "scale",
          "sine_in_out"
        ],
        [
          "0.35*D",
          1,
          "sine_out"
        ],
        [
          "0.5*D",
          "1+(scale-1)/2",
          "sine_in_out"
        ],
        [
          "0.7*D",
          1
        ]
      ]
    }
  ],
  "markers": []
}
