{
  "format": "jasperengine.titleanimpreset",
  "version": 1,
  "id": "stamp_in",
  "name": "Stamp In",
  "group": "in",
  "role": "intro",
  "duration": 0.5,
  "wrap": "once",
  "loop_start": 0,
  "overlay": false,
  "description": "Drops in large, overshoots and lands with a shake (an optional shockwave ring).",
  "params": [
    {
      "name": "from_scale",
      "label": "From Scale",
      "type": "number",
      "default": 2.6,
      "min": 1,
      "max": 8
    },
    {
      "name": "overshoot",
      "label": "Overshoot",
      "type": "number",
      "default": 0.94,
      "min": 0.5,
      "max": 1.2
    },
    {
      "name": "shake_px",
      "label": "Shake (px)",
      "type": "number",
      "default": 12,
      "min": 0,
      "max": 100
    },
    {
      "name": "shockwave",
      "label": "Shockwave",
      "type": "bool",
      "default": false
    },
    {
      "name": "sound",
      "label": "Sound",
      "type": "sound",
      "default": null
    }
  ],
  "adds": [
    {
      "id": "shockwave",
      "when": "shockwave",
      "kind": "generator",
      "type": "shockwave",
      "name": "Shockwave",
      "place": "below"
    }
  ],
  "tracks": [
    {
      "target": "title",
      "field": "transform.scale",
      "relative": true,
      "keys": [
        [
          0,
          "from_scale",
          "quad_in"
        ],
        [
          "0.6*D",
          "overshoot",
          "sine_out"
        ],
        [
          "D",
          1
        ]
      ]
    },
    {
      "target": "title",
      "field": "opacity",
      "keys": [
        [
          0,
          0
        ],
        [
          "0.25*D",
          1
        ]
      ]
    },
    {
      "target": "title",
      "field": "transform.position",
      "relative": true,
      "generate": {
        "kind": "shake",
        "start": "0.6*D",
        "length": 0.25,
        "frequency": 30,
        "amplitude": "shake_px",
        "decay": 1,
        "seed": 1
      }
    },
    {
      "target": "add:shockwave",
      "field": "gen.radius",
      "when": "shockwave",
      "keys": [
        [
          "0.6*D",
          10,
          "cubic_out"
        ],
        [
          "D",
          600
        ]
      ]
    },
    {
      "target": "add:shockwave",
      "field": "opacity",
      "when": "shockwave",
      "keys": [
        [
          0,
          0,
          "step"
        ],
        [
          "0.6*D",
          1
        ],
        [
          "D",
          0
        ]
      ]
    }
  ],
  "markers": [
    {
      "time": "0.6*D",
      "name": "onImpact",
      "sound": "$sound"
    }
  ]
}
