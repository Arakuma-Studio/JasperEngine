{
  "format": "jasperengine.titleanimpreset",
  "version": 1,
  "id": "neon_flicker",
  "name": "Neon Flicker",
  "group": "in",
  "role": "intro",
  "duration": 0.9,
  "wrap": "once",
  "loop_start": 0,
  "overlay": false,
  "description": "Stutters on like a neon tube and settles lit.",
  "params": [
    {
      "name": "seed",
      "label": "Seed",
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 999
    },
    {
      "name": "flickers",
      "label": "Flickers",
      "type": "number",
      "default": 5,
      "min": 0,
      "max": 20
    }
  ],
  "tracks": [
    {
      "target": "title",
      "field": "opacity",
      "generate": {
        "kind": "flicker",
        "count": "flickers",
        "length": "D",
        "seed": "seed",
        "low": 0.15,
        "high": 1
      }
    },
    {
      "target": "title",
      "field": "live.glow_pulse",
      "generate": {
        "kind": "flicker",
        "count": "flickers",
        "length": "D",
        "seed": "seed",
        "low": 0,
        "high": 1
      }
    }
  ],
  "markers": []
}
