{
  "format": "jasperengine.titleanimpreset",
  "version": 1,
  "id": "color_cycle",
  "name": "Color Cycle",
  "group": "loop",
  "role": "idle",
  "duration": 4,
  "wrap": "loop",
  "loop_start": 0,
  "overlay": false,
  "description": "Scrolls the main text's gradient overlay through its colours.",
  "params": [],
  "adds": [
    {
      "id": "gradient",
      "kind": "effect",
      "type": "gradient_overlay"
    }
  ],
  "tracks": [
    {
      "target": "add:gradient",
      "field": "fx:gradient_overlay.offset",
      "drive": {
        "from": -1,
        "to": 1,
        "cycles": 1,
        "wrap": true
      }
    }
  ],
  "markers": []
}
