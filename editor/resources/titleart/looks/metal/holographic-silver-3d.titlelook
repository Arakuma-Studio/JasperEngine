  "check_allow": [
    {
      "check": "3d_tier_budget.low",
      "reason": "5 stacked solids (letter and bands) over the low tier's 3 on the 'digits' sample; fit_to_tier reduces it"
    },
    {
      "check": "counter_survival",
      "reason": "survival 0.00 of 2 counters on the 'kanji' sample at the look's own rim and band widths (a heavy stack closes small counters)"
