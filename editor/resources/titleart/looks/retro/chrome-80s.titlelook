{
  "format": "jasperengine.titlelook",
  "version": 1,
  "id": "retro/chrome-80s",
  "revision": 1,
  "name": {
    "en": "80s Chrome",
    "ja": "80年代クローム"
  },
  "description": {
    "en": "Horizon chrome face (white to sky blue over a hard horizon into gold, orange and brown) with a button bevel, a white line and a dark violet frame, with star glints and cyan light streaks.",
    "ja": "白から空色、くっきりした地平線から金、オレンジ、茶へ続く地平線クロームの面とボタンベベル、白い線、暗い紫の枠、星のキラキラ、シアンの光条。"
  },
  "family": "retro",
  "tags": [
    "chrome",
    "80s",
    "retro",
    "sunset",
    "glints",
    "streaks"
  ],
