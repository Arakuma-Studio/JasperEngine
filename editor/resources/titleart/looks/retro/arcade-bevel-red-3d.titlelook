{
  "format": "jasperengine.titlelook",
  "version": 1,
  "id": "retro/arcade-bevel-red-3d",
  "revision": 1,
  "name": {
    "en": "Arcade Red 3D",
    "ja": "アーケードレッド 3D"
  },
  "description": {
    "en": "Extruded red candy metal with dark red sides, ringed by a chrome band, in a softbox studio.",
    "ja": "暗い赤の側面を持つ赤いキャンディメタルの押し出し、クロームの帯で囲み、ソフトボックスのスタジオ光。"
  },
  "family": "retro",
  "tags": [
    "red",
    "candy",
    "chrome",
    "arcade",
    "retro",
    "3d"
  ],
  "synonyms": {
    "en": [
      "arcade cabinet",
      "game logo",
      "candy apple",
      "cherry red"
    ],
    "ja": [
      "アーケード",
      "赤",
      "クローム",
      "ゲームロゴ",
      "ākēdo",
      "aka"
    ]
  },
  "dimension": "3d",
  "applies": "style",
  "ref_size": 200,
  "font": {
    "latin": "bungee",
    "ja": "dela-gothic-one"
  },
  "style_3d": {
    "face": {
      "preset": "candy",
      "color": "#e0102a",
      "metallic": 0.85,
      "roughness": 0.35,
      "env_multiplier": 1.4,
      "specular_multiplier": 1.5,
      "clearcoat": 1,
