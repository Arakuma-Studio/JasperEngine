                "color": "#8a94a3"
              },
              {
                "pos": 0.52,
                "color": "#2e343d"
              },
              {
                "pos": 0.6,
                "color": "#7d8794"
              },
              {
                "pos": 0.8,
                "color": "#dde4ee"
              },
              {
                "pos": 1,
                "color": "#ffffff"
              }
            ]
          },
          "metallic": 1,
          "roughness": 0.04
        }
      }
    ]
  },
  "effects": [],
  "part_effects": {},
  "generators": [],
  "group_effects": [],
