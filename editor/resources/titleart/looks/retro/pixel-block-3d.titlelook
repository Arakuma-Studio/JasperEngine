  "dimension": "3d",
  "applies": "style",
  "ref_size": 200,
  "font": {
    "latin": "press-start-2p",
    "ja": "dela-gothic-one"
  },
  "style_3d": {
    "depth": 25,
    "face": {
      "preset": "plastic",
      "color": "#ffd000",
      "roughness": 0.35,
      "env_multiplier": 1,
      "clearcoat": 0.8
    },
    "side": {
      "preset": "plastic",
      "color": "#ff6a00",
      "roughness": 0.35,
      "clearcoat": 0.8
    }
  },
  "effects": [],
  "part_effects": {},
  "generators": [],
  "group_effects": [],
