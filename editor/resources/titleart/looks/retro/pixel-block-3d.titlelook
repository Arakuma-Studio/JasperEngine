  "name": {
    "en": "Pixel Block 3D",
    "ja": "ピクセルブロック 3D"
  },
  "description": {
    "en": "Deep extrusion without a bevel, yellow plastic faces on orange plastic sides, in a softbox studio.",
    "ja": "ベベルなしの深い押し出し、黄色いプラスチックの前面とオレンジのプラスチックの側面、ソフトボックスのスタジオ光。"
  },
  "family": "retro",
  "tags": [
    "pixel",
    "block",
    "yellow",
    "plastic",
    "retro",
    "3d"
  ],
  "synonyms": {
    "en": [
      "voxel",
      "block letters",
      "toy bricks",
      "8 bit 3d"
    ],
