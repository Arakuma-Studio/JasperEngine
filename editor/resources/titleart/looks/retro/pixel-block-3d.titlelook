    "environment": {
      "preset": "softbox",
      "intensity": 1,
      "rotation": 25
    },
    "tone_mapping": "punch",
    "exposure": 1,
    "lights": [
      {
        "id": "",
        "type": "directional",
        "color": "#ffffff",
        "intensity": 2,
        "position": [-600, 800, 1000]
      },
      {
        "id": "",
        "type": "ambient",
        "color": "#ffffff",
        "intensity": 0.3,
