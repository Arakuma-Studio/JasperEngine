            "color": "#3a0830"
          },
          {
            "pos": 0.16,
            "color": "#0a0610"
          },
          {
            "pos": 1,
            "color": "#04030a"
          }
        ]
      },
      "gradient_axis": "depth",
      "roughness": 0.04,
      "env_multiplier": 1.2,
      "specular_multiplier": 1.5,
      "clearcoat": 1,
      "emission": "#ffffff",
      "emission_intensity": 2.5
    },
    "bands": [
      {
        "grow": 0.3,
        "depth": 8,
        "offset": -8.5,
        "bevel": {
          "width": 0.3,
          "depth": 0.5,
          "profile": "step"
        },
        "material": {
          "color": "#06040c",
          "metallic": 1,
          "env_multiplier": 0.7
        },
        "side": {
          "color": "#08060e",
          "metallic": 1,
          "env_multiplier": 0.7
        }
      },
      {
        "grow": 1.1,
        "join": "round",
        "depth": 1,
        "bevel": {
          "width": 1.1,
          "depth": 0.55,
          "profile": "tube",
          "segments": 12
        },
        "material": {
          "color": "#20e0ff",
          "roughness": 0.2,
          "clearcoat": 1,
          "emission": "#20e0ff",
          "emission_intensity": 3.5
        }
      },
      {
        "grow": 2.2,
        "bevel": {
          "width": 0.6,
          "depth": 0.6
        },
        "material": {
          "preset": "black_gloss",
          "color": "#04030a",
          "metallic": 0.2,
          "roughness": 0.08,
          "env_multiplier": 0.35,
          "clearcoat": 1
        }
      },
      {
        "grow": 0.8,
        "depth": 4,
        "bevel": {
          "width": 0.5,
          "depth": 0.5
        },
        "material": {
          "preset": "chrome",
          "color": "#606878",
          "gradient": {
            "stops": [
