  "name": {
    "en": "Reactor Core 3D",
    "ja": "リアクターコア 3D"
  },
  "description": {
    "en": "Inflated letters glowing orange from within, ringed by a chrome band and a black gloss band, a rising orange aura behind, in the dark.",
    "ja": "内側からオレンジに光る膨らんだ文字、クロームの帯と黒い光沢の帯で囲み、背後に立ちのぼるオレンジのオーラ、暗闇の光。"
  },
  "family": "scifi",
  "tags": [
    "reactor",
    "orange",
    "glow",
    "chrome",
    "energy",
    "3d"
  ],
