{
  "format": "jasperengine.titlelook",
  "version": 1,
  "id": "elements/cracked-earth",
  "revision": 1,
  "name": {
    "en": "Cracked Earth",
    "ja": "ひび割れた大地"
  },
  "description": {
    "en": "Clay gradient face with a crumpled surface worn by grunge and a chamfer bevel, a dark brown keyline and a dark base below, an inner shadow and a long perspective shadow.",
    "ja": "しわ加工の表面をグランジで摩耗させ面取りした粘土色グラデーションの面、焦げ茶の縁、下にずらした暗い台、内側の影、遠近の長い影。"
  },
  "family": "elements",
  "tags": [
    "earth",
    "cracked",
    "clay",
    "rock",
    "grunge",
    "desert"
  ],
  "synonyms": {
    "en": [
      "dry ground",
      "drought",
      "stone",
      "mud crack"
    ],
    "ja": [
      "大地",
      "ひび割れ",
      "土",
      "岩",
      "daichi",
      "hibiware"
    ]
  },
  "dimension": "2d",
  "applies": "style",
  "ref_size": 200,
  "font": {
    "latin": "dela-gothic-one",
    "ja": "dela-gothic-one"
  },
  "style": {
