      "type": "glints",
      "preset": "highlights",
      "place": "above",
      "scope": "layer",
      "blend": "add",
      "opacity": 1,
      "params": {},
      "effects": []
    },
    {
      "type": "lens_flare",
      "preset": "streak",
      "place": "above",
      "scope": "layer",
      "blend": "add",
      "opacity": 1,
      "params": {
        "position": [-260, 100]
      },
      "effects": []
    },
    {
