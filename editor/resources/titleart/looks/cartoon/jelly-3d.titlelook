    "ja": "potta-one"
  },
  "style_3d": {
    "mode": "inflate",
    "depth": 4,
    "inflate": {
      "height": 22
    },
    "face": {
      "preset": "candy",
      "color": "#ff4aa0",
      "metallic": 0.85,
      "roughness": 0.35,
      "env_multiplier": 1.4,
      "specular_multiplier": 1.5,
      "clearcoat": 1,
      "transmission": 0.6,
      "flakes": 0.8,
      "flake_scale": 0.8
    },
    "glint": {
      "enabled": true
    }
  },
  "effects": [],
