      "gummy",
      "jelly bean",
      "gelatin",
      "sweet"
    ],
    "ja": [
      "ゼリー",
      "グミ",
      "ピンク",
      "ぷるぷる",
      "zerī",
      "gumi"
    ]
  },
  "dimension": "3d",
  "applies": "style",
  "ref_size": 200,
  "font": {
