  "name": {
    "en": "Jelly 3D",
    "ja": "ゼリー 3D"
  },
  "description": {
    "en": "Inflated pink candy jelly, half clear with metal flakes, in a softbox studio, with glints.",
    "ja": "半ば透けてメタルフレークを含む膨らんだピンクのキャンディゼリー、ソフトボックスのスタジオ光、グリント付き。"
  },
  "family": "cartoon",
  "tags": [
    "jelly",
    "pink",
    "candy",
    "inflate",
    "glossy",
    "3d"
  ],
  "synonyms": {
