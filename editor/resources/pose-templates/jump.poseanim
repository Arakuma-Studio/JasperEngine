{
  "format": "jasperengine.poseanim",
  "version": 1,
  "template": {"name": "Jump", "description": "A jump on the spot: crouch, launch, apex, land, recover; 6 poses, once. Rubbery on the way up; the moves into floor contacts (crouch, launch, landing, recovery) have their own low-overshoot transitions.", "category": "Actions"},
  "preview_model": "",
