                "left_upper_arm.raise": 18, "left_upper_arm.forward": 125,
                "left_lower_arm.bend": 10, "right_shoulder.raise": 18, "right_upper_arm.raise": 18,
                "right_upper_arm.forward": 125, "right_lower_arm.bend": 10,
                "left_lower_leg.bend": 2, "left_foot.point": 36, "left_toes.bend": -30,
