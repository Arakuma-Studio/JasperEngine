    "step_rate": 0, "overlap": 0.1, "looseness": 0.5,
    "weights": {"spine": 1, "head": 1, "arms": 1, "legs": 0}
  },
  "humanize": {"enabled": false, "joint_limits": true, "moving_holds": 0.08, "inbetweens": 0.4,
