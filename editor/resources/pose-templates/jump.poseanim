                "left_lower_arm.bend": 18, "left_hand.bend": -20, "right_upper_arm.raise": 12,
                "right_upper_arm.forward": -55, "right_lower_arm.bend": 18, "right_hand.bend": -20,
                "left_upper_leg.forward": 95, "left_upper_leg.out": 8, "left_lower_leg.bend": 105,
                "left_foot.point": -35, "left_foot.side": 6, "right_upper_leg.forward": 95,
                "right_upper_leg.out": 8, "right_lower_leg.bend": 105, "right_foot.point": -35,
