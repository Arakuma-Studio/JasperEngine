  },
  {
   "id": "6520",
   "parameters": {
    "distance": 0.0,
    "tiled": true
   },
   "seed": -16657.0,
   "shader": {
    "code": [],
    "functions": [],
    "inputs": [
     {
      "default": "vec3(0.0)",
      "function": true,
      "label": "",
      "name": "in",
      "type": "rgb"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "",
      "name": "mask",
      "type": "f"
     }
    ],
    "instance": [
     "float $(name)_distance(vec2 uv, bool tiled, float _seed_variation_, vec4 _controlled_variation_) {",
     "\tif (tiled) {",
     "\t\tuv = fract(uv);",
     "\t}",
     "\tvec2 custom_uv = $in(uv).xy;",
     "\tvec2 diff = custom_uv != vec2(0.0) ? custom_uv - uv : vec2(1.0);",
     "\t$distance",
     "\tif (!tiled) {",
     "\t\tuv = clamp(uv, 0.0, 1.0);",
     "\t}",
     "\treturn $mask(uv) < 0.5 ? distance : -distance;",
     "}"
    ],
    "outputs": [
     {
      "expr": "$(name)_distance($uv, $tiled, _seed_variation_, _controlled_variation_)",
      "type": "sdf2d"
     }
    ],
    "parameters": [
     {
      "default": false,
      "label": "Tiled",
      "name": "tiled",
      "type": "boolean"
     },
     {
      "default": 0.0,
      "label": "",
      "name": "distance",
      "type": "enum",
      "values": [
       {
        "name": "Euclidean",
        "value": "float distance = length(diff);"
       },
       {
        "name": "Manhattan",
        "value": "float distance = abs(diff.x) + abs(diff.y);"
       },
       {
        "name": "Chebyshev",
        "value": "float distance = abs(diff.x) > abs(diff.y) ? abs(diff.x) : abs(diff.y);"
       }
      ]
     }
    ]
   }
  },
