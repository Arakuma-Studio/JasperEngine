   "shader": {
    "code": [],
    "functions": [
     "process_normal_default",
     "process_normal_directx",
     "process_normal_opengl"
    ],
    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "",
      "name": "in",
      "type": "f"
     }
    ],
    "instance": [
     "vec3 $(name)_fct(vec2 uv, float _seed_variation_, vec4 _controlled_variation_) {",
     "\tvec3 e = vec3(1.0/$size, -1.0/$size, 0);",
     "\tvec2 rv = vec2(1.0, -1.0)*$in(uv+e.xy);",
     "\trv += vec2(-1.0, 1.0)*$in(uv-e.xy);",
     "\trv += vec2(1.0, 1.0)*$in(uv+e.xx);",
     "\trv += vec2(-1.0, -1.0)*$in(uv-e.xx);",
     "\trv += vec2(2.0, 0.0)*$in(uv+e.xz);",
     "\trv += vec2(-2.0, 0.0)*$in(uv-e.xz);",
     "\trv += vec2(0.0, 2.0)*$in(uv+e.zx);",
     "\trv += vec2(0.0, -2.0)*$in(uv-e.zx);",
     "\treturn vec3(rv, 0.0);",
     "}"
    ],
    "outputs": [
     {
      "expr": "process_normal_$format($(name)_fct($uv, _seed_variation_, _controlled_variation_), $amount*$size/128.0)",
      "type": "rgb"
     }
    ],
