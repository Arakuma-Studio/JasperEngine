    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "",
      "name": "in",
      "type": "f"
     }
    ],
    "instance": [
     "float $(name)_fct(vec2 uv, float _seed_variation_, vec4 _controlled_variation_) {",
     "\tfloat pixels = max(1.0, $width);",
     "\tfloat e = 1.0/$size;",
     "\tfloat rv = 0.0;",
     "\tfor (float dx = -pixels; dx <= pixels; dx += 1.0) {",
     "\t\tfor (float dy = -pixels; dy <= pixels; dy += 1.0) {",
     "\t\t\tif (abs(dx) > 0.5 || abs(dy) > 0.5) {",
     "\t\t\t\trv += $in(uv+e*vec2(dx, dy))*cos(atan(dy, dx)-$angle*3.14159265359/180.0)/length(vec2(dx, dy));",
     "\t\t\t}",
     "\t\t}",
     "\t}",
     "\treturn $amount*rv/pixels+0.5;",
     "}"
    ],
    "outputs": [
     {
      "expr": "$(name)_fct($uv, _seed_variation_, _controlled_variation_)",
      "type": "f"
     }
    ],
    "parameters": [
