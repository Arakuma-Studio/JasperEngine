   "description": "Shows a grayscale image of the generated noise",
   "expr": "$(name)_fbm($(uv), vec2($(scale_x), $(scale_y)), int($(folds)), int($(iterations)), $(persistence), float($(seed)), _seed_variation_, _controlled_variation_)",
