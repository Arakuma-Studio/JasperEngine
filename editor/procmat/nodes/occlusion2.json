      "shader": {
       "code": [],
       "functions": [],
       "inputs": [
        {
         "default": "vec4(1.0)",
         "function": true,
         "label": "",
         "name": "in",
         "type": "rgba"
        }
       ],
       "instance": [
        "vec4 $(name)_blur(vec2 uv, vec2 scale, float sigma, int quality, float _seed_variation_, vec4 _controlled_variation_) {",
        "\tvec4 O = vec4(0.0);",
        "\tfloat samples = sigma * 4.0; ",
        "\tint LOD = max(0, int(log2(float(samples)))-quality-2);",
        "\tint sLOD = 1 << LOD;",
        "\tint s = max(1, int(samples/float(sLOD)));",
        "\tfloat sum = 0.0;",
        "\tfor (int i = 0; i < s*s; i++) {",
        "\t\tvec2 d = vec2(float(i%s), float(i/s))*float(sLOD) - 0.5*float(samples);",
        "\t\tvec2 dd = d / sigma;",
        "\t\tfloat g = exp(-.5*dot(dd,dd))/(6.28*sigma*sigma);",
        "\t\tO += g * textureLod($in.texture, uv + scale * d, float(LOD));",
        "\t\tsum += g;",
        "\t}",
        "\t",
        "\treturn O / sum;",
        "}",
        ""
       ],
       "outputs": [
        {
         "expr": "$(name)_blur($uv, vec2(1.0)/$in.size, max(1.0, floor($sigma*$in.size/2048.0)), int($quality), _seed_variation_, _controlled_variation_)",
         "type": "rgba"
        }
       ],
       "parameters": [
