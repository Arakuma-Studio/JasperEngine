 "kind": "graph",
 "name": "Fill from Colors",
 "nodes": [
  {
   "id": "iterate_buffer",
   "parameters": {
    "autostop": true,
    "filter": false,
    "iterations": 50,
    "mipmap": false,
    "shrink": false,
    "size": 8
   },
   "seed": 29168,
