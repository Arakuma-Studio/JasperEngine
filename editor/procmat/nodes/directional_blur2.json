      "name": "amount",
      "type": "f"
     }
    ],
    "instance": [
     "vec4 $(name)_fct(vec2 uv, float _seed_variation_, vec4 _controlled_variation_) {",
     "\tvec2 e = vec2(cos($angle*0.01745329251), -sin($angle*0.01745329251))/$size;",
     "\tvec4 rv = vec4(0.0);",
     "\tfloat sum = 0.0;",
     "\tfloat sigma = max($sigma*$amount(uv), 1e-5);",
     "\tfor (float i = $mode; i <= 50.0; i += 1.0) {",
     "\t\tfloat coef = exp(-0.5*(pow(i/sigma, 2.0)))/(6.28318530718*sigma*sigma);",
     "\t\trv += $in(uv+i*e)*coef;",
     "\t\tsum += coef;",
     "\t}",
     "\treturn rv/sum;",
     "}"
    ],
    "outputs": [
     {
      "expr": "$(name)_fct($uv, _seed_variation_, _controlled_variation_)",
      "type": "rgba"
     }
    ],
