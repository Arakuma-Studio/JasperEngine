{
 "code": [
  "vec2 $(name_uv)_scale = vec2($sx, $sy*1.73205080757);",
  "vec2 $(name_uv)_uv = $uv*$(name_uv)_scale;",
  "vec4 $(name_uv)_center = beehive_center($(name_uv)_uv);",
  "vec4 $(name_uv)_fill = fract(vec4($(name_uv)_uv-$(name_uv)_center.xy-vec2(0.5, 0.57735026919), vec2(1.0, 1.15470053838))/$(name_uv)_scale.xyxy);",
  "$(name_uv)_fill = floor($(name_uv)_fill*16384.0)/16384.0;"
 ],
 "description": "Draws a grayscale hexagonal tiles pattern",
 "format": 1,
 "functions": [
  "beehive_center",
  "beehive_dist"
 ],
 "id": "beehive2",
 "inputs": [],
 "instance": [],
 "kind": "shader",
 "name": "Beehive",
 "notices": [],
 "outputs": [
  {
   "description": "Shows the grayscale pattern",
   "expr": "1.0-2.0*beehive_dist($(name_uv)_center.xy)",
   "label": "Output",
   "type": "f"
  },
  {
   "description": "An output that should be plugged into a Fill companion node",
   "expr": "$(name_uv)_fill",
   "label": "Fill",
   "type": "fill"
  }
 ],
 "parameters": [
  {
   "default": 2,
   "description": "The number of columns of the pattern",
   "label": "Size X",
   "max": 64,
   "min": 1,
   "name": "sx",
   "short_description": "Size.x",
   "step": 1,
   "type": "float"
  },
  {
