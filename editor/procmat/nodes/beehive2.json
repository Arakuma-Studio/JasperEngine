   "description": "The number of rows of the pattern",
   "label": "Size Y",
   "max": 64,
   "min": 1,
   "name": "sy",
   "short_description": "Size.y",
   "step": 1,
   "type": "float"
  }
 ],
 "short_description": "Hexagonal tiles pattern",
