     }
    ],
    "instance": [
     "float $(name)_curve( vec2 p, vec2 o , float _seed_variation_, vec4 _controlled_variation_) {",
     "\tfloat a = $in(p+o);",
     "\tfloat b = $in(p-o);",
     "\tfloat c = $in(p+o*vec2(1.0,-1.0));",
     "\tfloat d = $in(p-o*vec2(1.0,-1.0));",
     "\treturn -a - b - c - d;",
     "}",
     "",
     "float $(name)_curvature_map(vec2 p, float r, float q, float _seed_variation_, vec4 _controlled_variation_) {",
     "\tfloat s = r/q;",
     "\tfloat H = $in(p)*4.0;",
     "\tfloat v = 0.0;",
     "\tfor(float ox = 0.0; ox < q; ox++ ){",
     "\t\tfor(float oy = 0.0; oy < q; oy++ ){",
     "\t\t\tvec2 o = vec2(ox, oy);",
     "\t\t\tfloat c = $(name)_curve(p, o*s, _seed_variation_, _controlled_variation_);",
     "\t\t\tv += (H + c) * ((r-length(o*s)) / r);",
     "\t\t}",
     "\t}",
     "\treturn v/(q*q);",
     "}",
     "",
     "float $(name)_curvature(vec2 uv, float quality, float strength, float radius, float _seed_variation_, vec4 _controlled_variation_) {",
     "\tfloat c = $(name)_curvature_map(uv, 0.050 * radius, quality, _seed_variation_, _controlled_variation_)*strength / radius;",
     "\treturn 0.5 + c;",
     "}"
    ],
    "outputs": [
     {
      "expr": "$(name)_curvature($uv, $quality, $strength, $radius, _seed_variation_, _controlled_variation_)",
      "type": "f"
     }
    ],
