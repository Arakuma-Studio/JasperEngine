{
 "code": [],
 "description": "An edge detect filter that detects edges along all directions and draws them in white on a black background",
 "format": 1,
 "functions": [],
 "id": "edge_detect",
 "inputs": [
  {
   "default": "vec3(0.0)",
   "description": "The input image",
   "function": true,
   "label": "",
   "name": "in",
   "short_description": "Input",
   "type": "rgb"
  }
 ],
 "instance": [
  "float $(name)_fct(vec2 uv, float _seed_variation_, vec4 _controlled_variation_) {",
  "\tvec3 e_base = vec3(1.0/$size, -1.0/$size, 0);",
  "\tvec3 ref = $in(uv);",
  "\tvec3 e = vec3(0);",
  "\tfloat rv = 0.0;",
  "\tfor (int i = 0; i < int($width); ++i) {",
  "\t\te += e_base;",
  "\t\trv += length($in(uv+e.xy)-ref);",
  "\t\trv += length($in(uv-e.xy)-ref);",
  "\t\trv += length($in(uv+e.xx)-ref);",
  "\t\trv += length($in(uv-e.xx)-ref);",
  "\t\trv += length($in(uv+e.xz)-ref);",
  "\t\trv += length($in(uv-e.xz)-ref);",
  "\t\trv += length($in(uv+e.zx)-ref);",
  "\t\trv += length($in(uv-e.zx)-ref);",
  "\t\trv *= 2.0;",
  "\t}",
  "\treturn rv*pow(2.0, -$width);",
  "}"
 ],
 "kind": "shader",
 "name": "Edge Detect",
 "notices": [],
 "outputs": [
  {
   "description": "Shows the generated outlines",
   "expr": "clamp(100.0*($(name)_fct($uv, _seed_variation_, _controlled_variation_)-$threshold), 0.0, 1.0)",
   "label": "Output",
   "type": "f"
  }
 ],
 "parameters": [
  {
   "default": 9,
   "description": "The resolution of the input image",
   "first": 4,
   "label": "Size",
   "last": 12,
   "name": "size",
   "short_description": "Size",
   "type": "size"
  },
  {
   "default": 1,
   "label": "Width",
   "max": 5,
   "min": 1,
   "name": "width",
   "step": 1,
   "type": "float"
  },
  {
   "default": 0.5,
   "label": "Threshold",
   "max": 1,
   "min": 0,
   "name": "threshold",
   "step": 0.01,
   "type": "float"
  }
 ],
 "short_description": "Edge Detect",
 "source": {
