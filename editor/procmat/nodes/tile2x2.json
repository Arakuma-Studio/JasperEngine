{
 "code": [],
 "description": "Places 4 input images into a single output to create an atlas of 4 images. Chaining Tile 2x2 nodes can be useful to create 16 images atlases.\nAtlases are used by remapping nodes such as CustomUV, Tiler and Splatter.",
 "format": 1,
 "functions": [],
 "id": "tile2x2",
 "inputs": [
  {
   "default": "vec4(0.0)",
   "description": "The first input",
   "label": "",
   "name": "in1",
   "short_description": "Input1",
   "type": "rgba"
  },
  {
   "default": "vec4(0.0)",
   "description": "The second input",
   "label": "",
   "name": "in2",
   "short_description": "Input2",
   "type": "rgba"
  },
  {
   "default": "vec4(0.0)",
   "description": "The third input",
   "label": "",
   "name": "in3",
   "short_description": "Input3",
   "type": "rgba"
  },
  {
   "default": "vec4(0.0)",
   "description": "The fourth input",
   "label": "",
   "name": "in4",
   "short_description": "Input4",
   "type": "rgba"
  }
 ],
 "instance": [],
 "kind": "shader",
 "name": "Tile 2x2",
 "notices": [],
 "outputs": [
  {
   "description": "Shows the generated atlas",
   "expr": "($uv.y < 0.5) ? (($uv.x < 0.5) ? ($in1(2.0*$uv)) : ($in2(2.0*$uv-vec2(1.0, 0.0)))) : (($uv.x < 0.5) ? ($in3(2.0*$uv-vec2(0.0, 1.0))) : ($in4(2.0*$uv-vec2(1.0, 1.0))))",
   "label": "Output",
   "type": "rgba"
  }
 ],
 "parameters": [],
