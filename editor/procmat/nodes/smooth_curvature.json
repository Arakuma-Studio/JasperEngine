  {
   "id": "598_3",
   "parameters": {
    "amount": 1.0,
    "size": 12,
    "width": 1.0
   },
   "seed": -27808.0,
   "shader": {
    "code": [
     "vec2 $(name_uv)_emboss = $(name)_fct($uv, _seed_variation_, _controlled_variation_);"
    ],
    "functions": [],
    "inputs": [
     {
      "default": "vec3(0.0)",
      "function": true,
      "label": "",
      "name": "in",
      "type": "rgb"
     }
    ],
    "instance": [
     "vec2 $(name)_fct(vec2 uv, float _seed_variation_, vec4 _controlled_variation_) {",
     "\tfloat pixels = max(1.0, $width);",
     "\tfloat e = 1.0/$size;",
     "\tvec2 rv = vec2(0.0);",
     "\tfor (float dx = -pixels; dx <= pixels; dx += 1.0) {",
     "\t\tfor (float dy = -pixels; dy <= pixels; dy += 1.0) {",
     "\t\t\tif (abs(dx) > 0.5 || abs(dy) > 0.5) {",
     "\t\t\t\trv += $in(uv+e*vec2(dx, dy)).xy*cos(vec2(atan(dy, dx))-vec2(0.0, 0.5)*3.14159265359)/length(vec2(dx, dy));",
     "\t\t\t}",
     "\t\t}",
     "\t}",
     "\treturn $amount*rv/pixels+0.5;",
     "}"
    ],
    "outputs": [
     {
      "expr": "0.5*($(name_uv)_emboss.x+$(name_uv)_emboss.y)",
      "type": "f"
     }
    ],
    "parameters": [
     {
      "default": 9.0,
      "first": 6.0,
      "label": "Size",
      "last": 12.0,
      "name": "size",
      "type": "size"
     },
     {
      "default": 1.0,
      "label": "Amount",
      "max": 10.0,
      "min": 0.0,
      "name": "amount",
      "step": 0.1,
      "type": "float"
     },
