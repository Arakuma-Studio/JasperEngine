      "type": "f"
     }
    ],
    "instance": [
     "vec2 $(name)_dilate(vec2 uv, float _seed_variation_, vec4 _controlled_variation_) {",
     "\tfloat e = 1.0/$s;",
     "\tint n = int(floor($d/e));",
     "\tfloat v = 0.0;",
     "\tfloat bestuv_x = uv.x;",
     "\tfor (int i = 0; i < n; i++) {",
     "\t\tfloat x = float(i)*e;",
     "\t\tfloat c = $in(uv+vec2(x, 0.0));",
     "\t\tif (c > v + 0.0009765625) {",
     "\t\t\tv = c;",
     "\t\t\tbestuv_x = uv.x+x;",
     "\t\t}",
     "\t\tc = $in(uv-vec2(x, 0.0));",
     "\t\tif (c > v + 0.0009765625) {",
     "\t\t\tv = c;",
     "\t\t\tbestuv_x = uv.x-x;",
     "\t\t}",
     "\t}",
     "\treturn vec2(v, bestuv_x);",
     "}"
    ],
    "outputs": [
     {
      "expr": "vec3($(name)_dilate($uv, _seed_variation_, _controlled_variation_), 0.0)",
      "type": "rgb"
     }
    ],
