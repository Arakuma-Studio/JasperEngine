    "instance": [
     "vec3 $(name)_dilate(vec2 uv, float _seed_variation_, vec4 _controlled_variation_) {",
     "\tfloat e = 1.0/$s;",
     "\tint n = int(floor($d/e));",
     "\tfloat v = 0.0;",
     "\tvec2 bestuv = uv;",
     "\tfor (int i = 0; i < n; i++) {",
     "\t\tfloat x = float(i)*e;",
     "\t\tvec2 input_dist = $inx(uv+vec2(0.0, x)).xy;",
     "\t\tif (v + 0.0009765625 < input_dist.x && $d >= length(vec2(input_dist.y-uv.x, x))) {",
     "\t\t\tv = input_dist.x;",
     "\t\t\tbestuv = vec2(input_dist.y, uv.y+x);",
     "\t\t}",
     "\t\tinput_dist = $inx(uv-vec2(0.0, x)).xy;",
     "\t\tif (v + 0.0009765625 < input_dist.x && $d >= length(vec2(input_dist.y-uv.x, x))) {",
     "\t\t\tv = input_dist.x;",
     "\t\t\tbestuv = vec2(input_dist.y, uv.y-x);",
     "\t\t}",
     "\t\tinput_dist = $iny(uv+vec2(x, 0.0)).xy;",
     "\t\tif (v + 0.0009765625 < input_dist.x && $d >= length(vec2(input_dist.y-uv.y, x))) {",
     "\t\t\tv = input_dist.x;",
     "\t\t\tbestuv = vec2(uv.x+x, input_dist.y);",
     "\t\t}",
     "\t\tinput_dist = $iny(uv-vec2(x, 0.0)).xy;",
     "\t\tif (v + 0.0009765625 < input_dist.x && $d >= length(vec2(input_dist.y-uv.y, x))) {",
     "\t\t\tv = input_dist.x;",
     "\t\t\tbestuv = vec2(uv.x-x, input_dist.y);",
     "\t\t}",
     "\t}",
     "\treturn vec3(v, bestuv);",
     "}"
    ],
    "outputs": [
     {
      "expr": "$in2(fract($(name)_dilate($uv, _seed_variation_, _controlled_variation_).yz))",
