    "code": [
     "vec3 $(name_uv)_instance_uv = vec3(0.0);",
     "vec4 $(name_uv)_rch = tiler_$(name)($uv, vec2($tx, $ty), int($overlap), $(name_uv)_instance_uv, vec2(float($seed)), _seed_variation_, _controlled_variation_);"
    ],
    "functions": [
     "get_from_tileset",
     "rand",
     "rand2",
     "rand3"
    ],
    "inputs": [
     {
