      "description": "The number of neighbour tiles an instance of the input image can overlap. Set this parameter to the lowest value that generates the expected result (where all instances are fully visible) to improve performance.",
      "label": "Overlap",
      "max": 5,
      "min": 0,
      "name": "overlap",
      "short_description": "Overlap",
