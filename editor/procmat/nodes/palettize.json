{
 "code": [],
 "description": "Maps its input image to a palette",
 "format": 1,
 "functions": [],
 "id": "palettize",
 "inputs": [
  {
   "default": "vec3(0.0)",
   "description": "The input image",
   "label": "",
   "name": "in",
   "short_description": "Input",
   "type": "rgb"
  },
  {
   "default": "vec3(0.0)",
   "description": "The palette",
   "function": true,
   "label": "",
   "name": "palette",
   "short_description": "Palette",
   "type": "rgb"
  }
 ],
 "instance": [
  "vec3 find_color_from_palette_$name(vec3 color, int size, float _seed_variation_, vec4 _controlled_variation_) {",
  "\tfloat min_dist = 10.0;",
  "\tvec3 best_color = vec3(0.0);",
  "\tfor (int i = 0; i < size; ++i) {",
  "\t\tfloat x = (float(i)+0.5)/float(size);",
  "\t\tfor (int j = 0; j < size; ++j) {",
  "\t\t\tfloat y = (float(j)+0.5)/float(size);",
  "\t\t\tvec3 c = $palette(vec2(x, y));",
  "\t\t\tfloat l = length(color - c);",
  "\t\t\tif (l < min_dist) {",
  "\t\t\t\tmin_dist = l;",
  "\t\t\t\tbest_color = c;",
  "\t\t\t}",
  "\t\t}",
  "\t}",
  "\treturn best_color;",
  "}"
 ],
 "kind": "shader",
 "name": "Palettize",
 "notices": [],
 "outputs": [
  {
   "description": "The input image mapped to the palette",
   "expr": "find_color_from_palette_$name($in($uv), int(min($size, 32.0)), _seed_variation_, _controlled_variation_)",
   "label": "Output",
   "type": "rgb"
  }
 ],
 "parameters": [
  {
   "default": 16,
   "description": "The width and height in pixels of the palette",
   "label": "Size",
   "max": 32,
   "min": 0,
   "name": "size",
   "short_description": "Size",
   "step": 1,
   "type": "float"
  }
 ],
 "short_description": "Palettize",
