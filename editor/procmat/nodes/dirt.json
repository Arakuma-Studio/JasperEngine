    "code": [
     "vec4 $(name_uv)_rch = tiler_$(name)($uv, vec2($tx, $ty), int($overlap), vec2(float($seed)), _seed_variation_, _controlled_variation_);"
    ],
    "functions": [
     "rand2",
     "rand3"
    ],
    "inputs": [
