      "name": "q",
      "type": "f"
     }
    ],
    "instance": [
     "float height_$name(vec2 uv, float _seed_variation_, vec4 _controlled_variation_) {",
     "\tfloat height = 0.0;",
     "\tfloat sum = 0.0;",
     "\tfor (int dx = -5; dx <= 5; ++dx) {",
     "\t\tfor (int dy = -5; dy <= 5; ++dy) {",
     "\t\t\tvec2 d = vec2(float(dx), float(dy));",
     "\t\t\tvec2 p = uv+d/$size;",
     "\t\t\tfloat h = $h(p);",
     "\t\t\tfloat w = max(1.0-50.0*$q(p), 0.01)/(1.0+dot(d,d));",
     "\t\t\th -= $scale*dot(d/$size, $nm(p).xy-vec2(0.5));",
     "\t\t\theight += w*h;",
     "\t\t\tsum += w;",
     "\t\t}",
     "\t}",
     "\treturn height/sum;",
     "}",
     ""
    ],
    "outputs": [
     {
      "expr": "height_$name($uv, _seed_variation_, _controlled_variation_)",
      "type": "f"
     }
