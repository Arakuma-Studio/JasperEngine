      "name": "n",
      "type": "rgb"
     }
    ],
    "instance": [
     "vec3 nm_compare_$name(vec2 uv, float amount, float size, float _seed_variation_, vec4 _controlled_variation_) {",
     "\tvec3 e = vec3(1.0/size, -1.0/size, 0);",
     "\tvec2 rv;",
     "\trv = vec2(1.0, -1.0)*$in(uv+e.xy);",
     "\trv += vec2(-1.0, 1.0)*$in(uv-e.xy);",
     "\trv += vec2(1.0, 1.0)*$in(uv+e.xx);",
     "\trv += vec2(-1.0, -1.0)*$in(uv-e.xx);",
     "\trv += vec2(2.0, 0.0)*$in(uv+e.xz);",
     "\trv += vec2(-2.0, 0.0)*$in(uv-e.xz);",
     "\trv += vec2(0.0, 2.0)*$in(uv+e.zx);",
     "\trv += vec2(0.0, -2.0)*$in(uv-e.zx);",
     "\trv *= size*40.0/amount/128.0;",
     "\treturn vec3(0.5)+0.5*normalize(vec3(rv, -1.0));",
     "}",
     ""
    ],
    "outputs": [
     {
      "expr": "length(nm_compare_$name($uv, $amount, $size, _seed_variation_, _controlled_variation_)-$n($uv))",
      "type": "f"
     }
    ],
    "parameters": [
     {
      "default": 9,
      "first": 4,
      "label": "",
      "last": 12,
