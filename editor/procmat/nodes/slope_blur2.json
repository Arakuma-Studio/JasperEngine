 "description": "Applies a blur effect on its input, following slopes of an input height map",
 "format": 1,
 "id": "slope_blur2",
 "inputs": [
  {
   "description": "The input image",
   "group_size": 0.0,
   "label": "Input",
   "name": "in",
   "type": "rgba"
  },
  {
   "description": "A height map whose slopes control the strength and direction of the blur filter",
   "group_size": 0.0,
   "label": "Height map",
   "name": "heightmap",
   "type": "f"
  }
 ],
 "kind": "graph",
 "name": "Slope Blur",
 "nodes": [
  {
   "id": "edge_detect_3_3_2",
   "parameters": {
    "sigma": 20.0,
    "size": 9.0
   },
   "seed": -47470.0,
   "seed_locked": true,
   "shader": {
    "code": [],
    "functions": [],
    "inputs": [
     {
      "default": "vec4(1.0)",
      "function": true,
      "label": "",
      "name": "in",
      "type": "rgba"
     },
     {
      "default": "1.0",
      "function": true,
      "label": "",
      "name": "heightmap",
      "type": "f"
     }
    ],
    "instance": [
     "vec4 $(name)_fct(vec2 uv, float _seed_variation_, vec4 _controlled_variation_) {",
     "\tfloat dx = 1.0/$size;",
     "\tfloat v = $heightmap(uv);",
     "\tvec2 slope = vec2($heightmap(uv+vec2(dx, 0.0))-v, $heightmap(uv+vec2(0.0, dx))-v);",
     "\tfloat slope_strength = length(slope)*$size;",
     "\tvec2 norm_slope =  (slope_strength == 0.0) ? vec2(0.0, 1.0) : normalize(slope);",
     "\tvec2 e = dx*norm_slope;",
     "\tvec4 rv = vec4(0.0);",
     "\tfloat sum = 0.0;",
     "\tfloat sigma = max($sigma*slope_strength, 0.0001);",
     "\tfor (float i = 0.0; i <= 50.0; i += 1.0) {",
     "\t\tfloat coef = exp(-0.5*(pow(i/sigma, 2.0)))/(6.28318530718*sigma*sigma);",
     "\t\trv += $in(uv+i*e)*coef;",
     "\t\tsum += coef;",
     "\t}",
     "\treturn rv/sum;",
     "}"
    ],
    "outputs": [
     {
      "expr": "$(name)_fct($uv, _seed_variation_, _controlled_variation_)",
      "type": "rgba"
     }
    ],
    "parameters": [
     {
      "default": 9.0,
      "first": 4.0,
      "label": "Size",
      "last": 12.0,
      "name": "size",
      "type": "size"
     },
     {
      "default": 0.5,
      "label": "Sigma",
      "max": 50.0,
      "min": 0.0,
      "name": "sigma",
      "step": 0.1,
      "type": "float"
     }
    ]
   }
