{
 "code": [],
 "description": "Places 4 input images into a single output to create an atlas of 4 images. Chaining Tile 2x2 nodes can be useful to create 16 images atlases.\nAtlases are used by remapping nodes such as CustomUV, Tiler and Splatter.",
 "format": 1,
 "functions": [],
 "id": "tile2x2_variations",
 "inputs": [
  {
   "default": "vec4(0.0)",
   "description": "The first input",
   "function": true,
   "label": "",
   "name": "in",
   "short_description": "Input1",
   "type": "rgba"
  }
 ],
 "instance": [],
 "kind": "shader",
 "name": "Tile 2x2 Variations",
 "notices": [],
 "outputs": [
  {
   "description": "Shows the generated atlas",
   "expr": "($uv.y < 0.5) ? (($uv.x < 0.5) ? ($in.variation(2.0*$uv, $seed)) : ($in.variation(2.0*$uv-vec2(1.0, 0.0), $seed+0.1))) : (($uv.x < 0.5) ? ($in.variation(2.0*$uv-vec2(0.0, 1.0), $seed+0.2)) : ($in.variation(2.0*$uv-vec2(1.0, 1.0), $seed+0.3)))",
   "label": "Output",
   "type": "rgba"
  }
 ],
 "parameters": [],
 "short_description": "Tile 2x2",
