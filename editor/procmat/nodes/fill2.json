      "label": "",
      "max": 1,
      "min": 0,
      "name": "amount",
      "step": 0.01,
      "type": "float"
     }
    ]
   }
  },
  {
   "id": "dilate_pass_4",
   "parameters": {
    "d": 1,
    "distance": 0,
    "s": 8
   },
   "seed": 50297,
   "shader": {
    "code": [],
    "functions": [
     "dilate_distance_chebyshev",
     "dilate_distance_euclidian",
     "dilate_distance_manhattan",
     "pack_4x16_to_2x32"
    ],
    "inputs": [
     {
      "default": "vec3(0.0)",
      "function": true,
      "label": "",
      "name": "in",
      "type": "rgba"
     }
    ],
    "instance": [
     "vec3 $(name)_distance_v(vec2 uv, float _seed_variation_, vec4 _controlled_variation_) {",
     "\tvec2 e = vec2(0.0, 1.0/$s);",
     "\tint steps = int($s*$d);",
     "\tvec3 p = vec3(pack_4x16_to_2x32($in(uv)), uv.y);",
     "\tfor (int i = 0; i < steps; ++i) {",
     "\t\tvec2 dx = float(i)*e;",
     "\t\tvec2 uv2 = fract(uv+dx);",
     "\t\tvec3 p2 = vec3(pack_4x16_to_2x32($in(uv2)), uv2.y);",
     "\t\tif (p2.x > p.x) {",
     "\t\t\tp2.x = dilate_distance_$distance(p2.x, dx.y, $d);",
     "\t\t\tp = mix(p, p2, step(p.x, p2.x));",
     "\t\t}",
     "\t\tuv2 = fract(uv-dx);",
     "\t\tp2 = vec3(pack_4x16_to_2x32($in(uv2)), uv2.y);",
     "\t\tif (p2.x > p.x) {",
     "\t\t\tp2.x = dilate_distance_$distance(p2.x, dx.y, $d);",
     "\t\t\tp = mix(p, p2, step(p.x, p2.x));",
     "\t\t}",
     "\t}",
     "\treturn p;",
     "}",
     ""
    ],
    "outputs": [
     {
      "expr": "$(name)_distance_v($uv, _seed_variation_, _controlled_variation_)",
      "type": "rgb"
     }
    ],
    "parameters": [
     {
      "default": 9,
      "first": 6,
      "label": "",
      "last": 12,
      "name": "s",
      "type": "size"
     },
     {
      "default": 0.5,
      "label": "",
      "max": 1,
      "min": 0,
      "name": "d",
      "step": 0.01,
      "type": "float"
     },
     {
      "default": 2,
      "label": "",
      "name": "distance",
      "type": "enum",
      "values": [
       {
        "name": "Euclidian",
        "value": "euclidian"
       },
       {
        "name": "Manhattan",
        "value": "manhattan"
       },
       {
        "name": "Chebyshev",
        "value": "chebyshev"
       }
      ]
     }
    ]
   }
  },
  {
   "id": "dilate_pass_1",
   "parameters": {
    "d": 1,
    "s": 8
   },
   "seed": 71939,
   "seed_locked": true,
   "shader": {
    "code": [],
    "functions": [
