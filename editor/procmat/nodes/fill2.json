      "first": 6,
      "label": "",
      "last": 12,
      "name": "s",
      "type": "size"
     },
     {
      "default": 0.5,
      "label": "",
      "max": 1,
      "min": 0,
      "name": "d",
      "step": 0.01,
      "type": "float"
