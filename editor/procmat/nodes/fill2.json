    ],
    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "",
      "name": "in",
      "type": "f"
     }
    ],
    "instance": [
     "vec3 $(name)_distance_h(vec2 uv, float _seed_variation_, vec4 _controlled_variation_) {",
     "\tvec2 e = vec2(1.0/$s, 0.0);",
     "\tint steps = int($s*$d);",
     "\tfloat rv = 0.0;",
     "\tvec2 source_uv;",
     "\tfor (int i = 0; i < steps; ++i) {",
     "\t\tsource_uv = uv+float(i)*e;",
     "\t\tif ($in(source_uv) > 0.5) {",
     "\t\t\trv = 1.0-float(i)*e.x/$d;",
     "\t\t\tbreak;",
     "\t\t}",
     "\t\tsource_uv = uv-float(i)*e;",
     "\t\tif ($in(source_uv) > 0.5) {",
     "\t\t\trv = 1.0-float(i)*e.x/$d;",
     "\t\t\tbreak;",
     "\t\t}",
     "\t}",
     "\treturn vec3(rv, source_uv);",
     "}",
     ""
    ],
    "outputs": [
     {
      "expr": "pack_2x32_to_4x16($(name)_distance_h($uv, _seed_variation_, _controlled_variation_).xy)",
      "type": "rgba"
     }
    ],
    "parameters": [
