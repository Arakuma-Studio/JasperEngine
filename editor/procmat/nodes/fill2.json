   },
   "seed": 0.0,
   "shader": {
    "code": [
     "vec4 $(name_uv)_v = $in($(uv));",
     "vec2 $(name_uv)_a = 1.0-step(vec2(1.0), $(name_uv)_v.zw);"
    ],
    "functions": [],
    "inputs": [
     {
      "default": "vec4(0.0)",
      "label": "",
      "name": "in",
      "type": "rgba"
     }
    ],
    "instance": [],
