     "\t\tsource_uv = uv+float(i)*e;",
     "\t\tsource_h = $in(source_uv);",
     "\t\th = source_h-abs(float(i))*e.x/$d;",
     "\t\tif (h > best_h) {",
     "\t\t\tbest_h = h;",
     "\t\t\tbest_source_h = source_h;",
     "\t\t\tbest_x = source_uv.x;",
     "\t\t}",
     "\t}",
     "\treturn vec2(best_source_h, best_x);",
     "}",
     ""
