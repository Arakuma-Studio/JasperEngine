{
 "code": [],
 "description": "Dilates its input following the contours or slope of an input heightmap",
 "format": 1,
 "functions": [],
 "id": "warp_dilation2_nobuf",
 "inputs": [
  {
   "default": "0.0",
   "description": "The input image",
   "function": true,
   "label": "",
   "name": "in",
   "short_description": "Input",
   "type": "f"
  },
  {
   "default": "0.0",
   "description": "The height map whose contours or slopes are followed",
   "function": true,
   "label": "",
   "name": "hm",
   "short_description": "Height map",
   "type": "f"
  }
 ],
 "instance": [
  "vec2 $(name)_slope(vec2 uv, float epsilon, float _seed_variation_, vec4 _controlled_variation_) {",
  "\tfloat dx = $hm(fract(uv+vec2(epsilon, 0.0)))-$hm(fract(uv-vec2(epsilon, 0.0)));",
  "\tfloat dy = $hm(fract(uv+vec2(0.0, epsilon)))-$hm(fract(uv-vec2(0.0, epsilon)));",
  "\treturn cos($angle*0.01745329251)*vec2(dx, dy)+sin($angle*0.01745329251)*vec2(-dy, dx);",
  "}",
  "",
  "float $(name)_dilate(vec2 uv, float _seed_variation_, vec4 _controlled_variation_) {",
  "\tfloat e = 1.0/$s;",
  "\tfloat v = 0.0;",
  "\tfor (float x = 0.0; x <= $d; x += e) {",
  "\t\tv = max(v, $in(fract(uv))*(1.0-x/$d*$a));",
  "\t\tvec2 delta = $(name)_slope(uv, e, _seed_variation_, _controlled_variation_);",
  "\t\tif (delta.x == 0.0 && delta.y == 0.0) {",
  "\t\t\tbreak;",
  "\t\t}",
  "\t\tuv += e*normalize(delta);",
  "\t}",
  "\treturn v;",
  "}"
 ],
 "kind": "shader",
 "name": "Warp Dilation 2",
 "notices": [],
 "outputs": [
  {
   "description": "The dilated image",
   "expr": "$(name)_dilate($uv, _seed_variation_, _controlled_variation_)",
   "label": "Output",
   "type": "f"
  }
 ],
 "parameters": [
  {
   "default": 10,
   "first": 7,
   "label": "Resolution",
   "last": 12,
   "name": "s",
   "type": "size"
  },
  {
   "default": 0,
   "description": "The resolution at which the contours or slopes are followed (higher values will be more precise but rendering time will be higher)",
   "label": "Angle",
   "max": 180,
   "min": -180,
   "name": "angle",
   "short_description": "Resolution",
   "step": 0.1,
   "type": "float"
  },
  {
   "default": 0.1,
   "description": "The distance along which the contours or slopes are followed",
   "label": "Distance",
   "max": 0.5,
   "min": 0,
   "name": "d",
   "short_description": "Distance",
   "step": 0.01,
   "type": "float"
  },
  {
   "default": 0,
   "description": "The attenuation applied along the path",
   "label": "Attenuation",
   "max": 1,
   "min": 0,
   "name": "a",
   "short_description": "Attenuation",
   "step": 0.01,
   "type": "float"
  }
 ],
 "short_description": "Warp Dilation",
