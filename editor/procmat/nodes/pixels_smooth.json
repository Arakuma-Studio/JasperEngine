      "r": 0.5
     },
     {
      "a": 1,
      "b": 1,
      "g": 1,
      "r": 1
     }
    ],
    "px": [
     42,
     42
    ],
    "type": "Pixels",
    "w": 8
   },
   "description": "Pixel data of the image",
   "label": "",
   "name": "pixels",
