{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jasperengine.dev/schemas/pixel_art_check.json",
  "title": "check_pixel_art / check --pixel-art result (docs/specs/S42-pixel-art-mode.md R11-R14, R22, R24)",
  "type": "object",
  "required": ["verdict", "counts", "rules", "findings", "project", "camera"],
  "properties": {
    "verdict": {"enum": ["clean", "fixable", "needs_person"]},
    "counts": {
      "type": "object",
      "required": ["fail", "warn", "fixable", "needs_person"],
      "properties": {
        "fail": {"type": "integer", "minimum": 0},
        "warn": {"type": "integer", "minimum": 0},
        "fixable": {"type": "integer", "minimum": 0},
        "needs_person": {"type": "integer", "minimum": 0}
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "checked", "findings"],
        "properties": {
          "id": {"enum": ["pixel_art_mode", "integer_scale", "filtering", "mipmaps_compression", "palette", "texel_size", "off_grid",
                          "rotation", "font_antialiasing", "particles_grid", "anti_aliasing", "sprite_variants", "cleanup_outputs"]},
          "status": {"enum": ["PASS", "WARN", "FAIL"]},
          "checked": {"type": "integer", "minimum": 0},
          "findings": {"type": "integer", "minimum": 0}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "key", "rule", "status", "target", "measured", "expected", "message", "fix"],
        "properties": {
          "id": {"type": "string", "pattern": "^F[0-9]+$"},
          "key": {"type": "string", "minLength": 3},
          "rule": {"type": "string"},
          "status": {"enum": ["WARN", "FAIL"]},
          "target": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": {"enum": ["project", "scene", "entity", "texture", "reference", "font"]},
              "path": {"type": "string"},
              "scene": {"type": "string"},
              "entity": {"type": "string"},
              "field": {"type": "string"}
            }
          },
          "measured": {},
          "expected": {},
          "message": {"type": "string", "minLength": 1},
          "fix": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "required": ["options"],
                "properties": {
                  "options": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["id", "label", "changes"],
                      "properties": {
                        "id": {"type": "string"},
                        "label": {"type": "string"},
                        "changes": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": ["target", "field", "from", "to"],
                            "properties": {"target": {"type": "string"}, "field": {"type": "string"}, "from": {}, "to": {}}
                          }
                        }
                      }
                    }
                  }
                }
              }
            ]
          },
          "needs_person": {"type": "string"}
        }
      }
    },
    "project": {
      "type": "object",
      "required": ["mode", "base_resolution", "scaling", "pixels_per_unit", "default_filter"],
      "properties": {
        "mode": {"type": "boolean"},
        "base_resolution": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2},
        "scaling": {"type": "string"},
        "pixels_per_unit": {"type": "integer", "minimum": 1},
        "default_filter": {"enum": ["point", "bilinear"]}
      }
    },
    "camera": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scene", "has_component", "mode", "layouts", "reference"],
        "properties": {
          "scene": {"type": "string"},
          "has_component": {"type": "boolean"},
          "mode": {"enum": ["pixel_perfect_camera", "fixed_resolution", "scaling"]},
          "reference": {"type": "array", "items": {"type": "integer"}},
          "layouts": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["scale", "integer", "bars"],
              "properties": {"scale": {"type": "number"}, "integer": {"type": "boolean"}, "bars": {"type": "array"}}
            }
          }
        }
      }
    }
  }
}
