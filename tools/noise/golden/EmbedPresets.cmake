# Writes the header that embeds the built-in Noise Graphs at configure time (T2 R34), as the pose
# templates are, for the editor, the core tests and the golden tool.
function(jasperengine_embed_noise_presets folder header)
    file(GLOB preset_files CONFIGURE_DEPENDS "${folder}/*.noisegraph")
    list(SORT preset_files)
    set(text "// Generated from editor/resources/noisegraphs by tools/noise/golden/EmbedPresets.cmake. Do not edit.\n#pragma once\n\n")
    set(entries "")
    set(index 0)
    foreach(preset IN LISTS preset_files)
        get_filename_component(preset_id "${preset}" NAME_WE)
        file(READ "${preset}" preset_hex HEX)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," preset_bytes "${preset_hex}")
        string(APPEND text "static const unsigned char noise_preset_${index}[] = {${preset_bytes}0x00};\n")
        string(APPEND entries "    { \"${preset_id}\", noise_preset_${index}, sizeof(noise_preset_${index}) - 1 },\n")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${preset}")
        math(EXPR index "${index} + 1")
    endforeach()
    string(APPEND text "\nstruct NoisePresetEmbeddedFile { const char* id; const unsigned char* data; unsigned int size; };\n")
    string(APPEND text "static const NoisePresetEmbeddedFile noise_preset_embedded_files[] = {\n${entries}    { nullptr, nullptr, 0 }\n};\n")
    file(WRITE "${header}.in" "${text}")
    configure_file("${header}.in" "${header}" COPYONLY)
endfunction()
