{
  "templates": [
    {
      "id": "retro/arcade-title",
      "name": {
        "en": "Arcade Title (80s chrome, grid)",
        "ja": "アーケードタイトル (80 年代クローム + グリッド)"
      },
      "description": {
        "en": "A 1920 × 1080 title: 80s horizon-chrome letters over a pixel-art subtitle and a receding stripe-grid floor; the grid backdrop is a guide layer.",
        "ja": "1920 × 1080 のタイトル：80 年代の地平線クロームの文字、ドット絵のサブタイトル、奥へ続くストライプのグリッドの床。グリッドの背景はガイドレイヤー。"
      },
      "family": "retro",
      "tags": [
        "title",
        "subtitle",
        "chrome",
        "80s",
        "pixel",
        "grid",
        "arcade"
      ],
      "synonyms": {
        "en": [
          "retro game title",
          "synthwave logo",
          "press start"
        ],
        "ja": [
          "レトロゲーム",
          "シンセウェイヴ",
          "プレススタート"
        ]
      },
      "canvas": [
        1920,
        1080
      ],
      "canvas_note": "1920 × 1080, transparent; the grid backdrop is a guide layer",
      "language": "en",
      "texts": {
        "text": {
          "en": "SUPER ARCADE",
          "ja": "スーパーアーケード"
        },
        "subtitle": {
          "en": "PRESS START",
          "ja": "プレススタート"
        }
      },
      "ops": [
        {
          "op": "set",
          "layer": "Title",
          "values": {
            "size": 180,
            "transform.position": [
              0,
              90
            ]
          }
        },
        {
          "op": "add_layer",
          "type": "generator",
          "generator": "pattern_fill",
          "name": "Backdrop",
          "before": "Title",
          "values": {
            "guide": true,
            "gen.kind": "stripes",
            "gen.color": "#ff3ad0",
            "gen.color2": "#7a2aff",
            "gen.background": "#1a0040",
            "gen.scale": 90,
            "gen.tilt": 62
          }
        },
        {
          "op": "add_layer",
          "type": "text",
          "name": "Subtitle",
          "values": {
            "text": "PRESS START",
            "size": 64,
            "transform.position": [
              0,
              -160
            ]
          }
        },
        {
          "op": "apply_look",
          "layer": "Title",
          "look": "retro/chrome-80s",
          "apply_font": true
        },
        {
          "op": "apply_look",
          "layer": "Subtitle",
          "look": "retro/pixel-8bit",
          "apply_font": true
        },
        {
          "op": "expose",
          "name": "subtitle",
          "type": "text",
          "label": "Subtitle",
          "targets": [
            {
              "layer": "Subtitle",
              "field": "text"
            }
          ]
        }
      ]
    },
    {
