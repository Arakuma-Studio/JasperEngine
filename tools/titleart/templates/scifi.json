{
  "templates": [
    {
      "id": "scifi/hud-title",
      "name": {
        "en": "HUD Title (hologram ring)",
        "ja": "HUD タイトル (ホログラムの輪)"
      },
      "description": {
        "en": "A 1920 × 1080 title: cyan HUD letters with their hologram ring and a light-guide subtitle; the backdrop is a guide layer.",
        "ja": "1920 × 1080 のタイトル：ホログラムの輪をまとうシアンの HUD 文字、ライトガイドのサブタイトル。背景はガイドレイヤー。"
      },
      "family": "scifi",
      "tags": [
        "title",
        "subtitle",
        "hud",
        "hologram",
        "cyan",
        "interface",
        "futuristic"
      ],
      "synonyms": {
        "en": [
          "system boot",
          "computer screen",
          "cockpit"
        ],
        "ja": [
          "システム起動",
          "コンピューター画面",
          "コックピット"
        ]
      },
      "canvas": [
        1920,
        1080
      ],
      "canvas_note": "1920 × 1080, transparent; the backdrop is a guide layer",
      "language": "en",
      "texts": {
        "text": {
          "en": "SYSTEM ONLINE",
          "ja": "システム起動"
        },
        "subtitle": {
          "en": "ACCESS GRANTED",
          "ja": "アクセス許可"
        }
      },
      "ops": [
        {
          "op": "set",
          "layer": "Title",
          "values": {
            "size": 150,
            "transform.position": [
              0,
              30
            ]
          }
        },
        {
          "op": "add_layer",
          "type": "generator",
          "generator": "fill",
          "name": "Backdrop",
          "before": "Title",
          "values": {
            "guide": true,
            "gen.kind": "radial",
            "gen.gradient": {
              "stops": [
                {
                  "pos": 0.0,
                  "color": "#06203a",
                  "alpha": 1,
                  "mid": 0.5
                },
                {
                  "pos": 1.0,
                  "color": "#01060e",
                  "alpha": 1,
                  "mid": 0.5
                }
              ],
              "interp": "rgb"
            }
          }
        },
        {
          "op": "add_layer",
          "type": "text",
          "name": "Subtitle",
          "values": {
            "text": "ACCESS GRANTED",
            "size": 64,
            "transform.position": [
              0,
              -120
            ]
          }
        },
        {
          "op": "apply_look",
          "layer": "Title",
          "look": "scifi/hud-cyan",
          "apply_font": true
        },
        {
          "op": "apply_look",
          "layer": "Subtitle",
          "look": "scifi/contour-light-guide",
          "apply_font": true
        },
        {
          "op": "expose",
          "name": "subtitle",
          "type": "text",
          "label": "Subtitle",
          "targets": [
            {
              "layer": "Subtitle",
              "field": "text"
            }
          ]
        },
        {
          "op": "set",
          "layer": "Title",
          "values": {
            "font": {
              "path": "TitleArt/Fonts/zen-kaku-gothic-new-black/ZenKakuGothicNew-Black.ttf"
            }
          }
        },
        {
          "op": "set",
          "layer": "Subtitle",
          "values": {
            "font": {
              "path": "TitleArt/Fonts/zen-kaku-gothic-new-black/ZenKakuGothicNew-Black.ttf"
            }
          }
        }
      ],
      "background": "dark"
    },
