{
  "templates": [
    {
      "id": "anime/episode-title",
      "name": {
        "en": "Episode Title (brush card, speed lines)",
        "ja": "サブタイトルカード (筆 + 集中線)"
      },
      "description": {
        "en": "A 1920 × 1080 title card: red brush letters with speed lines behind and a manga-ink subtitle; the backdrop is a guide layer.",
        "ja": "1920 × 1080 のタイトルカード：背後に集中線を引いた赤い筆文字、漫画インクのサブタイトル。背景はガイドレイヤー。"
      },
      "family": "anime",
      "tags": [
        "title",
        "subtitle",
        "brush",
        "manga",
        "speed-lines",
        "episode",
        "red"
      ],
      "synonyms": {
        "en": [
          "episode card",
          "chapter title",
          "anime title card"
        ],
        "ja": [
          "話数タイトル",
          "章タイトル",
          "アイキャッチ"
        ]
      },
      "canvas": [
        1920,
        1080
      ],
      "canvas_note": "1920 × 1080, transparent; the backdrop is a guide layer",
      "language": "en",
      "texts": {
        "text": {
          "en": "EPISODE 1",
          "ja": "第一話"
        },
        "subtitle": {
          "en": "THE BEGINNING",
          "ja": "始まり"
        }
      },
      "ops": [
        {
          "op": "set",
          "layer": "Title",
          "values": {
            "size": 200,
            "transform.position": [
              0,
              80
            ]
          }
        },
        {
          "op": "add_layer",
          "type": "generator",
          "generator": "fill",
          "name": "Backdrop",
          "before": "Title",
          "values": {
            "guide": true,
            "gen.kind": "linear",
            "gen.gradient": {
              "stops": [
                {
                  "pos": 0.0,
                  "color": "#fff0f4",
                  "alpha": 1,
                  "mid": 0.5
                },
                {
                  "pos": 1.0,
                  "color": "#ffd0e0",
                  "alpha": 1,
                  "mid": 0.5
                }
              ],
              "interp": "rgb"
            },
            "gen.angle": 90
          }
        },
        {
          "op": "add_layer",
          "type": "text",
          "name": "Subtitle",
          "values": {
            "text": "THE BEGINNING",
            "size": 100,
            "transform.position": [
              0,
              -150
            ]
          }
        },
        {
          "op": "apply_look",
          "layer": "Title",
          "look": "anime/title-card-brush",
          "apply_font": true
        },
        {
          "op": "apply_look",
          "layer": "Subtitle",
          "look": "anime/manga-ink",
          "apply_font": true
        },
        {
          "op": "add_layer",
          "type": "generator",
          "generator": "speed_lines",
          "name": "Speed Lines",
          "follow": "Title",
          "place": "below"
        },
        {
          "op": "expose",
          "name": "subtitle",
          "type": "text",
          "label": "Subtitle",
          "targets": [
            {
              "layer": "Subtitle",
              "field": "text"
            }
          ]
        }
      ]
    },
    {
