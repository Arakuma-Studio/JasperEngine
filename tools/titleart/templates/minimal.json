{
  "templates": [
    {
      "id": "minimal/clean-title",
      "name": {
        "en": "Clean Title (flat, soft shadow)",
        "ja": "クリーンタイトル (フラット + 柔らかい影)"
      },
      "description": {
        "en": "A 1920 × 1080 title: flat white letters with a soft shadow over a thin outline subtitle; the backdrop is a guide layer.",
        "ja": "1920 × 1080 のタイトル：柔らかい影の白いフラットな文字、細い輪郭のサブタイトル。背景はガイドレイヤー。"
      },
      "family": "minimal",
      "tags": [
        "title",
        "subtitle",
        "flat",
        "clean",
        "shadow",
        "outline",
        "simple"
      ],
      "synonyms": {
        "en": [
          "simple title",
          "film title",
          "modern"
        ],
        "ja": [
          "シンプルなタイトル",
          "映画タイトル",
          "モダン"
        ]
      },
      "canvas": [
        1920,
        1080
      ],
      "canvas_note": "1920 × 1080, transparent; the backdrop is a guide layer",
      "language": "en",
      "texts": {
        "text": {
          "en": "STILL WATERS",
          "ja": "静寂"
        },
        "subtitle": {
          "en": "A STORY",
          "ja": "ある物語"
        }
      },
      "ops": [
        {
          "op": "set",
          "layer": "Title",
          "values": {
            "size": 200,
            "transform.position": [
              0,
              60
            ]
          }
        },
        {
          "op": "add_layer",
          "type": "generator",
          "generator": "fill",
          "name": "Backdrop",
          "before": "Title",
          "values": {
            "guide": true,
            "gen.kind": "linear",
            "gen.gradient": {
              "stops": [
                {
                  "pos": 0.0,
                  "color": "#3a4a5a",
                  "alpha": 1,
                  "mid": 0.5
                },
                {
                  "pos": 1.0,
                  "color": "#1a2430",
                  "alpha": 1,
                  "mid": 0.5
                }
              ],
              "interp": "rgb"
            },
            "gen.angle": 90
          }
        },
        {
          "op": "add_layer",
          "type": "text",
          "name": "Subtitle",
          "values": {
            "text": "A STORY",
            "size": 80,
            "transform.position": [
              0,
              -120
            ]
          }
        },
        {
          "op": "apply_look",
          "layer": "Title",
          "look": "minimal/flat",
          "apply_font": true
        },
        {
          "op": "apply_look",
          "layer": "Title",
          "look": "minimal/soft-shadow",
          "apply_font": true
        },
        {
          "op": "apply_look",
          "layer": "Subtitle",
          "look": "minimal/outline-thin",
          "apply_font": true
        },
        {
          "op": "expose",
          "name": "subtitle",
          "type": "text",
          "label": "Subtitle",
          "targets": [
            {
              "layer": "Subtitle",
              "field": "text"
            }
          ]
        }
      ]
    },
