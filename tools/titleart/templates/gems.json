{
  "templates": [
    {
      "id": "gems/crystal-title",
      "name": {
        "en": "Crystal Title (3D diamond)",
        "ja": "水晶タイトル (3D ダイヤ)"
      },
      "description": {
        "en": "A 1920 × 1080 title in 3D diamond with glints, bokeh behind and a blue glass subtitle; the backdrop is a guide layer.",
        "ja": "1920 × 1080 のタイトル：きらめく 3D ダイヤの文字、背後のボケ、青いガラスのサブタイトル。背景はガイドレイヤー。"
      },
      "family": "gems",
      "tags": [
        "title",
        "subtitle",
        "3d",
        "diamond",
        "crystal",
        "glints",
        "bokeh"
      ],
      "synonyms": {
        "en": [
          "diamond title",
          "jewel logo",
          "sparkle"
        ],
        "ja": [
          "ダイヤのタイトル",
          "宝石ロゴ",
          "キラキラ"
        ]
      },
      "canvas": [
        1920,
        1080
      ],
      "canvas_note": "1920 × 1080, transparent; the backdrop is a guide layer",
      "language": "en",
      "texts": {
        "text": {
          "en": "CRYSTAL",
          "ja": "水晶"
        },
        "subtitle": {
          "en": "LEGEND",
          "ja": "伝説"
        }
      },
      "ops": [
        {
          "op": "set",
          "layer": "Title",
          "values": {
            "size": 240,
            "transform.position": [
              0,
              70
            ]
          }
        },
        {
          "op": "add_layer",
          "type": "generator",
          "generator": "fill",
          "name": "Backdrop",
          "before": "Title",
          "values": {
            "guide": true,
            "gen.kind": "radial",
            "gen.gradient": {
              "stops": [
                {
                  "pos": 0.0,
                  "color": "#1a1040",
                  "alpha": 1,
                  "mid": 0.5
                },
                {
                  "pos": 1.0,
                  "color": "#04020c",
                  "alpha": 1,
                  "mid": 0.5
                }
              ],
              "interp": "rgb"
            }
          }
        },
        {
          "op": "add_layer",
          "type": "generator",
          "generator": "particles",
          "name": "Bokeh",
          "preset": "bokeh",
          "after": "Backdrop"
        },
        {
          "op": "add_layer",
          "type": "text",
          "name": "Subtitle",
          "values": {
            "text": "LEGEND",
            "size": 110,
            "transform.position": [
              0,
              -160
            ]
          }
        },
        {
          "op": "apply_look",
          "layer": "Title",
          "look": "gems/diamond-3d",
          "apply_font": true
        },
        {
          "op": "apply_look",
          "layer": "Subtitle",
          "look": "gems/blue-glass",
          "apply_font": true
        },
        {
          "op": "add_layer",
          "type": "generator",
          "generator": "glints",
          "name": "Glints",
          "follow": "Title"
        },
        {
          "op": "expose",
          "name": "subtitle",
          "type": "text",
          "label": "Subtitle",
          "targets": [
            {
              "layer": "Subtitle",
              "field": "text"
            }
          ]
        }
      ]
    },
