{
  "templates": [
    {
      "id": "cartoon/party-title",
      "name": {
        "en": "Party Title (bubble, comic burst)",
        "ja": "パーティータイトル (バブル + コミック爆発)"
      },
      "description": {
        "en": "A 1920 × 1080 title: glossy bubble letters on a comic burst with confetti over them; the backdrop is a guide layer.",
        "ja": "1920 × 1080 のタイトル：コミック風の爆発図形に光沢のあるバブル文字、その上に紙吹雪。背景はガイドレイヤー。"
      },
      "family": "cartoon",
      "tags": [
        "title",
        "bubble",
        "comic",
        "burst",
        "confetti",
        "party",
        "fun"
      ],
      "synonyms": {
        "en": [
          "celebration",
          "party banner",
          "festival"
        ],
        "ja": [
          "お祝い",
          "パーティー",
          "お祭り"
        ]
      },
      "canvas": [
        1920,
        1080
      ],
      "canvas_note": "1920 × 1080, transparent; the backdrop is a guide layer",
      "language": "en",
      "texts": {
        "text": {
          "en": "PARTY TIME",
          "ja": "パーティータイム"
        }
      },
      "ops": [
        {
          "op": "set",
          "layer": "Title",
          "values": {
            "size": 220,
            "transform.position": [
              0,
              0
            ]
          }
        },
        {
          "op": "add_layer",
          "type": "generator",
          "generator": "fill",
          "name": "Backdrop",
          "before": "Title",
          "values": {
            "guide": true,
            "gen.kind": "linear",
            "gen.gradient": {
              "stops": [
                {
                  "pos": 0.0,
                  "color": "#bfe8ff",
                  "alpha": 1,
                  "mid": 0.5
                },
                {
                  "pos": 1.0,
                  "color": "#5ab0ff",
                  "alpha": 1,
                  "mid": 0.5
                }
              ],
              "interp": "rgb"
            },
            "gen.angle": 90
          }
        },
        {
          "op": "add_layer",
          "type": "shape",
          "name": "Burst",
          "before": "Title",
          "values": {
            "shape": "burst",
            "size": 640,
            "aspect": 2.6,
            "transform.position": [
              0,
              0
            ],
            "points": 18,
            "inner": 0.78
          }
        },
        {
          "op": "apply_look",
          "layer": "Burst",
          "look": "cartoon/comic-burst",
          "apply_font": true
        },
        {
          "op": "apply_look",
          "layer": "Title",
          "look": "cartoon/bubble-pop",
          "apply_font": true
        },
        {
          "op": "add_layer",
          "type": "generator",
          "generator": "particles",
          "name": "Confetti",
          "preset": "confetti"
        },
        {
          "op": "set",
          "layer": "Title",
          "values": {
            "font": {
              "path": "TitleArt/Fonts/mplus1p-black/MPLUS1p-Black.ttf"
            }
          }
        }
      ]
    },
