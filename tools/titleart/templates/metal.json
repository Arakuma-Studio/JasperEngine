          "values": {
            "size": 180,
            "transform.position": [
              0,
              60
            ]
          }
        },
        {
          "op": "add_layer",
          "type": "generator",
          "generator": "fill",
          "name": "Backdrop",
          "before": "Title",
          "values": {
            "guide": true,
            "gen.kind": "linear",
            "gen.gradient": {
              "stops": [
                {
                  "pos": 0.0,
                  "color": "#2a3038",
                  "alpha": 1,
                  "mid": 0.5
                },
                {
                  "pos": 1.0,
                  "color": "#0a0c10",
                  "alpha": 1,
                  "mid": 0.5
                }
              ],
              "interp": "rgb"
            },
            "gen.angle": 90
          }
        },
        {
          "op": "add_layer",
          "type": "text",
          "name": "Subtitle",
          "values": {
            "text": "RISE",
            "size": 120,
            "transform.position": [
              0,
              -165
            ]
          }
        },
        {
          "op": "apply_look",
          "layer": "Title",
          "look": "metal/chrome-3d",
          "apply_font": true
        },
        {
          "op": "apply_look",
          "layer": "Subtitle",
          "look": "metal/silver-premium",
          "apply_font": true
        },
        {
          "op": "add_layer",
          "type": "generator",
          "generator": "lens_flare",
          "name": "Lens Flare",
          "follow": "Title",
          "values": {
            "gen.position": [
              -700,
              100
            ]
          }
        },
        {
          "op": "expose",
          "name": "subtitle",
          "type": "text",
          "label": "Subtitle",
          "targets": [
            {
              "layer": "Subtitle",
              "field": "text"
            }
          ]
        }
      ],
      "check_allow": [
        {
          "check": "counter_survival",
          "reason": "survival 0.67 of 6 counters on the 'en' sample at the look's own rim and band widths (a heavy stack closes small counters)"
        }
      ]
    },
