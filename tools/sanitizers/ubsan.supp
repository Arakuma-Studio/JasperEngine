# recastnavigation (engine/libs/recastnavigation, upstream as of v1.6.0 and main): the proximity
# grid's spatial hash multiplies cell coordinates in int and wraps on purpose; it overflows for
# crowds far from the origin (a 600 m corridor: NavCrowdTest.CorridorAtCapacity)
signed-integer-overflow:DetourProximityGrid.cpp
