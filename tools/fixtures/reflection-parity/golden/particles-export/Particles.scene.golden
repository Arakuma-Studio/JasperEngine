      particlesystem:
        enabled: true
        inlineEffect: "{\n  \"version\": 1,\n  \"duration\": 3.3333333,\n  \"simulationSpace\": \"world\",\n  \"tickRate\": 60,\n  \"maxParticles\": 200,\n  \"scalingMode\": \"shape\",\n  \"modules\": [\n    {\n      \"type\": \"main\",\n      \"startLifetime\": {\n        \"mode\": \"twoConstants\",\n        \"constant\": 0.5,\n        \"constantMax\": 1.0\n      },\n      \"startSpeed\": 0.0,\n      \"startSize\": {\n        \"mode\": \"twoConstants\",\n        \"constant\": 0.35,\n        \"constantMax\": 0.5\n      }\n    },\n    {\n      \"type\": \"emission\",\n      \"rateOverTime\": 60.0,\n      \"maxPerTick\": 100\n    },\n    {\n      \"type\": \"shape\",\n      \"shape\": \"circle\",\n      \"radius\": 0.25\n    },\n    {\n      \"type\": \"startVelocity\",\n      \"min\": [\n        -0.15,\n        1.0,\n        -0.15\n      ],\n      \"max\": [\n        0.15,\n        2.0,\n        0.15\n      ]\n    },\n    {\n      \"type\": \"colorOverLifetime\",\n      \"color\": {\n        \"mode\": \"gradient\",\n        \"gradient\": {\n          \"colorKeys\": [\n            [\n              0.0,\n              1.0,\n              0.9,\n              0.4\n            ],\n            [\n              1.0,\n              0.35,\n              0.08,\n              0.03\n            ]\n          ],\n          \"alphaKeys\": []\n        }\n      },\n      \"setMode\": true\n    },\n    {\n      \"type\": \"renderer\",\n      \"untexturedShape\": \"square\",\n      \"depthWrite\": true,\n      \"sortMode\": \"byDistance\",\n      \"maxScreenSize\": 10.0\n    }\n  ]\n}\n"
        playOnAwake: false
        seed: 0
        playbackSpeed: 1
