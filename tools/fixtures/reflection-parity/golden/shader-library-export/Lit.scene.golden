entities:
  - type: Entity
    entity: 1001
    name: Directional Light
    components:
      transform:
        position: [0, 10, 0]
        rotation: [1, 0, 0, 0]
        scale: [1, 1, 1]
        visible: true
        billboardRotation: [1, 0, 0, 0]
        billboard: false
        fakeBillboard: false
        cylindricalBillboard: false
      light:
        enabled: true
        type: directional
        direction: [-0.4, -1, -0.6]
        worldDirection: [-0.4, -1, -0.6]
        color: [1, 1, 1]
        range: 100
        intensity: 3
        innerConeCos: 0.76604444
        outerConeCos: 0.64278764
        spotMask: ~
        cullingMask: 4294967295
        shadows: true
        automaticShadowCamera: true
        shadowBias: 1
        mapResolution: 2048
        shadowCameraNearFar: [0.3, 100]
        numShadowCascades: 3
  - type: Entity
    entity: 1002
    name: Skybox
    components:
      skybox:
        useDefaultTexture: true
        texture:
          textureType: CUBE
          cubeMode: faces
          source: paths
          paths: ["", "", "", "", "", ""]
          hasEmptyFaces: true
          minFilter: linear
          magFilter: linear
          wrapU: repeat
          wrapV: repeat
          releaseDataAfterLoad: false
        color: [1, 1, 1, 1]
        rotation: 0
        visible: true
        customShader: library:procedural_sky
        shaderUniforms:
          cloudColor: [1, 0.95, 0.9, 1]
          cloudCoverage: [0.55, 0, 0, 0]
          cloudSpeed: [0, 0, 0, 0]
          exposure: [1.1, 0, 0, 0]
          horizonColor: [0.9, 0.7, 0.6, 1]
          skyColor: [0.1, 0.25, 0.8, 1]
          sunSize: [2.5, 0, 0, 0]
        shaderTextures:
          u_cloudTexture:
            textureType: 2D
            source: path
            path: assets/textures/noise.png
            guid: 4c206b1fcabdf81dd8beac1db9c8aeb8
            minFilter: linear
            magFilter: linear
            wrapU: repeat
            wrapV: repeat
            releaseDataAfterLoad: true
        shaderFeatures: [CLOUDS]
  - type: Entity
    entity: 1003
    name: Ground
    components:
      transform:
        position: [0, 0, -3.5]
        rotation: [1, 0, 0, 0]
        scale: [1, 1, 1]
        visible: true
        billboardRotation: [1, 0, 0, 0]
        billboard: false
        fakeBillboard: false
        cylindricalBillboard: false
      mesh:
        enabled: true
        buffer:
          type: vertex_buffer
          usage: immutable
          stride: 48
          size: 192
          count: 4
          renderAttributes: true
          instanceBuffer: false
          attributes:
            - type: position
              dataType: float
              bufferName: ""
              elements: 3
              offset: 0
              count: 4
              normalized: true
              perInstance: false
            - type: texcoord1
              dataType: float
              bufferName: ""
              elements: 2
              offset: 12
              count: 4
              normalized: true
              perInstance: false
            - type: normal
