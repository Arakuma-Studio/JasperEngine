        scene->setEntityActive(root, true);
        scene->setEntityTag(root, "Untagged");
        scene->setEntityLayer(root, 0);
    }

    // Create member entities
    Entity e0 = scene->createEntity();
    scene->setEntityName(e0, "Hub");
    members.push_back(e0);

    // Components of the root GameObject
    {
        if (!scene->findComponent<Transform>(root)) {
            Transform transform;
            transform.position = Vector3(0.000000f, 0.000000f, 0.000000f);
            transform.rotation = Quaternion(1.000000f, 0.000000f, 0.000000f, 0.000000f);
            transform.scale = Vector3(1.000000f, 1.000000f, 1.000000f);
            transform.visible = true;
            transform.billboard = false;
            transform.fakeBillboard = false;
            transform.cylindricalBillboard = false;
            transform.billboardRotation = Quaternion(1.000000f, 0.000000f, 0.000000f, 0.000000f);
            scene->addComponent<Transform>(root, transform);
        }
    }

    // Components for Hub
    {
        Transform transform;
        transform.position = Vector3(0.000000f, 0.000000f, 0.500000f);
        transform.rotation = Quaternion(1.000000f, 0.000000f, 0.000000f, 0.000000f);
        transform.scale = Vector3(1.000000f, 1.000000f, 1.000000f);
        transform.visible = true;
        transform.billboard = false;
        transform.fakeBillboard = false;
        transform.cylindricalBillboard = false;
        transform.billboardRotation = Quaternion(1.000000f, 0.000000f, 0.000000f, 0.000000f);
        scene->addComponent<Transform>(e0, transform);
    }

    // Parent-child hierarchy
    scene->addEntityChild(root, e0, false);
    return true;
}

bool create_prefab_prefabs_Wheel(Scene* scene, Entity root) {
