JASPERENGINE_INIT void init() {
#ifdef JASPERENGINE_PROJECT_PATH
    ShaderManifests::setForkReader([](const std::string& path, std::string& content) {
        if (!ShaderVariantCompiler::isSafeRelativePath(path))
            return false;
        for (const char* root : {JASPERENGINE_PROJECT_PATH, JASPERENGINE_ASSET_PATH}) {
            std::ifstream file(std::string(root) + "/" + path, std::ios::binary);
            if (file) {
                content.assign(std::istreambuf_iterator<char>(file), std::istreambuf_iterator<char>());
                return true;
            }
        }
        return false;
    });
#endif
    Engine::setCanvasSize(1280, 720);
    Engine::setScalingMode(Scaling::FITWIDTH);
    Engine::setTextureStrategy(TextureStrategy::NONE);
    Engine::setAtmosphereQualityDefaults(AtmosphereQuality::HIGH, AtmosphereQuality::LOW, AtmosphereQuality::LOW);
    UIDocumentSystem::setPreferredSampleCount(4);

    SceneManager::registerScene(2154334445, "Lit", load_Lit, add_Lit, {2154334445}, resources_Lit);
    SceneManager::registerScene(242685459, "Blend", load_Blend, add_Blend, {242685459}, resources_Blend);
