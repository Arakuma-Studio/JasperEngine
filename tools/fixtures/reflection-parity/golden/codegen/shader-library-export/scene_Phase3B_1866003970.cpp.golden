        texture.setPath("assets/textures/fx_water_normal.png");
        texture.setMinFilter(TextureFilter::LINEAR);
        texture.setMagFilter(TextureFilter::LINEAR);
        texture.setWrapU(TextureWrap::REPEAT);
        texture.setWrapV(TextureWrap::REPEAT);
        resources.textures.push_back(texture);
    }
    {
        Texture texture;
        texture.setCubeMap("assets/textures/p3b_sky_cross.png");
        texture.setMinFilter(TextureFilter::LINEAR);
        texture.setMagFilter(TextureFilter::LINEAR);
        texture.setWrapU(TextureWrap::REPEAT);
        texture.setWrapV(TextureWrap::REPEAT);
        resources.textures.push_back(texture);
    }
    resources.models.push_back("assets/models/uv_sphere.gltf");
    resources.models.push_back("assets/models/box.gltf");
    return resources;
}
