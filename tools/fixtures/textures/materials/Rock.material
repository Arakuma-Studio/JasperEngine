name: materials/Rock.material
baseColorFactor: [1, 1, 1, 1]
metallicFactor: 0
roughnessFactor: 1
baseColorTexture: {textureType: 2D, source: path, path: textures/photo.png, minFilter: linear, magFilter: linear, wrapU: repeat, wrapV: repeat, releaseDataAfterLoad: true}
normalTexture: {textureType: 2D, source: path, path: textures/normal.png, minFilter: linear, magFilter: linear, wrapU: repeat, wrapV: repeat, releaseDataAfterLoad: true}
occlusionTexture: {textureType: 2D, source: path, path: textures/ao.png, minFilter: linear, magFilter: linear, wrapU: repeat, wrapV: repeat, releaseDataAfterLoad: true}
