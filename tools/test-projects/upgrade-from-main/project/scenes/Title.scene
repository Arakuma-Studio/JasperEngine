        fakeBillboard: false
        cylindricalBillboard: false
      uidocument:
        enabled: true
        filename: assets/ui/title.html
        sortOrder: 0
      script:
        scripts:
          - type: lua
            path: Title.lua
            className: Title
            enabled: true
            properties:
              - name: nextScene
                displayName: Next Scene
                type: String
                value: Level1
                defaultValue: Level1
              - name: startDelay
                displayName: Start Delay (frames)
                type: Int
                value: 6
                defaultValue: 6
