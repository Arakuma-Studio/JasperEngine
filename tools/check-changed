#!/usr/bin/env bash
# The per-commit gate of a stream: builds what the change touches and runs the unit and MCP tests
# that can see it (tools/check_changed.py). On a build server: rb.sh <S> tools/check-changed [--dry-run].
# The full suite stays the gate of batch landings and of main (docs/testing.md).
exec python3 -I "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/check_changed.py" "$@"
