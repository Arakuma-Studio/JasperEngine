#htmlui-root img.cover {
object-fit: cover;
object-position: center top;
}
#htmlui-root img.contain {
object-fit: contain;
object-position: 20% 80%;
}
#htmlui-root img.none {
object-fit: none;
object-position: left;
}
#htmlui-root img.sd {
object-fit: scale-down;
object-position: 10px 0px;
}
#htmlui-root img.fill {
object-fit: fill;
}
