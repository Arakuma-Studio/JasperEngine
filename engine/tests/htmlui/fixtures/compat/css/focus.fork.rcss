#htmlui-root button:focus {
outline: 2px solid #0000ffff;
}
#htmlui-root input:focus-visible {
--html-box-shadow: 0px 0px 0px 2px #ffa500ff;
box-shadow: var(--html-outline-shadow, 0 0 0 0 #0000), var(--html-box-shadow, 0 0 0 0 #0000);
}
#htmlui-root .menu:focus-within {
background-color: #eeeeeeff;
}
#htmlui-root :focus, body#htmlui-root:focus {
color: #ff0000ff;
--html-current-color: #ff0000ff;
}
#htmlui-root :focus:not(:focus-visible), body#htmlui-root:focus:not(:focus-visible) {
outline: none;
}
#htmlui-root a:hover:focus {
color: #008000ff;
--html-current-color: #008000ff;
}
