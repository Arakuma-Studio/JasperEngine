#htmlui-root .pixel {
image-rendering: pixelated;
}
#htmlui-root .crisp {
image-rendering: crisp-edges;
}
#htmlui-root .auto {
image-rendering: auto;
}
#htmlui-root .smooth {
image-rendering: smooth;
}
#htmlui-root .hq {
image-rendering: high-quality;
}
#htmlui-root .old {
image-rendering: crisp-edges;
}
#htmlui-root .moz {
image-rendering: crisp-edges;
}
