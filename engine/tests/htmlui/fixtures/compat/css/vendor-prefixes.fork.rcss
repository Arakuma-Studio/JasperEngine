#htmlui-root .a {
transition: opacity 1s;
border-radius: 4px;
--html-box-shadow: 0px 1px 2px #000000ff;
box-shadow: var(--html-outline-shadow, 0 0 0 0 #0000), var(--html-box-shadow, 0 0 0 0 #0000);
}
#htmlui-root .dup {
transform: scale(2);
border-radius: 3px;
}
#htmlui-root .box {
display: flex;
flex-direction: column;
justify-content: center;
align-items: center;
}
#htmlui-root .flex {
display: flex;
flex: 1 1 0%;
}
#htmlui-root .ms {
display: flex;
justify-content: space-between;
align-items: center;
flex: 1 0 auto;
}
#htmlui-root .inline {
display: inline-flex;
}
#htmlui-root .grad {
background-color: transparent;
background-image: linear-gradient(to bottom, #ffffffff, #000000ff);
background-position-x: 0%;
background-position-y: 0%;
background-size: auto auto;
background-repeat: repeat repeat;
background-origin: padding-box;
background-clip: border-box;
background-attachment: scroll;
}
#htmlui-root .grad2 {
background-image: linear-gradient(45deg, #ff0000ff, #0000ffff);
}
#htmlui-root .grad3 {
background-color: transparent;
background-image: radial-gradient(circle farthest-corner at 50% 50%, #ff0000ff, #0000ffff);
background-position-x: 0%;
background-position-y: 0%;
background-size: auto auto;
background-repeat: repeat repeat;
background-origin: padding-box;
background-clip: border-box;
background-attachment: scroll;
}
#htmlui-root .old {
background-color: transparent;
background-image: none;
}
#htmlui-root .sticky {
position: sticky;
}
#htmlui-root .clip {
background-clip: padding-box;
}
#htmlui-root .fill {
color: #ff00ffff;
--html-current-color: #ff00ffff;
}
