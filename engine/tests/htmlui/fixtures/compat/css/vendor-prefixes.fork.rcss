#htmlui-root .a {
transition: opacity 1s;
border-radius: 4px;
--html-box-shadow: 0px 1px 2px #000000ff;
box-shadow: var(--html-outline-shadow, 0 0 0 0 #0000), var(--html-box-shadow, 0 0 0 0 #0000);
}
#htmlui-root .dup {
transform: scale(2);
border-radius: 3px;
}
#htmlui-root .box {
display: flex;
flex-direction: column;
justify-content: center;
align-items: center;
}
#htmlui-root .flex {
display: flex;
flex: 1 1 0%;
}
#htmlui-root .ms {
display: flex;
justify-content: space-between;
align-items: center;
flex: 1 0 auto;
}
#htmlui-root .inline {
display: inline-flex;
}
#htmlui-root .grad {
background-color: transparent;
decorator: linear-gradient(to bottom, #ffffffff, #000000ff) border-box;
}
#htmlui-root .grad2 {
decorator: linear-gradient(45deg, #ff0000ff, #0000ffff) border-box;
}
#htmlui-root .grad3 {
background-color: transparent;
decorator: radial-gradient(circle farthest-corner at 50% 50%, #ff0000ff, #0000ffff) border-box;
}
#htmlui-root .old {
background-color: transparent;
decorator: none;
}
#htmlui-root .sticky {
position: relative;
}
#htmlui-root .fill {
color: #ff00ffff;
--html-current-color: #ff00ffff;
}
