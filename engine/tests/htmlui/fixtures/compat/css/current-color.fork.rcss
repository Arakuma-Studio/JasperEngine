#htmlui-root .same-rule {
color: #336699ff;
--html-current-color: #336699ff;
border-top-width: 2px;
border-top-style: solid;
border-top-color: currentcolor;
border-right-width: 2px;
border-right-style: solid;
border-right-color: currentcolor;
border-bottom-width: 2px;
border-bottom-style: solid;
border-bottom-color: currentcolor;
border-left-width: 2px;
border-left-style: solid;
border-left-color: currentcolor;
border-image: none;
--html-box-shadow: 0px 0px 4px currentcolor;
box-shadow: var(--html-outline-shadow, 0 0 0 0 #0000), var(--html-box-shadow, 0 0 0 0 #0000);
}
#htmlui-root .companion {
background-color: currentcolor;
outline: 1px solid currentcolor;
}
#htmlui-root .borders-no-color {
border-right-width: 3px;
border-right-style: solid;
border-right-color: currentcolor;
border-bottom-width: 3px;
border-bottom-style: solid;
border-bottom-color: currentcolor;
border-left-width: 3px;
border-left-style: solid;
border-left-color: currentcolor;
border-image: none;
border-top-width: 1px;
border-top-style: dashed;
border-top-color: currentcolor;
}
#htmlui-root .color-itself {
color: currentcolor;
}
#htmlui-root .icon {
fill: currentcolor;
stroke: currentcolor;
}
#htmlui-root .gradient {
background-color: transparent;
background-image: linear-gradient(currentcolor, #00000000);
background-position-x: 0%;
background-position-y: 0%;
background-size: auto auto;
background-repeat: repeat repeat;
background-origin: padding-box;
background-clip: border-box;
background-attachment: scroll;
}
#htmlui-root .var-color {
color: var(--theme);
}
