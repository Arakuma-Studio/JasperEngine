#htmlui-root .frame {
border-top-width: 10px;
border-top-style: solid;
border-top-color: #00000000;
border-right-width: 10px;
border-right-style: solid;
border-right-color: #00000000;
border-bottom-width: 10px;
border-bottom-style: solid;
border-bottom-color: #00000000;
border-left-width: 10px;
border-left-style: solid;
border-left-color: #00000000;
border-image: none;
--html-border-image: html-border-image("asset://compat/css/img/a.png" 30 30 30 30 nofill 1 1 1 1 0 0 0 0 round round);
decorator: var(--html-border-image, linear-gradient(#0000, #0000)), var(--html-bg-layers, linear-gradient(#0000, #0000));
}
#htmlui-root .full {
--html-border-image: html-border-image("asset://compat/css/img/a.png" 10% 20 30 40 fill 8px 2 auto 2 1px 2px 1px 2px stretch repeat);
decorator: var(--html-border-image, linear-gradient(#0000, #0000)), var(--html-bg-layers, linear-gradient(#0000, #0000));
}
#htmlui-root .longhands {
--html-border-image: html-border-image("asset://compat/css/img/b.png" 25% 25% 25% 25% nofill 12px 12px 12px 12px 2px 2px 2px 2px space space);
decorator: var(--html-border-image, linear-gradient(#0000, #0000)), var(--html-bg-layers, linear-gradient(#0000, #0000));
}
#htmlui-root .base {
--html-border-image: html-border-image("asset://compat/css/img/a.png" 10 10 10 10 nofill 1 1 1 1 0 0 0 0 stretch stretch);
decorator: var(--html-border-image, linear-gradient(#0000, #0000)), var(--html-bg-layers, linear-gradient(#0000, #0000));
}
#htmlui-root .base:hover {
--html-border-image: html-border-image("asset://compat/css/img/a.png" 20 20 20 20 nofill 1 1 1 1 0 0 0 0 stretch stretch);
decorator: var(--html-border-image, linear-gradient(#0000, #0000)), var(--html-bg-layers, linear-gradient(#0000, #0000));
}
#htmlui-root .none {
--html-border-image: linear-gradient(#0000, #0000);
decorator: var(--html-border-image, linear-gradient(#0000, #0000)), var(--html-bg-layers, linear-gradient(#0000, #0000));
}
#htmlui-root .bg {
background-color: transparent;
background-image: url("asset://compat/css/img/b.png");
background-position-x: 0%;
background-position-y: 0%;
background-size: auto auto;
background-repeat: no-repeat no-repeat;
background-origin: padding-box;
background-clip: border-box;
background-attachment: scroll;
}
#htmlui-root .bg-gradient {
background-color: transparent;
background-image: linear-gradient(#000000ff, #ffffffff);
background-position-x: 0%;
background-position-y: 0%;
background-size: auto auto;
background-repeat: repeat repeat;
background-origin: padding-box;
background-clip: border-box;
background-attachment: scroll;
}
