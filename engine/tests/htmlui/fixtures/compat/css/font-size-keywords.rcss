#htmlui-root .xxs {
font-size: 9px;
}
#htmlui-root .xs {
font-size: 10px;
}
#htmlui-root .s {
font-size: 13px;
}
#htmlui-root .m {
font-size: 16px;
}
#htmlui-root .l {
font-size: 18px;
}
#htmlui-root .xl {
font-size: 24px;
}
#htmlui-root .xxl {
font-size: 32px;
}
#htmlui-root .xxxl {
font-size: 48px;
}
#htmlui-root .smaller {
font-size: 0.8333em;
}
#htmlui-root .larger {
font-size: 1.2em;
}
#htmlui-root .percent {
font-size: 80%;
}
#htmlui-root .em {
font-size: 1.25em;
}
#htmlui-root .rem {
font-size: 1.5rem;
}
#htmlui-root .zero {
font-size: 0px;
}
