#htmlui-root .one {
--html-box-shadow: 0px 4px 6px #0000001a;
box-shadow: var(--html-outline-shadow, 0 0 0 0 #0000), var(--html-box-shadow, 0 0 0 0 #0000);
}
#htmlui-root .inset {
--html-box-shadow: inset 0px 0px 0px 2px #ffffffff;
box-shadow: var(--html-outline-shadow, 0 0 0 0 #0000), var(--html-box-shadow, 0 0 0 0 #0000);
}
#htmlui-root .spread {
--html-box-shadow: 0px 0px 0px 4px #00aaffff;
box-shadow: var(--html-outline-shadow, 0 0 0 0 #0000), var(--html-box-shadow, 0 0 0 0 #0000);
}
#htmlui-root .list {
--html-box-shadow: 0px 1px 2px #00000033, 0px 8px 24px -4px #0000004d, inset 0px 1px 0px #ffffff1a;
box-shadow: var(--html-outline-shadow, 0 0 0 0 #0000), var(--html-box-shadow, 0 0 0 0 #0000);
}
#htmlui-root .color-first {
--html-box-shadow: #ff0000ff 2px 2px;
box-shadow: var(--html-outline-shadow, 0 0 0 0 #0000), var(--html-box-shadow, 0 0 0 0 #0000);
}
#htmlui-root .no-color {
color: #ff8800ff;
--html-current-color: #ff8800ff;
--html-box-shadow: 0px 0px 10px #ff8800ff;
box-shadow: var(--html-outline-shadow, 0 0 0 0 #0000), var(--html-box-shadow, 0 0 0 0 #0000);
}
#htmlui-root .none {
--html-box-shadow: 0 0 0 0 #0000;
box-shadow: var(--html-outline-shadow, 0 0 0 0 #0000), var(--html-box-shadow, 0 0 0 0 #0000);
}
#htmlui-root .var {
--html-box-shadow: var(--elevation);
box-shadow: var(--html-outline-shadow, 0 0 0 0 #0000), var(--html-box-shadow, 0 0 0 0 #0000);
}
body#htmlui-root {
--elevation: 0 2px 8px #00000040;
}
