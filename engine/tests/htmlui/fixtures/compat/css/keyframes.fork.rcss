@keyframes simple {
0% {
opacity: 0;
}
100% {
opacity: 1;
}
}
@keyframes lists {
0%, 50% {
color: #ff0000ff;
}
25%, 75% {
color: #0000ffff;
}
100% {
color: #008000ff;
}
}
@keyframes easing {
0% {
opacity: 0;
}
100% {
opacity: 1;
}
}
@keyframes bad-selector {
0% {
opacity: 0;
}
}
@keyframes kf-43079b1c {
100% {
transform: rotate(360deg);
}
}
@keyframes kf-48dc5779 {
100% {
opacity: 0;
}
}
@keyframes prefixed {
0% {
opacity: 0;
}
100% {
opacity: 1;
}
}
@keyframes moz {
100% {
opacity: 1;
}
}
@keyframes rewrites {
0% {
background-color: transparent;
decorator: linear-gradient(#ff0000ff, #0000ffff) border-box;
box-shadow: 0px 0px 0px #000000ff;
border-top-width: 1px;
border-top-style: solid;
border-top-color: #ff0000ff;
border-right-width: 1px;
border-right-style: solid;
border-right-color: #ff0000ff;
border-bottom-width: 1px;
border-bottom-style: solid;
border-bottom-color: #ff0000ff;
border-left-width: 1px;
border-left-style: solid;
border-left-color: #ff0000ff;
}
100% {
background-color: #00000080;
box-shadow: 0px 0px 20px #ff0000ff;
transform: translateX(10px) rotate(45deg);
}
}
@keyframes nested {
0% {
width: 10px;
}
}
#htmlui-root .use {
animation: 1s kf-43079b1c, 2s kf-48dc5779;
-html-animation-fill: none;
}
