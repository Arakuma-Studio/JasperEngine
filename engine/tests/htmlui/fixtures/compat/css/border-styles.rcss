#htmlui-root .solid {
border-top-width: 2px;
border-top-color: #808080ff;
border-right-width: 2px;
border-right-color: #808080ff;
border-bottom-width: 2px;
border-bottom-color: #808080ff;
border-left-width: 2px;
border-left-color: #808080ff;
}
#htmlui-root .dashed {
border-top-width: 2px;
border-top-color: #808080ff;
border-right-width: 2px;
border-right-color: #808080ff;
border-bottom-width: 2px;
border-bottom-color: #808080ff;
border-left-width: 2px;
border-left-color: #808080ff;
}
#htmlui-root .dotted {
border-top-width: 2px;
border-top-color: #808080ff;
border-right-width: 2px;
border-right-color: #808080ff;
border-bottom-width: 2px;
border-bottom-color: #808080ff;
border-left-width: 2px;
border-left-color: #808080ff;
}
#htmlui-root .double {
border-top-width: 3px;
border-top-color: #808080ff;
border-right-width: 3px;
border-right-color: #808080ff;
border-bottom-width: 3px;
border-bottom-color: #808080ff;
border-left-width: 3px;
border-left-color: #808080ff;
}
#htmlui-root .inset {
border-top-width: 2px;
border-top-color: #2b2b2bff;
border-right-width: 2px;
border-right-color: #d4d4d4ff;
border-bottom-width: 2px;
border-bottom-color: #d4d4d4ff;
border-left-width: 2px;
border-left-color: #2b2b2bff;
}
#htmlui-root .outset {
border-top-width: 2px;
border-top-color: #d4d4d4ff;
border-right-width: 2px;
border-right-color: #2b2b2bff;
border-bottom-width: 2px;
border-bottom-color: #2b2b2bff;
border-left-width: 2px;
border-left-color: #d4d4d4ff;
}
#htmlui-root .groove {
border-top-width: 2px;
border-top-color: #2b2b2bff;
border-right-width: 2px;
border-right-color: #d4d4d4ff;
border-bottom-width: 2px;
border-bottom-color: #d4d4d4ff;
border-left-width: 2px;
border-left-color: #2b2b2bff;
}
#htmlui-root .ridge {
border-top-width: 2px;
border-top-color: #d4d4d4ff;
border-right-width: 2px;
border-right-color: #2b2b2bff;
border-bottom-width: 2px;
border-bottom-color: #2b2b2bff;
border-left-width: 2px;
border-left-color: #d4d4d4ff;
}
#htmlui-root .inset-black {
border-top-width: 1px;
border-top-color: #000000ff;
border-right-width: 1px;
border-right-color: #545454ff;
border-bottom-width: 1px;
border-bottom-color: #545454ff;
border-left-width: 1px;
border-left-color: #000000ff;
}
#htmlui-root .inset-var {
border-top-width: 1px;
border-top-color: var(--c);
border-right-width: 1px;
border-right-color: var(--c);
border-bottom-width: 1px;
border-bottom-color: var(--c);
border-left-width: 1px;
border-left-color: var(--c);
}
#htmlui-root .hidden {
border-top-width: 0px;
border-top-color: #ff0000ff;
border-right-width: 0px;
border-right-color: #ff0000ff;
border-bottom-width: 0px;
border-bottom-color: #ff0000ff;
border-left-width: 0px;
border-left-color: #ff0000ff;
}
#htmlui-root .style-alone {
border-top-width: 3px;
border-right-width: 3px;
border-bottom-width: 3px;
border-left-width: 3px;
}
#htmlui-root .style-none {
border-width: 2px;
border-top-width: 0px;
border-right-width: 0px;
border-bottom-width: 0px;
border-left-width: 0px;
}
#htmlui-root .style-sides {
border-top-width: 3px;
border-right-width: 0px;
border-bottom-width: 3px;
border-left-width: 0px;
}
#htmlui-root .style-with-width {
border-width: 1px;
}
#htmlui-root .base {
border-width: 5px;
}
#htmlui-root .base:hover {
border-top-width: 3px;
border-right-width: 3px;
border-bottom-width: 3px;
border-left-width: 3px;
}
#htmlui-root .side-style {
border-bottom-width: 3px;
}
body#htmlui-root {
--c: #ff0000ff;
}
