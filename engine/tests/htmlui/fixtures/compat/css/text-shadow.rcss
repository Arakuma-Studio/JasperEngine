#htmlui-root .blur0 {
font-effect: shadow(1px 1px #000000ff);
}
#htmlui-root .blur {
font-effect: glow(0px 5px 0px 0px #00ffffcc);
}
#htmlui-root .multiple {
font-effect: glow(0px 2.5px 0px 0px #ffffffff), glow(0px 5px 0px 0px #00ffffff), shadow(2px 2px #000000ff);
}
#htmlui-root .no-color {
font-effect: glow(0px 2px 2px 2px #ffffffff);
}
#htmlui-root .static-color {
color: #ffff00ff;
--html-current-color: #ffff00ff;
font-effect: glow(0px 3px 0px 0px #ffff00ff);
}
#htmlui-root .color-first {
font-effect: glow(0px 1px 1px 1px #ff0000ff);
}
#htmlui-root .none {
font-effect: none;
}
#htmlui-root .em {
font-effect: glow(0px 0.1em 0.1em 0.1em #000000ff);
}
#htmlui-root .var {
font-effect: var(--glow);
}
body#htmlui-root {
--glow: glow(0px 4px 0px 0px #ff00ffff);
}
