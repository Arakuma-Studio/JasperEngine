#htmlui-root div {
width: 1px;
}
#htmlui-root *, body#htmlui-root {
width: 2px;
}
#htmlui-root .cls {
width: 3px;
}
#htmlui-root #id {
width: 4px;
}
#htmlui-root [data-x] {
width: 5px;
}
#htmlui-root [data-x="a b"] {
width: 6px;
}
#htmlui-root [lang~="en"] {
width: 7px;
}
#htmlui-root [lang|="en"] {
width: 8px;
}
#htmlui-root [href^="http"] {
width: 9px;
}
#htmlui-root [href$=".png"] {
width: 10px;
}
#htmlui-root [href*="game"] {
width: 11px;
}
#htmlui-root [type="CHECKBOX"] {
width: 12px;
}
#htmlui-root [type="a"] {
width: 13px;
}
#htmlui-root ul li {
width: 14px;
}
#htmlui-root ul > li {
width: 15px;
}
#htmlui-root h1 + p {
width: 16px;
}
#htmlui-root h1 ~ p {
width: 17px;
}
#htmlui-root a, #htmlui-root b, #htmlui-root c {
width: 20px;
}
#htmlui-root a:hover {
width: 21px;
}
#htmlui-root a:active {
width: 22px;
}
#htmlui-root input:checked {
width: 23px;
}
#htmlui-root button:disabled {
width: 24px;
}
#htmlui-root input:placeholder-shown {
width: 25px;
}
#htmlui-root a:html-focus {
width: 26px;
}
#htmlui-root a:html-focus-visible {
width: 27px;
}
#htmlui-root nav:focus {
width: 28px;
}
#htmlui-root input:not(:disabled) {
width: 29px;
}
#htmlui-root a[href] {
width: 30px;
}
#htmlui-root a[href] {
width: 31px;
}
#htmlui-root input[required] {
width: 33px;
}
#htmlui-root input:not([required]) {
width: 34px;
}
#htmlui-root input[readonly] {
width: 35px;
}
#htmlui-root input:not([readonly]) {
width: 36px;
}
body#htmlui-root {
width: 37px;
}
#htmlui-root :scope, body#htmlui-root:scope {
width: 38px;
}
#htmlui-root li:first-child {
width: 39px;
}
#htmlui-root li:last-child {
width: 40px;
}
#htmlui-root li:only-child {
width: 41px;
}
#htmlui-root li:nth-child(2n+1) {
width: 42px;
}
#htmlui-root li:nth-last-child(2) {
width: 43px;
}
#htmlui-root p:first-of-type {
width: 44px;
}
#htmlui-root p:last-of-type {
width: 45px;
}
#htmlui-root p:only-of-type {
width: 46px;
}
#htmlui-root p:nth-of-type(odd) {
width: 47px;
}
#htmlui-root p:nth-last-of-type(even) {
width: 48px;
}
#htmlui-root div:empty {
width: 49px;
}
#htmlui-root p:not(.x) {
width: 50px;
}
#htmlui-root p:not(.a, .b) {
width: 51px;
}
#htmlui-root li:not(:first-child) {
width: 52px;
}
#htmlui-root :not(div > p), body#htmlui-root:not(div > p) {
width: 53px;
}
#htmlui-root h1 span, #htmlui-root h2 span {
width: 55px;
}
#htmlui-root .a, #htmlui-root .b {
width: 56px;
}
#htmlui-root .a, #htmlui-root .b {
width: 57px;
}
#htmlui-root .c, #htmlui-root .d {
width: 58px;
}
#htmlui-root [lang|="en"] {
width: 60px;
}
#htmlui-root my-element {
