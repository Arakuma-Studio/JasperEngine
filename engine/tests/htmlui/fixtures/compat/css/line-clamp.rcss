#htmlui-root .clamp {
display: block;
flex-direction: column;
max-height: 4.5em;
overflow: hidden;
line-height: 1.5;
}
#htmlui-root .clamp-px {
display: block;
max-height: 40px;
overflow: hidden;
line-height: 20px;
}
#htmlui-root .clamp-no-lh {
max-height: 4.8em;
overflow: hidden;
}
#htmlui-root .base {
line-height: 1.25;
}
#htmlui-root .base.short {
max-height: 2.4em;
overflow: hidden;
}
#htmlui-root .standard {
max-height: 1.2em;
overflow: hidden;
}
