#htmlui-root .inline {
border-right-width: 1px;
border-right-style: solid;
border-right-color: #ff0000ff;
border-left-width: 2px;
}
#htmlui-root .margin {
margin-right: 10px;
padding-right: 1px;
padding-left: 2px;
}
#htmlui-root .radius {
border-top-right-radius: 4px;
}
#htmlui-root .text {
text-align: start;
}
