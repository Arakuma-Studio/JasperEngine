#htmlui-root .pc {
align-content: center;
justify-content: center;
}
#htmlui-root .pc2 {
align-content: space-between;
justify-content: flex-start;
}
#htmlui-root .pi {
align-items: center;
}
#htmlui-root .pi2 {
align-items: flex-start;
}
#htmlui-root .ps {
align-self: flex-end;
}
#htmlui-root .ps2 {
align-self: center;
}
#htmlui-root .safe {
align-content: center;
justify-content: center;
}
