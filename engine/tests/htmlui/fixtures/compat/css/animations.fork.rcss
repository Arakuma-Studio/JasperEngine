#htmlui-root .all-parts {
animation: 2s ease-in-out 0.5s infinite alternate both paused pulse;
}
#htmlui-root .ms {
animation: 0.3s ease 0s 1 normal none running fade;
}
#htmlui-root .reverse {
animation: 1s ease 0s 1 reverse none running slide;
}
#htmlui-root .alt-reverse {
animation: 1s ease 0s infinite alternate-reverse none running slide;
}
#htmlui-root .forwards {
animation: 0.5s ease 0.2s 1 normal forwards running fade;
}
#htmlui-root .backwards {
animation: 1s ease 1s 1 normal backwards running fade;
}
#htmlui-root .both-nodelay {
animation: 1s ease 0s 1 normal both running fade;
}
#htmlui-root .fraction {
animation: 1s ease 0s 2.6 normal none running fade;
}
#htmlui-root .zero-count {
animation: 1s ease 0s 0 normal none running fade;
}
#htmlui-root .zero-duration {
animation: 0s ease 0s 1 normal none running fade;
}
#htmlui-root .none {
animation: 0s ease 0s 1 normal none running none;
}
#htmlui-root .list {
animation: 1s ease 0s 1 normal none running fade, 2s linear 0s infinite normal none running pulse;
}
#htmlui-root .longhands {
animation-name: pulse;
animation-duration: 1.5s;
animation-iteration-count: infinite;
animation-timing-function: steps(3);
animation-direction: alternate;
animation-play-state: paused;
}
#htmlui-root .item {
animation: 0.4s ease-out 0s 1 normal both running fade;
}
#htmlui-root .item:nth-child(2) {
animation-delay: 0.1s;
}
#htmlui-root .item:nth-child(3) {
animation-delay: 0.2s;
}
#htmlui-root .lonely {
animation-duration: 3s;
}
#htmlui-root .fill-only {
animation-fill-mode: forwards;
}
#htmlui-root .composition {
animation-composition: add;
}
#htmlui-root .quoted {
animation: 1s ease 0s 1 normal none running kf-fc01caf3;
}
#htmlui-root .bezier {
animation: 1s cubic-bezier(0.17,0.67,0.83,0.67) 0s 1 normal none running pulse;
}
@keyframes fade {
0% {
opacity: 0;
}
100% {
opacity: 1;
}
}
@keyframes pulse {
0%, 100% {
transform: scale(1);
}
50% {
transform: scale(1.1);
}
}
@keyframes slide {
0% {
left: 0;
}
30% {
left: 50px;
}
100% {
left: 100px;
}
}
@keyframes kf-fc01caf3 {
100% {
opacity: 0.5;
}
}
