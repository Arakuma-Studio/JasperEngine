#htmlui-root .all-parts {
animation: 2s 0.5s infinite alternate paused ease-in-out pulse;
-html-animation-fill: forwards;
}
#htmlui-root .ms {
animation: 0.3s fade;
-html-animation-fill: none;
}
#htmlui-root .reverse {
animation: 1s slide-rev;
-html-animation-fill: none;
}
#htmlui-root .alt-reverse {
animation: 1s infinite alternate slide-rev;
-html-animation-fill: none;
}
#htmlui-root .forwards {
animation: 0.5s 0.2s fade;
-html-animation-fill: forwards;
}
#htmlui-root .backwards {
animation: 1s 1s fade;
-html-animation-fill: none;
}
#htmlui-root .both-nodelay {
animation: 1s fade;
-html-animation-fill: forwards;
}
#htmlui-root .fraction {
animation: 1s 3 fade;
-html-animation-fill: none;
}
#htmlui-root .zero-count {
animation: none;
-html-animation-fill: none;
}
#htmlui-root .zero-duration {
animation: none;
-html-animation-fill: none;
}
#htmlui-root .none {
animation: none;
-html-animation-fill: none;
}
#htmlui-root .list {
animation: 1s fade, 2s infinite linear pulse;
-html-animation-fill: none;
}
#htmlui-root .longhands {
animation: 1.5s infinite alternate paused steps(3) pulse;
-html-animation-fill: none;
}
#htmlui-root .item {
animation: 0.4s ease-out fade;
-html-animation-fill: forwards;
}
#htmlui-root .item:nth-child(2) {
animation: 0.4s 0.1s ease-out fade;
-html-animation-fill: forwards;
}
#htmlui-root .item:nth-child(3) {
animation: 0.4s 0.2s ease-out fade;
-html-animation-fill: forwards;
}
#htmlui-root .fill-only {
-html-animation-fill: forwards;
}
#htmlui-root .quoted {
animation: 1s kf-fc01caf3;
-html-animation-fill: none;
}
#htmlui-root .bezier {
animation: 1s cubic-bezier(0.17,0.67,0.83,0.67) pulse;
-html-animation-fill: none;
}
@keyframes fade {
0% {
opacity: 0;
}
100% {
opacity: 1;
}
}
@keyframes pulse {
0%, 100% {
transform: scale(1);
}
50% {
transform: scale(1.1);
}
}
@keyframes slide {
0% {
left: 0;
}
30% {
left: 50px;
}
100% {
left: 100px;
}
}
@keyframes slide-rev {
100% {
left: 0;
}
70% {
left: 50px;
}
0% {
left: 100px;
}
}
@keyframes kf-fc01caf3 {
100% {
opacity: 0.5;
}
}
