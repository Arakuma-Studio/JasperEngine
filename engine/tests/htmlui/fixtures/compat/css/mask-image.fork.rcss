#htmlui-root .fade {
mask-image: linear-gradient(to bottom, #000000ff 60%, #00000000);
}
#htmlui-root .webkit {
mask-image: radial-gradient(circle, #000000ff 50%, #00000000 51%);
}
#htmlui-root .url {
mask-image: url("asset://compat/css/img/a.png");
mask-position-x: 50%;
mask-position-y: 50%;
mask-size: contain;
mask-repeat: no-repeat no-repeat;
}
#htmlui-root .longhands {
mask-image: url("asset://compat/css/img/a.png");
mask-size: 32px auto;
mask-position-x: 50%;
mask-position-y: 50%;
mask-repeat: no-repeat no-repeat;
}
#htmlui-root .wk-longhands {
mask-image: url("asset://compat/css/img/b.png");
mask-size: cover;
}
#htmlui-root .none {
mask-image: none;
}
#htmlui-root .with-clip {
mask-image: html-shape("circle(50%)");
}
#htmlui-root .mm {
mask-image: url("asset://compat/css/img/a.png");
}
