#htmlui-root .box {
color: #ff0000ff;
--html-current-color: #ff0000ff;
}
@media (orientation: landscape) {
#htmlui-root .box {
width: 50vh;
height: 50vh;
}
}
@media (orientation: portrait) {
#htmlui-root .box {
width: 50vw;
height: 50vw;
}
}
@media (orientation: landscape) {
#htmlui-root .wide {
font-size: 5vw;
padding: 2vh 4vw;
}
}
@media (orientation: portrait) {
#htmlui-root .wide {
font-size: 5vh;
padding: 2vw 4vh;
}
}
@media (min-width: 600px) and (orientation: landscape) {
#htmlui-root .box {
border-radius: 10vh;
}
}
@media (min-width: 600px) and (orientation: portrait) {
#htmlui-root .box {
border-radius: 10vw;
}
}
@keyframes grow {
0% {
width: 72px;
}
100% {
width: 256px;
}
}
#htmlui-root .v {
width: var(--size);
}
@media (orientation: landscape) {
#htmlui-root .v {
--size: 8vh;
}
}
@media (orientation: portrait) {
#htmlui-root .v {
--size: 8vw;
}
}
