body#htmlui-root {
--accent: #00000080;
--bg: linear-gradient(135deg, #1e1e2eff, #11111bff);
--shared: linear-gradient(#ff0000ff, #0000ffff);
--shadow: 0 0 8px #00ffffff;
--theme-color: #333333ff;
--theme-color--native-layers: #333333ff;
--space: 1.5rem;
--dur: 0.2s;
--str: "hello";
--empty:  ;
--mixed: #ff0000ff;
}
#htmlui-root .dark {
--theme-color: #eeeeeeff;
--theme-color--native-layers: #eeeeeeff;
--mixed: linear-gradient(#ff0000ff, #0000ffff);
}
#htmlui-root .uses {
color: var(--accent);
background: var(--bg);
padding: var(--space);
}
#htmlui-root .typed-1 {
background-image: var(--shared);
}
#htmlui-root .typed-2 {
mask-image: var(--shared);
}
#htmlui-root .shadow-text {
text-shadow: var(--shadow);
}
#htmlui-root .shadow-box {
--html-box-shadow: var(--shadow);
box-shadow: var(--html-outline-shadow, 0 0 0 0 #0000), var(--html-box-shadow, 0 0 0 0 #0000);
}
#htmlui-root .theme {
background: var(--theme-color--native-layers);
border-top-width: 1px;
border-top-style: solid;
border-top-color: var(--theme-color);
border-right-width: 1px;
border-right-style: solid;
border-right-color: var(--theme-color);
border-bottom-width: 1px;
border-bottom-style: solid;
border-bottom-color: var(--theme-color);
border-left-width: 1px;
border-left-style: solid;
border-left-color: var(--theme-color);
border-image: none;
}
#htmlui-root .mixed {
background: var(--mixed);
}
#htmlui-root .undeclared {
background: var(--from-lua);
text-shadow: var(--nope);
}
#htmlui-root .fallback {
background: var(--missing, linear-gradient(#000000ff, #ffffffff));
color: var(--missing2, #ff0000ff);
}
#htmlui-root .chain {
--a: var(--accent);
color: var(--a);
}
#htmlui-root .case {
--CamelCase: 1px;
width: var(--CamelCase);
}
#htmlui-root .reserved {
--html-current-color: #ff0000ff;
}
