#htmlui-root .a {
font-style: normal;
font-weight: normal;
font-size: 16px;
line-height: normal;
font-family: Arial, sans-serif;
}
#htmlui-root .b {
font-style: italic;
font-weight: bold;
font-size: 12px;
line-height: 30px;
font-family: Georgia, serif;
}
#htmlui-root .c {
font-style: normal;
font-weight: 700;
font-size: 2rem;
line-height: 1.2;
font-family: Press Start 2P, cursive;
}
#htmlui-root .d {
font-style: normal;
font-weight: normal;
font-size: 14px;
line-height: normal;
font-family: Inter;
}
#htmlui-root .e {
font-style: italic;
font-weight: 300;
font-size: 18px;
line-height: normal;
font-family: system-ui;
}
#htmlui-root .f {
font-style: normal;
font-weight: 400;
font-size: 13.333px;
line-height: normal;
font-family: system-ui;
}
#htmlui-root .g {
font-style: normal;
font-weight: 400;
font-size: 13.333px;
line-height: normal;
font-family: system-ui;
}
#htmlui-root .i {
font: var(--font);
}
#htmlui-root .j {
font-style: normal;
font-weight: normal;
font-size: 120%;
line-height: 1.5;
font-family: monospace;
}
