#htmlui-root .w1 {
width: min-content;
}
#htmlui-root .w2 {
width: max-content;
}
#htmlui-root .w3 {
width: fit-content;
}
#htmlui-root .w4 {
width: fit-content(200px);
}
#htmlui-root .w5 {
width: stretch;
}
#htmlui-root .w6 {
width: -webkit-fill-available;
}
#htmlui-root .h1 {
height: -webkit-fill-available;
}
#htmlui-root .h2 {
height: max-content;
}
#htmlui-root .min1 {
min-width: auto;
}
#htmlui-root .min2 {
min-height: auto;
}
#htmlui-root .min3 {
min-width: min-content;
}
#htmlui-root .min4 {
min-height: -webkit-fill-available;
}
#htmlui-root .max1 {
max-width: max-content;
}
#htmlui-root .max2 {
max-height: none;
}
#htmlui-root .max3 {
max-width: 100%;
}
#htmlui-root .zero {
width: 0px;
height: 0px;
}
#htmlui-root .auto {
width: auto;
}
