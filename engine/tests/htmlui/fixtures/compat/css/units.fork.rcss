#htmlui-root .native {
width: 10px;
height: 2em;
margin: 1rem 50% 10vw 10vh;
padding: 1in 1cm 1mm 1pt;
border-width: 1pc;
left: 2dp;
}
#htmlui-root .q {
width: 10mm;
}
#htmlui-root .viewport-variants {
height: 100dvh;
min-height: 100svh;
max-height: 100lvh;
width: 50dvw;
min-width: 10svw;
max-width: 90lvw;
top: 10vw;
bottom: 5vh;
}
#htmlui-root .font-relative {
width: 20ch;
height: 3ex;
margin-top: 1.4em;
margin-bottom: 1em;
padding-top: 2.4em;
padding-bottom: 1.2rem;
}
#htmlui-root .angles {
transform: rotate(45deg) rotate(1rad) rotate(100grad) rotate(0.5turn);
}
#htmlui-root .times {
transition: opacity 1s, color 0.5s;
}
#htmlui-root .zero {
margin: 0;
border-width: 0px;
}
