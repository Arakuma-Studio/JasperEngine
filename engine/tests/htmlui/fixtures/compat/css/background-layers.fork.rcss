#htmlui-root .two {
background-color: transparent;
background-image: url("asset://compat/css/img/a.png"), linear-gradient(#000000ff, #ffffffff);
background-position-x: 50%, 0%;
background-position-y: 50%, 0%;
background-size: auto auto, auto auto;
background-repeat: no-repeat no-repeat, repeat repeat;
background-origin: padding-box, padding-box;
background-clip: border-box, border-box;
background-attachment: scroll, scroll;
}
#htmlui-root .three {
background-color: #222222ff;
background-image: radial-gradient(circle, #ffffffff 0%, #00000000 70%), url("asset://compat/css/img/b.png"), none;
background-position-x: 0%, 0%, 0%;
background-position-y: 0%, 0%, 0%;
background-size: auto auto, auto auto, auto auto;
background-repeat: repeat repeat, repeat repeat, repeat repeat;
background-origin: padding-box, padding-box, padding-box;
background-clip: border-box, border-box, border-box;
background-attachment: scroll, scroll, scroll;
}
#htmlui-root .image-list {
background-image: url("asset://compat/css/img/a.png"), url("asset://compat/css/img/b.png");
background-repeat: no-repeat no-repeat, repeat no-repeat;
background-position-x: 50%, 0px;
background-position-y: 50%, 0px;
}
#htmlui-root .color-then-image {
background-color: #000080ff;
background-image: linear-gradient(to right, #ff0000ff, #0000ffff);
}
#htmlui-root .none-layers {
background-image: none, url("asset://compat/css/img/a.png");
}
