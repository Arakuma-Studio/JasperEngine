#htmlui-root .sub {
display: grid;
}
#htmlui-root .calc {
display: grid;
grid-template-columns: calc(50% - 10px) minmax(calc(2em + 4px), 1fr);
gap: calc(1em + 2px);
}
#htmlui-root .areas {
display: inline-grid;
grid-template: "a a" 40px "b c" 1fr / 1fr 2fr;
justify-items: center;
}
#htmlui-root .item {
grid-area: b;
justify-self: end;
grid-column: span 2 / -1;
}
#htmlui-root .legacy {
gap: 4px 8px;
row-gap: 2px;
column-gap: 3px;
}
