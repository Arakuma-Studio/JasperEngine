#htmlui-root .fixed {
display: grid;
grid-template-columns: repeat(6, 64px);
gap: 8px;
}
#htmlui-root .fr {
display: grid;
grid-template-columns: repeat(3, 1fr);
}
#htmlui-root .auto-fill {
display: grid;
grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
gap: 1rem;
}
#htmlui-root .auto-fit {
display: grid;
grid-template-columns: repeat(auto-fit, minmax(10em, 1fr));
}
#htmlui-root .explicit {
display: grid;
grid-template-columns: 200px 1fr 2fr;
}
#htmlui-root .uniform-list {
display: grid;
grid-template-columns: 1fr 1fr 1fr 1fr;
}
#htmlui-root .shorthand {
display: grid;
grid-template: auto / repeat(2, 1fr);
}
#htmlui-root .grid-short {
display: grid;
grid: auto-flow / 1fr 1fr;
}
#htmlui-root .items {
grid-column: 1 / 3;
grid-row: span 2;
grid-area: header;
}
#htmlui-root .rows {
grid-template-rows: 100px auto;
grid-auto-flow: dense;
grid-auto-rows: 50px;
grid-template-areas: "a b";
}
#htmlui-root .gaps {
gap: 10px 20px;
row-gap: 4px;
column-gap: 8px;
}
#htmlui-root .justify {
justify-items: center;
justify-self: end;
}
#htmlui-root .complex {
display: grid;
grid-template-columns: [full-start] minmax(1rem, 1fr) [content-start] 60ch [content-end] minmax(1rem, 1fr) [full-end];
}
