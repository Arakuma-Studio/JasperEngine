#htmlui-root .a {
display: flex;
}
#htmlui-root .b {
display: flex;
flex-wrap: wrap;
}
#htmlui-root .e {
color: #ff0000ff;
--html-current-color: #ff0000ff;
}
#htmlui-root .f {
backdrop-filter: blur(4px);
}
#htmlui-root .g {
color: #0000ffff;
--html-current-color: #0000ffff;
}
#htmlui-root .i {
color: #ffc0cbff;
--html-current-color: #ffc0cbff;
}
#htmlui-root .m {
position: relative;
}
#htmlui-root .o {
gap: 1px;
}
#htmlui-root .p {
color: #008080ff;
--html-current-color: #008080ff;
}
