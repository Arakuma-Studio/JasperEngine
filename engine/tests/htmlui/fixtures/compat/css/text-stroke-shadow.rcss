#htmlui-root .title {
--html-text-stroke: outline(1px #000000ff);
--html-text-shadow: glow(0px 2px 0px 2px #00000088);
font-effect: var(--html-text-stroke, shadow(0px 0px #0000)), var(--html-text-shadow, shadow(0px 0px #0000));
}
#htmlui-root .glow {
--html-text-shadow: glow(0px 5px 0px 0px #ffd700ff);
font-effect: var(--html-text-stroke, shadow(0px 0px #0000)), var(--html-text-shadow, shadow(0px 0px #0000));
}
#htmlui-root .outline {
--html-text-stroke: outline(2px #ffffffff);
font-effect: var(--html-text-stroke, shadow(0px 0px #0000)), var(--html-text-shadow, shadow(0px 0px #0000));
}
#htmlui-root .none {
--html-text-shadow: shadow(0px 0px #0000);
font-effect: var(--html-text-stroke, shadow(0px 0px #0000)), var(--html-text-shadow, shadow(0px 0px #0000));
}
