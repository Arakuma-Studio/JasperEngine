}
#htmlui-root .layered {
color: #808080ff;
--html-current-color: #808080ff;
}
#htmlui-root .from-base {
color: #ff0000ff;
--html-current-color: #ff0000ff;
}
@media (min-width: 600px) {
#htmlui-root .media-only {
color: #800080ff;
--html-current-color: #800080ff;
}
}
#htmlui-root .from-base {
color: #ff0000ff;
