#htmlui-root .len {
border-radius: 8px;
}
#htmlui-root .four {
border-radius: 1px 2px 3px 4px;
}
#htmlui-root .circle {
border-top-left-radius: 9999px;
border-top-right-radius: 9999px;
border-bottom-right-radius: 9999px;
border-bottom-left-radius: 9999px;
}
#htmlui-root .pill {
border-top-left-radius: 9999px;
border-top-right-radius: 9999px;
border-bottom-right-radius: 9999px;
border-bottom-left-radius: 9999px;
}
#htmlui-root .mixed {
border-top-left-radius: 8px;
border-top-right-radius: 9999px;
border-bottom-left-radius: 0px;
}
#htmlui-root .corner {
border-top-left-radius: 9999px;
}
#htmlui-root .elliptical {
border-radius: 10px;
}
#htmlui-root .elliptical-equal {
border-radius: 8px;
}
#htmlui-root .zero {
border-radius: 0px;
}
#htmlui-root .em {
border-radius: 0.5em;
}
#htmlui-root .var {
border-radius: var(--r);
}
body#htmlui-root {
--r: 12px;
}
