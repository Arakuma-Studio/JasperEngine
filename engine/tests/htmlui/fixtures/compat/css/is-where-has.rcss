#htmlui-root h1, #htmlui-root h2, #htmlui-root h3 {
margin: 0;
}
#htmlui-root article p a, #htmlui-root article li a {
color: #ff0000ff;
--html-current-color: #ff0000ff;
}
#htmlui-root ul ul, #htmlui-root ul ol, #htmlui-root ol ul, #htmlui-root ol ol {
margin: 0;
}
#htmlui-root .card.active, #htmlui-root .card:hover {
color: #0000ffff;
--html-current-color: #0000ffff;
}
#htmlui-root .a .b .d, #htmlui-root .c .d {
color: #008000ff;
--html-current-color: #008000ff;
}
#htmlui-root .x {
color: #ffc0cbff;
--html-current-color: #ffc0cbff;
}
#htmlui-root .z {
color: #808080ff;
--html-current-color: #808080ff;
}
