#htmlui-root .clamp {
display: -webkit-box;
flex-direction: column;
-webkit-box-orient: vertical;
-webkit-line-clamp: 3;
overflow: hidden;
line-height: 1.5;
}
#htmlui-root .clamp-px {
display: -webkit-box;
-webkit-line-clamp: 2;
line-height: 20px;
}
#htmlui-root .clamp-no-lh {
-webkit-line-clamp: 4;
}
#htmlui-root .base {
line-height: 1.25;
}
#htmlui-root .base.short {
-webkit-line-clamp: 2;
}
#htmlui-root .none {
-webkit-line-clamp: none;
}
