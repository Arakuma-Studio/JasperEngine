#htmlui-root .same-rule {
decorator: html-layer("asset://compat/css/img/a.png" 16px auto 100% 50% no-repeat no-repeat padding-box border-box scroll);
}
#htmlui-root .sprite {
background-color: transparent;
decorator: html-layer("asset://compat/css/img/a.png" auto auto 0px 0px no-repeat no-repeat padding-box border-box scroll);
}
#htmlui-root .sprite:hover {
background-color: transparent;
decorator: html-layer("asset://compat/css/img/a.png" auto auto -32px 0px no-repeat no-repeat padding-box border-box scroll);
}
#htmlui-root .origin {
decorator: html-layer("asset://compat/css/img/a.png" auto auto 0% 0% repeat repeat content-box padding-box fixed);
}
#htmlui-root .axis {
decorator: html-layer("asset://compat/css/img/a.png" auto auto 100% 25% repeat repeat padding-box border-box scroll);
}
#htmlui-root .color {
background-color: #00000040;
}
