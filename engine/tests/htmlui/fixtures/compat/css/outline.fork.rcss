#htmlui-root .solid {
outline: 2px solid #ff0000ff;
}
#htmlui-root .offset {
outline: 2px solid #ff0000ff;
outline-offset: 3px;
}
#htmlui-root .negative {
outline: 2px solid #0000ffff;
outline-offset: -4px;
}
#htmlui-root .none {
outline: none;
}
#htmlui-root .zero {
outline: 0px;
}
#htmlui-root .style-none {
outline-style: none;
}
#htmlui-root .dashed {
outline: 1px dashed #008000ff;
}
#htmlui-root .auto {
outline: auto;
}
#htmlui-root .invert {
outline: 1px solid invert;
}
#htmlui-root .no-color {
outline: 3px solid;
}
#htmlui-root .longhands {
outline-width: 4px;
outline-style: solid;
outline-color: #00ff00ff;
}
#htmlui-root .with-shadow {
--html-box-shadow: 0px 2px 4px #000000ff;
box-shadow: var(--html-outline-shadow, 0 0 0 0 #0000), var(--html-box-shadow, 0 0 0 0 #0000);
outline: 1px solid #ffffffff;
}
#htmlui-root .shadow-elsewhere {
--html-box-shadow: 0px 0px 8px #00000080;
box-shadow: var(--html-outline-shadow, 0 0 0 0 #0000), var(--html-box-shadow, 0 0 0 0 #0000);
}
#htmlui-root .shadow-elsewhere:focus {
outline: 2px solid #ffa500ff;
}
#htmlui-root .em-offset {
outline: 2px solid #ff0000ff;
outline-offset: 0.5em;
}
#htmlui-root .transition {
transition: outline-color 0.2s, outline-offset 0.2s;
}
