#htmlui-root .solid {
--html-outline-shadow: 0 0 0 2px #ff0000ff;
box-shadow: var(--html-outline-shadow, 0 0 0 0 #0000), var(--html-box-shadow, 0 0 0 0 #0000);
}
#htmlui-root .offset {
--html-outline-shadow: 0 0 0 5px #ff0000ff;
box-shadow: var(--html-outline-shadow, 0 0 0 0 #0000), var(--html-box-shadow, 0 0 0 0 #0000);
}
#htmlui-root .negative {
--html-outline-shadow: inset 0 0 0 2px #0000ffff;
box-shadow: var(--html-outline-shadow, 0 0 0 0 #0000), var(--html-box-shadow, 0 0 0 0 #0000);
}
#htmlui-root .none {
--html-outline-shadow: 0 0 0 0 #0000;
box-shadow: var(--html-outline-shadow, 0 0 0 0 #0000), var(--html-box-shadow, 0 0 0 0 #0000);
}
#htmlui-root .zero {
--html-outline-shadow: 0 0 0 0 #0000;
box-shadow: var(--html-outline-shadow, 0 0 0 0 #0000), var(--html-box-shadow, 0 0 0 0 #0000);
}
#htmlui-root .style-none {
--html-outline-shadow: 0 0 0 0 #0000;
box-shadow: var(--html-outline-shadow, 0 0 0 0 #0000), var(--html-box-shadow, 0 0 0 0 #0000);
}
#htmlui-root .dashed {
--html-outline-shadow: 0 0 0 1px #008000ff;
box-shadow: var(--html-outline-shadow, 0 0 0 0 #0000), var(--html-box-shadow, 0 0 0 0 #0000);
}
#htmlui-root .auto {
--html-outline-shadow: 0 0 0 1px #ffffffff, 0 0 0 3px #101010ff;
box-shadow: var(--html-outline-shadow, 0 0 0 0 #0000), var(--html-box-shadow, 0 0 0 0 #0000);
}
#htmlui-root .invert {
--html-outline-shadow: 0 0 0 1px #000000ff;
box-shadow: var(--html-outline-shadow, 0 0 0 0 #0000), var(--html-box-shadow, 0 0 0 0 #0000);
}
#htmlui-root .no-color {
--html-outline-shadow: 0 0 0 3px var(--html-current-color, #000000ff);
box-shadow: var(--html-outline-shadow, 0 0 0 0 #0000), var(--html-box-shadow, 0 0 0 0 #0000);
}
#htmlui-root .longhands {
--html-outline-shadow: 0 0 0 4px #00ff00ff;
box-shadow: var(--html-outline-shadow, 0 0 0 0 #0000), var(--html-box-shadow, 0 0 0 0 #0000);
}
#htmlui-root .with-shadow {
--html-box-shadow: 0px 2px 4px #000000ff;
--html-outline-shadow: 0 0 0 1px #ffffffff;
box-shadow: var(--html-outline-shadow, 0 0 0 0 #0000), var(--html-box-shadow, 0 0 0 0 #0000);
}
#htmlui-root .shadow-elsewhere {
--html-box-shadow: 0px 0px 8px #00000080;
box-shadow: var(--html-outline-shadow, 0 0 0 0 #0000), var(--html-box-shadow, 0 0 0 0 #0000);
}
#htmlui-root .shadow-elsewhere:focus {
--html-outline-shadow: 0 0 0 2px #ffa500ff;
box-shadow: var(--html-outline-shadow, 0 0 0 0 #0000), var(--html-box-shadow, 0 0 0 0 #0000);
}
#htmlui-root .em-offset {
--html-outline-shadow: 0 0 0 2px #ff0000ff;
box-shadow: var(--html-outline-shadow, 0 0 0 0 #0000), var(--html-box-shadow, 0 0 0 0 #0000);
}
#htmlui-root .transition {
transition: box-shadow 0.2s, box-shadow 0.2s;
}
