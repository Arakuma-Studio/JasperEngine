#htmlui-root .unsupported {
animation-composition: replace;
aspect-ratio: auto;
order: 0;
counter-increment: none;
counter-reset: none;
counter-set: none;
quotes: auto;
text-decoration-color: currentcolor;
text-decoration-style: solid;
text-decoration-thickness: auto;
text-underline-offset: auto;
word-spacing: normal;
}
