#htmlui-root .a {
font-effect: outline(2px #000000ff);
}
#htmlui-root .b {
font-effect: outline(1px #ff0000ff);
color: #ff0000ff;
--html-current-color: #ff0000ff;
}
#htmlui-root .c {
font-effect: outline(3px #0000ffff);
}
#htmlui-root .d {
font-effect: outline(1px #008000ff);
}
#htmlui-root .e {
font-effect: outline(1px #ff0000ff);
}
#htmlui-root .none {
font-effect: none;
}
