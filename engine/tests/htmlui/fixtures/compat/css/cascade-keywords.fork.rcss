#htmlui-root .inherited {
color: inherit;
font-family: unset;
line-height: inherit;
font-size: inherit;
}
#htmlui-root .inherited-initial {
color: initial;
font-size: initial;
line-height: initial;
text-align: initial;
}
#htmlui-root .non-inherited {
margin-top: unset;
margin-right: unset;
margin-bottom: unset;
margin-left: unset;
padding-left: initial;
width: inherit;
display: initial;
}
#htmlui-root .differs {
border-right-color: initial;
border-bottom-color: initial;
border-left-color: initial;
border-top-color: unset;
min-width: unset;
}
#htmlui-root .revert {
color: revert;
opacity: revert-layer;
}
#htmlui-root .shorthand {
background-color: inherit;
background-image: inherit;
background-position-x: inherit;
background-position-y: inherit;
background-size: inherit;
background-repeat: inherit;
background-origin: inherit;
background-clip: inherit;
background-attachment: inherit;
border-top-width: initial;
border-right-width: initial;
border-bottom-width: initial;
border-left-width: initial;
border-top-style: initial;
border-right-style: initial;
border-bottom-style: initial;
border-left-style: initial;
border-top-color: initial;
border-right-color: initial;
border-bottom-color: initial;
border-left-color: initial;
font-style: inherit;
font-weight: inherit;
font-size: inherit;
line-height: inherit;
font-family: inherit;
}
#htmlui-root .parent {
width: 300px;
}
#htmlui-root .reset {
all: unset;
}
#htmlui-root .reset-initial {
all: initial;
}
#htmlui-root .reset-inherit {
all: inherit;
}
@keyframes spin {
100% {
transform: rotate(360deg);
}
}
#htmlui-root .ak {
animation: inherit;
}
