#htmlui-root .inherited {
color: inherit;
font-family: unset;
line-height: inherit;
font-size: inherit;
}
#htmlui-root .inherited-initial {
color: initial;
font-size: initial;
line-height: initial;
text-align: initial;
}
#htmlui-root .non-inherited {
margin-top: unset;
margin-right: unset;
margin-bottom: unset;
margin-left: unset;
padding-left: initial;
width: inherit;
display: initial;
}
#htmlui-root .differs {
border-right-color: initial;
border-bottom-color: initial;
border-left-color: initial;
border-top-color: unset;
min-width: unset;
}
#htmlui-root .revert {
color: revert;
opacity: revert-layer;
}
#htmlui-root .shorthand {
background-color: inherit;
decorator: inherit;
border-top-width: initial;
border-right-width: initial;
border-bottom-width: initial;
border-left-width: initial;
border-top-color: initial;
border-right-color: initial;
border-bottom-color: initial;
border-left-color: initial;
font-style: inherit;
font-weight: inherit;
font-size: inherit;
line-height: inherit;
font-family: inherit;
}
#htmlui-root .parent {
width: 300px;
}
