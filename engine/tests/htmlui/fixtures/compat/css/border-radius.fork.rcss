#htmlui-root .len {
border-radius: 8px;
}
#htmlui-root .four {
border-radius: 1px 2px 3px 4px;
}
#htmlui-root .circle {
border-radius: 50%;
}
#htmlui-root .pill {
border-radius: 100%;
}
#htmlui-root .ten {
border-radius: 10%;
}
#htmlui-root .mixed {
border-radius: 8px 50% 10% 0px;
}
#htmlui-root .corner {
border-top-left-radius: 50%;
border-bottom-right-radius: 25%;
}
#htmlui-root .elliptical {
border-radius: 10px;
}
#htmlui-root .elliptical-equal {
border-radius: 8px;
}
#htmlui-root .zero {
border-radius: 0px;
}
#htmlui-root .em {
border-radius: 0.5em;
}
#htmlui-root .var {
border-radius: var(--r);
}
body#htmlui-root:root {
--r: 12px;
}
