#htmlui-root .t {
transform: translate(-50%, -50%) rotate(45deg) scale(1.5);
transform-origin: left top;
}
#htmlui-root .p {
perspective: 800px;
perspective-origin: 50% 0;
}
#htmlui-root .individual {
translate: 10px 20px;
rotate: 45deg;
scale: 1.2;
}
#htmlui-root .with-transform {
transform: skewX(10deg);
translate: 0 -2px;
}
#htmlui-root .transform-after {
scale: 2;
transform: rotate(10deg);
}
#htmlui-root .axis {
rotate: x 90deg;
scale: 1 2 3;
translate: 1px 2px 3px;
}
#htmlui-root .vector {
rotate: 1 1 0 45deg;
}
#htmlui-root .percent-scale {
scale: 50% 150%;
}
#htmlui-root .none {
translate: none;
rotate: none;
scale: none;
}
#htmlui-root .base {
transform: translateY(0);
}
#htmlui-root .base:hover {
translate: 0 -4px;
}
#htmlui-root .three-d {
transform: translate3d(0, 0, 10px) rotateX(10deg) matrix(1, 0, 0, 1, 0, 0);
}
