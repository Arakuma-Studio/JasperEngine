#htmlui-root .fixed {
display: flex;
flex-wrap: wrap;
gap: 8px;
}
#htmlui-root .fixed > * {
flex: 0 0 64px;
}
#htmlui-root .fr {
display: flex;
flex-wrap: wrap;
}
#htmlui-root .fr > * {
flex: 1 1 25.1%;
}
#htmlui-root .auto-fill {
display: flex;
flex-wrap: wrap;
gap: 1rem;
}
#htmlui-root .auto-fill > * {
flex: 1 1 200px;
}
#htmlui-root .auto-fit {
display: flex;
flex-wrap: wrap;
}
#htmlui-root .auto-fit > * {
flex: 1 1 10em;
}
#htmlui-root .explicit {
display: flex;
flex-wrap: wrap;
}
#htmlui-root .explicit > :nth-child(3n+1) {
flex: 0 0 200px;
}
#htmlui-root .explicit > :nth-child(3n+2) {
flex: 1 1 25.1%;
}
#htmlui-root .explicit > :nth-child(3n+3) {
flex: 2 1 50.1%;
}
#htmlui-root .uniform-list {
display: flex;
flex-wrap: wrap;
}
#htmlui-root .uniform-list > * {
flex: 1 1 20.1%;
}
#htmlui-root .shorthand {
display: flex;
flex-wrap: wrap;
}
#htmlui-root .shorthand > * {
flex: 1 1 33.43%;
}
#htmlui-root .grid-short {
display: flex;
flex-wrap: wrap;
}
#htmlui-root .grid-short > * {
flex: 1 1 33.43%;
}
#htmlui-root .gaps {
gap: 10px 20px;
row-gap: 4px;
column-gap: 8px;
}
#htmlui-root .complex {
display: flex;
flex-wrap: wrap;
}
#htmlui-root .complex > :nth-child(3n+1) {
flex: 1 1 37.6%;
}
#htmlui-root .complex > :nth-child(3n+2) {
flex: 0 0 30em;
}
#htmlui-root .complex > :nth-child(3n+3) {
flex: 1 1 37.6%;
}
