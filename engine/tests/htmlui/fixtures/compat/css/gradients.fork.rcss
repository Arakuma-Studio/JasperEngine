#htmlui-root .c2 {
background-color: transparent;
background-image: conic-gradient(from 90deg at 50% 50%, #ff0000ff 0deg, #0000ffff 180deg, #ff0000ff 360deg);
background-position-x: 0%;
background-position-y: 0%;
background-size: auto auto;
background-repeat: repeat repeat;
background-origin: padding-box;
background-clip: border-box;
background-attachment: scroll;
}
#htmlui-root .c3 {
background-color: transparent;
background-image: conic-gradient(from 90deg, #ff0000ff 10%, #0000ffff);
background-position-x: 0%;
background-position-y: 0%;
background-size: auto auto;
background-repeat: repeat repeat;
background-origin: padding-box;
background-clip: border-box;
background-attachment: scroll;
}
#htmlui-root .rep1 {
background-color: transparent;
background-image: repeating-linear-gradient(45deg, #000000ff 0% 10px, #ffffffff 10px 20px);
background-position-x: 0%;
background-position-y: 0%;
background-size: auto auto;
background-repeat: repeat repeat;
background-origin: padding-box;
background-clip: border-box;
background-attachment: scroll;
}
#htmlui-root .rep2 {
background-color: transparent;
background-image: repeating-radial-gradient(circle, #ff0000ff 0%, #ff0000ff 5px, #0000ffff 5px, #0000ffff 10px);
background-position-x: 0%;
background-position-y: 0%;
background-size: auto auto;
background-repeat: repeat repeat;
background-origin: padding-box;
background-clip: border-box;
background-attachment: scroll;
}
#htmlui-root .rep3 {
background-color: transparent;
background-image: repeating-conic-gradient(#000000ff 0% 25%, #ffffffff 0% 50%);
background-position-x: 0%;
background-position-y: 0%;
background-size: auto auto;
background-repeat: repeat repeat;
background-origin: padding-box;
background-clip: border-box;
background-attachment: scroll;
}
#htmlui-root .pattern {
background-color: transparent;
background-image: linear-gradient(90deg, #ff0000ff 1px, #00000000 1px);
background-position-x: 0px;
background-position-y: 0px;
background-size: 20px 20px;
background-repeat: repeat repeat;
background-origin: padding-box;
background-clip: border-box;
background-attachment: scroll;
}
#htmlui-root .clip {
background-color: transparent;
background-image: linear-gradient(#ff0000ff, #0000ffff);
background-position-x: 0%;
background-position-y: 0%;
background-size: auto auto;
background-repeat: repeat repeat;
background-origin: padding-box;
background-clip: padding-box;
background-attachment: scroll;
}
