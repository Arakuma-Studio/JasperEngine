#htmlui-root .btn {
padding: 4px;
}
#htmlui-root #menu .btn {
color: #0000ffff;
--html-current-color: #0000ffff;
}
#htmlui-root htmlbody .btn {
color: #008000ff;
--html-current-color: #008000ff;
}
/* important */
#htmlui-root .btn {
color: #ff0000ff;
--html-current-color: #ff0000ff;
}
#htmlui-root .card {
background-color: #222222ff;
}
#htmlui-root .card.active {
margin: 0;
}
@media (min-width: 600px) {
#htmlui-root .wide {
display: none;
}
}
#htmlui-root .btn:hover {
color: #ffa500ff;
--html-current-color: #ffa500ff;
}
