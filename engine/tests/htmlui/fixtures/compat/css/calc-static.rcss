body#htmlui-root {
--gap: 16px;
--cols: 3;
--mixed: 10px;
}
#htmlui-root .same-unit {
width: 30px;
height: 6em;
margin: 100px;
}
#htmlui-root .percent-reduction {
width: 100%;
left: 50%;
}
#htmlui-root .viewport {
font-size: 2.5vw;
height: 656px;
}
#htmlui-root .em-mix {
font-size: 20px;
padding: 24px;
}
#htmlui-root .minmax {
width: 600px;
height: 50vh;
}
#htmlui-root .var-static {
gap: 32px;
flex-basis: 33.333333%;
}
#htmlui-root .math {
height: 20px;
opacity: 0.5;
margin: 3px;
}
#htmlui-root .nested {
width: 25px;
}
#htmlui-root .font-percent {
font-size: 18px;
line-height: 1.5em;
}
#htmlui-root .webkit {
width: 15px;
}
#htmlui-root .var-calc {
--mixed: 12px;
}
