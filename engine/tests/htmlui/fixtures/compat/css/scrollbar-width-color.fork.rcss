#htmlui-root .none > scrollbarvertical {
width: 0px;
}
#htmlui-root .none > scrollbarhorizontal {
height: 0px;
}
#htmlui-root .thin > scrollbarvertical {
width: 8px;
}
#htmlui-root .thin > scrollbarhorizontal {
height: 8px;
}
#htmlui-root .thin > scrollbarvertical > sliderbar {
background-color: #888888ff;
}
#htmlui-root .thin > scrollbarhorizontal > sliderbar {
background-color: #888888ff;
}
#htmlui-root .thin > scrollbarvertical > slidertrack {
background-color: #222222ff;
}
#htmlui-root .thin > scrollbarhorizontal > slidertrack {
background-color: #222222ff;
}
body#htmlui-root > scrollbarvertical {
width: 0px;
}
body#htmlui-root > scrollbarhorizontal {
height: 0px;
}
#htmlui-root .gutter {
scrollbar-gutter: stable;
}
#htmlui-root .panel > scrollbarvertical, #htmlui-root .panel > scrollbarhorizontal {
width: 6px;
}
#htmlui-root .panel > scrollbarvertical > sliderbar, #htmlui-root .panel > scrollbarhorizontal > sliderbar {
background-color: #555555ff;
decorator: none;
border-radius: 3px;
}
#htmlui-root .panel > scrollbarvertical > slidertrack, #htmlui-root .panel > scrollbarhorizontal > slidertrack {
background-color: #00000000;
decorator: none;
}
