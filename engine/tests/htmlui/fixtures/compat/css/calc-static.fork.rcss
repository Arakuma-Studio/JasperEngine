body#htmlui-root:root {
--gap: 16px;
--cols: 3;
--mixed: 10px;
}
#htmlui-root .same-unit {
width: calc(10px + 20px);
height: calc(2em * 3);
margin: calc(1in + 4px);
}
#htmlui-root .percent-reduction {
width: calc(100% - 32px);
left: calc(50% - 10px);
}
#htmlui-root .viewport {
font-size: clamp(1rem, 2.5vw, 2rem);
height: calc(100vh - 64px);
}
#htmlui-root .em-mix {
font-size: 20px;
padding: calc(1em + 4px);
}
#htmlui-root .minmax {
width: min(100%, 600px);
height: max(200px, 50vh);
}
#htmlui-root .var-static {
gap: calc(var(--gap) * 2);
flex-basis: calc(100% / var(--cols));
}
#htmlui-root .var-dynamic {
width: calc(var(--runtime) + 10px);
}
#htmlui-root .math {
height: 20px;
opacity: 0.5;
margin: 3px;
}
#htmlui-root .nested {
width: calc(calc(10px * 2) + min(5px, 8px));
}
#htmlui-root .font-percent {
font-size: calc(100% + 2px);
line-height: calc(1em + 50%);
}
#htmlui-root .webkit {
width: calc(10px + 5px);
}
#htmlui-root .var-calc {
--mixed: 12px;
padding: calc(var(--mixed) + 1px);
}
