#htmlui-root input[type="checkbox"] {
--html-check: none;
--html-check-baseline: 0px;
--html-control-bg: transparent;
--html-control-border: transparent;
--html-control-border-width: 0px;
--html-check-size: auto;
--html-control-radius: 0px;
--html-field-padding: 1px 2px;
--html-field-border-width: 2px;
--html-field-border-style: inset;
--html-check-radius: 0px;
--html-radio-radius: 0px;
--html-check-fill: transparent;
--html-radio-ring: 0 0 0 0 #0000;
--html-control-disabled-border: transparent;
--html-check-disabled-fill: transparent;
--html-select-bg: #efefef;
--html-select-padding: 0px;
--html-select-arrow-width: 0px;
--html-select-arrow: none;
--html-select-arrow-color: transparent;
--html-button-padding: 1px 6px;
--html-button-border-width: 2px;
--html-button-border-style: outset;
--html-button-border: #000000;
--html-button-hover-bg: #efefef;
--html-button-hover-border: #000000;
--html-button-active-bg: #efefef;
--html-button-active-border: #000000;
--html-progress-border-width: 0px;
--html-progress-radius: 0px;
--html-progress-bg: #808080;
--html-progress-track: 0 0 0 0 #0000;
--html-progress-fill-radius: 0px;
--html-progress-fill: #008000;
--html-thumb: none;
--html-slider-fill: transparent;
--html-slider-height: auto;
--html-slider-track-margin: 0px;
--html-slider-track-inset: 0px;
--html-slider-thumb-margin: 0px;
--html-slider-thumb-transform: none;
--html-slider-track-height: auto;
--html-slider-track-border: 0px;
--html-slider-track-bg: transparent;
--html-slider-track-border-color: transparent;
}
#htmlui-root select {
--html-check: none;
--html-check-baseline: 0px;
--html-control-bg: transparent;
--html-control-border: transparent;
--html-control-border-width: 0px;
--html-check-size: auto;
--html-control-radius: 0px;
--html-field-padding: 1px 2px;
--html-field-border-width: 2px;
--html-field-border-style: inset;
--html-check-radius: 0px;
--html-radio-radius: 0px;
--html-check-fill: transparent;
--html-radio-ring: 0 0 0 0 #0000;
--html-control-disabled-border: transparent;
--html-check-disabled-fill: transparent;
--html-select-bg: #efefef;
--html-select-padding: 0px;
--html-select-arrow-width: 0px;
--html-select-arrow: none;
--html-select-arrow-color: transparent;
--html-button-padding: 1px 6px;
--html-button-border-width: 2px;
--html-button-border-style: outset;
--html-button-border: #000000;
--html-button-hover-bg: #efefef;
--html-button-hover-border: #000000;
--html-button-active-bg: #efefef;
--html-button-active-border: #000000;
--html-progress-border-width: 0px;
--html-progress-radius: 0px;
--html-progress-bg: #808080;
--html-progress-track: 0 0 0 0 #0000;
--html-progress-fill-radius: 0px;
--html-progress-fill: #008000;
--html-thumb: none;
--html-slider-fill: transparent;
--html-slider-height: auto;
--html-slider-track-margin: 0px;
--html-slider-track-inset: 0px;
--html-slider-thumb-margin: 0px;
--html-slider-thumb-transform: none;
--html-slider-track-height: auto;
--html-slider-track-border: 0px;
--html-slider-track-bg: transparent;
--html-slider-track-border-color: transparent;
}
#htmlui-root .restore {
--html-check: html-layer("/@htmlui/ua/check.svg" 100% 100% 50% 50% no-repeat no-repeat padding-box border-box scroll);
--html-check-baseline: -3px;
--html-control-bg: #ffffffff;
--html-control-border: #767676ff;
--html-control-border-width: 1px;
--html-field-padding: 2px 3px;
--html-field-border-width: 1px;
--html-field-border-style: solid;
--html-control-radius: 2px;
--html-check-radius: 2px;
--html-radio-radius: 9999px;
--html-check-fill: var(--html-accent, #0075ff);
--html-radio-ring: inset 0 0 0 1.5px var(--html-accent-contrast, #ffffff);
--html-control-disabled-border: #7676764d;
--html-check-disabled-fill: #0075ff4d;
--html-select-arrow: url("/@htmlui/ua/arrow-down.svg");
--html-select-arrow-color: currentcolor;
--html-thumb: none;
--html-slider-fill: var(--html-accent, #0075ff);
--html-slider-height: 16px;
--html-slider-track-margin: 4px;
--html-slider-track-inset: 1px;
--html-slider-thumb-margin: -2px;
--html-slider-thumb-transform: scale(0.9375);
--html-slider-track-height: 6px;
--html-slider-track-border: 1px;
--html-slider-track-bg: #efefefff;
--html-slider-track-border-color: #b2b2b2ff;
--html-check-size: 13px;
--html-select-bg: #ffffffff;
--html-select-padding: 1px 0 1px 4px;
--html-select-arrow-width: 16px;
--html-button-padding: 2px 7px;
--html-button-border-width: 1px;
--html-button-border-style: solid;
--html-button-border: #767676ff;
--html-button-hover-bg: #e5e5e5ff;
--html-button-hover-border: #4f4f4fff;
--html-button-active-bg: #f5f5f5ff;
--html-button-active-border: #8d8d8dff;
--html-progress-border-width: 0.25em;
--html-progress-radius: 0.5em;
--html-progress-bg: #00000000;
--html-progress-track: inset 0 0 0 1px #b2b2b2, inset 0 0 0 1em #efefef;
--html-progress-fill-radius: 0.25em 0 0 0.25em;
--html-progress-fill: var(--html-accent, #0075ff);
}
#htmlui-root .button {
--html-check: html-layer("/@htmlui/ua/check.svg" 100% 100% 50% 50% no-repeat no-repeat padding-box border-box scroll);
--html-check-baseline: -3px;
--html-control-bg: #ffffffff;
--html-control-border: #767676ff;
--html-control-border-width: 1px;
--html-field-padding: 2px 3px;
--html-field-border-width: 1px;
--html-field-border-style: solid;
--html-control-radius: 2px;
--html-check-radius: 2px;
--html-radio-radius: 9999px;
--html-check-fill: var(--html-accent, #0075ff);
--html-radio-ring: inset 0 0 0 1.5px var(--html-accent-contrast, #ffffff);
--html-control-disabled-border: #7676764d;
--html-check-disabled-fill: #0075ff4d;
--html-select-arrow: url("/@htmlui/ua/arrow-down.svg");
--html-select-arrow-color: currentcolor;
--html-thumb: none;
--html-slider-fill: var(--html-accent, #0075ff);
--html-slider-height: 16px;
--html-slider-track-margin: 4px;
--html-slider-track-inset: 1px;
--html-slider-thumb-margin: -2px;
--html-slider-thumb-transform: scale(0.9375);
--html-slider-track-height: 6px;
--html-slider-track-border: 1px;
--html-slider-track-bg: #efefefff;
--html-slider-track-border-color: #b2b2b2ff;
--html-check-size: 13px;
--html-select-bg: #ffffffff;
--html-select-padding: 1px 0 1px 4px;
--html-select-arrow-width: 16px;
--html-button-padding: 2px 7px;
--html-button-border-width: 1px;
--html-button-border-style: solid;
--html-button-border: #767676ff;
--html-button-hover-bg: #e5e5e5ff;
--html-button-hover-border: #4f4f4fff;
--html-button-active-bg: #f5f5f5ff;
--html-button-active-border: #8d8d8dff;
--html-progress-border-width: 0.25em;
--html-progress-radius: 0.5em;
--html-progress-bg: #00000000;
--html-progress-track: inset 0 0 0 1px #b2b2b2, inset 0 0 0 1em #efefef;
--html-progress-fill-radius: 0.25em 0 0 0.25em;
--html-progress-fill: var(--html-accent, #0075ff);
}
