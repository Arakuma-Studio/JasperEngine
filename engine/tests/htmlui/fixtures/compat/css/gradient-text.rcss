#htmlui-root .title {
background-color: transparent;
decorator: none;
color: #feca57ff;
--html-current-color: #feca57ff;
}
#htmlui-root .title2 {
decorator: none;
color: #00000000;
--html-current-color: #00000000;
}
#htmlui-root .no-transparent {
background-color: transparent;
decorator: linear-gradient(#ff0000ff, #0000ffff) border-box;
}
#htmlui-root .base {
color: #00000000;
--html-current-color: #00000000;
decorator: linear-gradient(#ffd700ff, #ffa500ff) border-box;
}
#htmlui-root .base:hover {
decorator: none;
color: #ffa500ff;
--html-current-color: #ffa500ff;
}
