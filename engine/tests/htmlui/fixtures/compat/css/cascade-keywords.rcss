#htmlui-root .inherited {
color: var(--html-unset);
font-family: var(--html-unset);
line-height: var(--html-unset);
font-size: 1em;
}
#htmlui-root .inherited-initial {
color: #000000ff;
--html-current-color: #000000ff;
font-size: 16px;
line-height: 1.2;
text-align: left;
}
#htmlui-root .non-inherited {
margin-top: var(--html-unset);
margin-right: var(--html-unset);
margin-bottom: var(--html-unset);
margin-left: var(--html-unset);
padding-left: var(--html-unset);
width: var(--html-inh-width, auto);
display: var(--html-unset);
}
#htmlui-root .differs {
border-right-color: var(--html-current-color, #000000ff);
border-bottom-color: var(--html-current-color, #000000ff);
border-left-color: var(--html-current-color, #000000ff);
border-top-color: var(--html-current-color, #000000ff);
min-width: 0px;
}
#htmlui-root .revert {
color: var(--html-unset);
opacity: var(--html-unset);
}
#htmlui-root .shorthand {
background-color: var(--html-inh-background-color, transparent);
decorator: var(--html-inh-decorator, none);
border-top-width: var(--html-unset);
border-right-width: var(--html-unset);
border-bottom-width: var(--html-unset);
border-left-width: var(--html-unset);
border-top-color: var(--html-current-color, #000000ff);
border-right-color: var(--html-current-color, #000000ff);
border-bottom-color: var(--html-current-color, #000000ff);
border-left-color: var(--html-current-color, #000000ff);
font-style: var(--html-unset);
font-weight: var(--html-unset);
font-size: var(--html-unset);
line-height: var(--html-unset);
font-family: var(--html-unset);
}
#htmlui-root .parent {
width: 300px;
--html-inh-width: 300px;
}
#htmlui-root .reset {
margin-top: var(--html-unset);
