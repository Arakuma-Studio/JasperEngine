body#htmlui-root {
--dur: 0.25s;
--turn: 90deg;
}
#htmlui-root .t {
transition: opacity 0.2s ease-in, transform 0.5s;
animation: 1.5s infinite linear spin;
-html-animation-fill: none;
}
#htmlui-root .a {
transform: rotate(0.5turn) skewX(100grad);
filter: hue-rotate(3.14159rad);
}
#htmlui-root .b {
background-color: transparent;
decorator: linear-gradient(45deg, #ff0000ff, #0000ffff) border-box;
}
@keyframes spin {
100% {
transform: rotate(1turn);
}
}
