#htmlui-root .sub {
display: flex;
flex-wrap: wrap;
}
#htmlui-root .calc {
display: flex;
flex-wrap: wrap;
gap: 18px;
}
#htmlui-root .calc > :nth-child(2n+1) {
flex: 0 0 50%;
}
#htmlui-root .calc > :nth-child(2n+2) {
flex: 1 1 66.77%;
}
#htmlui-root .areas {
display: inline-flex;
flex-wrap: wrap;
}
#htmlui-root .areas > :nth-child(2n+1) {
flex: 1 1 22.32%;
}
#htmlui-root .areas > :nth-child(2n+2) {
flex: 2 1 44.54%;
}
#htmlui-root .legacy {
gap: 4px 8px;
row-gap: 2px;
column-gap: 3px;
}
