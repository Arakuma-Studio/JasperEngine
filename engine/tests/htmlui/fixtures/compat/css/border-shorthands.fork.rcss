#htmlui-root .all {
border-top-width: 2px;
border-top-style: solid;
border-top-color: #333333ff;
border-right-width: 2px;
border-right-style: solid;
border-right-color: #333333ff;
border-bottom-width: 2px;
border-bottom-style: solid;
border-bottom-color: #333333ff;
border-left-width: 2px;
border-left-style: solid;
border-left-color: #333333ff;
}
#htmlui-root .order {
border-top-width: 1px;
border-top-style: dashed;
border-top-color: #ff0000ff;
border-right-width: 1px;
border-right-style: dashed;
border-right-color: #ff0000ff;
border-bottom-width: 1px;
border-bottom-style: dashed;
border-bottom-color: #ff0000ff;
border-left-width: 1px;
border-left-style: dashed;
border-left-color: #ff0000ff;
}
#htmlui-root .width-only {
border-top-width: 4px;
border-top-style: none;
border-top-color: var(--html-current-color, #000000ff);
border-right-width: 4px;
border-right-style: none;
border-right-color: var(--html-current-color, #000000ff);
border-bottom-width: 4px;
border-bottom-style: none;
border-bottom-color: var(--html-current-color, #000000ff);
border-left-width: 4px;
border-left-style: none;
border-left-color: var(--html-current-color, #000000ff);
}
#htmlui-root .style-only {
border-top-width: 3px;
border-top-style: solid;
border-top-color: var(--html-current-color, #000000ff);
border-right-width: 3px;
border-right-style: solid;
border-right-color: var(--html-current-color, #000000ff);
border-bottom-width: 3px;
border-bottom-style: solid;
border-bottom-color: var(--html-current-color, #000000ff);
border-left-width: 3px;
border-left-style: solid;
border-left-color: var(--html-current-color, #000000ff);
}
#htmlui-root .none {
border-top-style: none;
border-top-color: var(--html-current-color, #000000ff);
border-right-style: none;
border-right-color: var(--html-current-color, #000000ff);
border-bottom-style: none;
border-bottom-color: var(--html-current-color, #000000ff);
border-left-style: none;
border-left-color: var(--html-current-color, #000000ff);
}
#htmlui-root .zero {
border-top-width: 0px;
border-top-style: none;
border-top-color: var(--html-current-color, #000000ff);
border-right-width: 0px;
border-right-style: none;
border-right-color: var(--html-current-color, #000000ff);
border-bottom-width: 0px;
border-bottom-style: none;
border-bottom-color: var(--html-current-color, #000000ff);
border-left-width: 0px;
border-left-style: none;
border-left-color: var(--html-current-color, #000000ff);
}
#htmlui-root .side {
border-top-width: 1px;
border-top-style: solid;
border-top-color: #ffffff1a;
border-bottom-width: 5px;
border-bottom-style: double;
border-bottom-color: #0000ffff;
}
#htmlui-root .widths {
border-width: 1px 2px 3px 4px;
border-top-color: #ff0000ff;
border-right-color: #008000ff;
border-bottom-color: #ff0000ff;
border-left-color: #008000ff;
}
#htmlui-root .width-keywords {
border-left-width: 1px;
border-right-width: 3px;
border-top-width: 5px;
}
#htmlui-root .colors {
border-right-color: #008000ff;
border-bottom-color: #0000ffff;
border-left-color: #ffff00ff;
border-top-color: #00000000;
}
#htmlui-root .var-color {
border-top-width: 1px;
border-top-style: solid;
border-top-color: var(--line);
border-right-width: 1px;
border-right-style: solid;
border-right-color: var(--line);
border-bottom-width: 1px;
border-bottom-style: solid;
border-bottom-color: var(--line);
border-left-width: 1px;
border-left-style: solid;
border-left-color: var(--line);
}
#htmlui-root .var-width {
border-top-width: var(--w);
border-right-width: var(--w);
border-bottom-width: var(--w);
border-left-width: var(--w);
}
#htmlui-root .var-all {
border-top-width: 1px;
border-top-style: solid;
border-top-color: #ff0000ff;
border-right-width: 1px;
border-right-style: solid;
border-right-color: #ff0000ff;
border-bottom-width: 1px;
border-bottom-style: solid;
border-bottom-color: #ff0000ff;
border-left-width: 1px;
border-left-style: solid;
border-left-color: #ff0000ff;
}
body#htmlui-root:root {
--line: #444444ff;
--b: 1px solid #ff0000ff;
}
