body#htmlui-root {
font-size: 16px;
}
body#htmlui-root {
--x: 1;
}
#htmlui-root htmlbody {
margin: 0;
}
body#htmlui-root > htmlbody {
padding: 0;
}
body#htmlui-root htmlbody .a {
color: #ff0000ff;
--html-current-color: #ff0000ff;
}
body#htmlui-root {
color: #0000ffff;
--html-current-color: #0000ffff;
}
body#htmlui-root .panel {
color: #008000ff;
--html-current-color: #008000ff;
}
body#htmlui-root.dark .panel {
color: #ffffffff;
--html-current-color: #ffffffff;
}
#htmlui-root .dark .card, body#htmlui-root.dark .card {
color: #000000ff;
--html-current-color: #000000ff;
}
#htmlui-root .theme, body#htmlui-root.theme {
--y: 2;
}
#htmlui-root [data-theme="dark"] .btn, body#htmlui-root[data-theme="dark"] .btn {
color: #808080ff;
--html-current-color: #808080ff;
}
#htmlui-root [data-other] .btn {
color: #ffc0cbff;
--html-current-color: #ffc0cbff;
}
#htmlui-root .not-on-root .x {
color: #008080ff;
--html-current-color: #008080ff;
}
#htmlui-root *, body#htmlui-root {
box-sizing: border-box;
}
#htmlui-root * > p, body#htmlui-root > p {
margin: 0;
}
body#htmlui-root:hover {
color: #ffa500ff;
--html-current-color: #ffa500ff;
}
