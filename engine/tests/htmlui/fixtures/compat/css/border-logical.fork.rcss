#htmlui-root .inline {
border-left-width: 1px;
border-left-style: solid;
border-left-color: #ff0000ff;
border-right-width: 1px;
border-right-style: solid;
border-right-color: #ff0000ff;
}
#htmlui-root .block {
border-top-width: 2px;
border-top-style: solid;
border-top-color: #0000ffff;
border-bottom-width: 2px;
border-bottom-style: solid;
border-bottom-color: #0000ffff;
}
#htmlui-root .start {
border-left-width: 3px;
border-left-style: solid;
border-left-color: #008000ff;
border-right-color: #ff0000ff;
}
#htmlui-root .block-start {
border-top-width: 4px;
border-bottom-style: none;
}
#htmlui-root .radius {
border-top-left-radius: 4px;
border-bottom-right-radius: 8px;
border-top-right-radius: 2px;
border-bottom-left-radius: 6px;
}
#htmlui-root .widths {
border-left-width: 5px;
border-right-width: 5px;
border-top-color: #aabbccff;
border-bottom-color: #aabbccff;
}
