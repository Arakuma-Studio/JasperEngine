#htmlui-root .s {
position: static;
}
#htmlui-root .r {
position: relative;
}
#htmlui-root .a {
position: absolute;
inset: 0;
}
#htmlui-root .fixed {
position: fixed;
top: 0;
left: 0;
}
#htmlui-root .sticky {
position: relative;
top: 0;
}
#htmlui-root .ws {
position: relative;
}
#htmlui-root .offsets {
top: 10px;
right: auto;
bottom: 5%;
left: -2em;
z-index: 10;
}
#htmlui-root .float2 {
float: right;
clear: both;
}
