#htmlui-root .solid {
border-top-width: 2px;
border-top-style: solid;
border-top-color: #808080ff;
border-right-width: 2px;
border-right-style: solid;
border-right-color: #808080ff;
border-bottom-width: 2px;
border-bottom-style: solid;
border-bottom-color: #808080ff;
border-left-width: 2px;
border-left-style: solid;
border-left-color: #808080ff;
border-image: none;
}
#htmlui-root .dashed {
border-top-width: 2px;
border-top-style: dashed;
border-top-color: #808080ff;
border-right-width: 2px;
border-right-style: dashed;
border-right-color: #808080ff;
border-bottom-width: 2px;
border-bottom-style: dashed;
border-bottom-color: #808080ff;
border-left-width: 2px;
border-left-style: dashed;
border-left-color: #808080ff;
border-image: none;
}
#htmlui-root .dotted {
border-top-width: 2px;
border-top-style: dotted;
border-top-color: #808080ff;
border-right-width: 2px;
border-right-style: dotted;
border-right-color: #808080ff;
border-bottom-width: 2px;
border-bottom-style: dotted;
border-bottom-color: #808080ff;
border-left-width: 2px;
border-left-style: dotted;
border-left-color: #808080ff;
border-image: none;
}
#htmlui-root .double {
border-top-width: 3px;
border-top-style: double;
border-top-color: #808080ff;
border-right-width: 3px;
border-right-style: double;
border-right-color: #808080ff;
border-bottom-width: 3px;
border-bottom-style: double;
border-bottom-color: #808080ff;
border-left-width: 3px;
border-left-style: double;
border-left-color: #808080ff;
border-image: none;
}
#htmlui-root .inset {
border-top-width: 2px;
border-top-style: inset;
border-top-color: #808080ff;
border-right-width: 2px;
border-right-style: inset;
border-right-color: #808080ff;
border-bottom-width: 2px;
border-bottom-style: inset;
border-bottom-color: #808080ff;
border-left-width: 2px;
border-left-style: inset;
border-left-color: #808080ff;
border-image: none;
}
#htmlui-root .outset {
border-top-width: 2px;
border-top-style: outset;
border-top-color: #808080ff;
border-right-width: 2px;
border-right-style: outset;
border-right-color: #808080ff;
border-bottom-width: 2px;
border-bottom-style: outset;
border-bottom-color: #808080ff;
border-left-width: 2px;
border-left-style: outset;
border-left-color: #808080ff;
border-image: none;
}
#htmlui-root .groove {
border-top-width: 2px;
border-top-style: groove;
border-top-color: #808080ff;
border-right-width: 2px;
border-right-style: groove;
border-right-color: #808080ff;
border-bottom-width: 2px;
border-bottom-style: groove;
border-bottom-color: #808080ff;
border-left-width: 2px;
border-left-style: groove;
border-left-color: #808080ff;
border-image: none;
}
#htmlui-root .ridge {
border-top-width: 2px;
border-top-style: ridge;
border-top-color: #808080ff;
border-right-width: 2px;
border-right-style: ridge;
border-right-color: #808080ff;
border-bottom-width: 2px;
border-bottom-style: ridge;
border-bottom-color: #808080ff;
border-left-width: 2px;
border-left-style: ridge;
border-left-color: #808080ff;
border-image: none;
}
#htmlui-root .inset-black {
border-top-width: 1px;
border-top-style: inset;
border-top-color: #000000ff;
border-right-width: 1px;
border-right-style: inset;
border-right-color: #000000ff;
border-bottom-width: 1px;
border-bottom-style: inset;
border-bottom-color: #000000ff;
border-left-width: 1px;
border-left-style: inset;
border-left-color: #000000ff;
border-image: none;
}
#htmlui-root .inset-var {
border-top-width: 1px;
border-top-style: inset;
border-top-color: var(--c);
border-right-width: 1px;
border-right-style: inset;
border-right-color: var(--c);
border-bottom-width: 1px;
border-bottom-style: inset;
border-bottom-color: var(--c);
border-left-width: 1px;
border-left-style: inset;
border-left-color: var(--c);
border-image: none;
}
#htmlui-root .hidden {
border-top-width: 3px;
border-top-style: hidden;
border-top-color: #ff0000ff;
border-right-width: 3px;
border-right-style: hidden;
border-right-color: #ff0000ff;
border-bottom-width: 3px;
border-bottom-style: hidden;
border-bottom-color: #ff0000ff;
border-left-width: 3px;
border-left-style: hidden;
border-left-color: #ff0000ff;
border-image: none;
}
#htmlui-root .style-alone {
border-top-style: solid;
border-right-style: solid;
border-bottom-style: solid;
border-left-style: solid;
}
#htmlui-root .style-none {
border-width: 2px;
border-top-style: none;
border-right-style: none;
border-bottom-style: none;
border-left-style: none;
}
#htmlui-root .style-sides {
border-top-style: solid;
border-right-style: none;
border-bottom-style: dashed;
border-left-style: none;
}
#htmlui-root .style-with-width {
border-width: 1px;
border-top-style: solid;
border-right-style: solid;
border-bottom-style: solid;
border-left-style: solid;
}
#htmlui-root .base {
border-width: 5px;
}
#htmlui-root .base:hover {
border-top-style: solid;
border-right-style: solid;
border-bottom-style: solid;
border-left-style: solid;
}
#htmlui-root .side-style {
border-bottom-style: dotted;
}
body#htmlui-root:root {
--c: #ff0000ff;
}
