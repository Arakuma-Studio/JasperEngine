#htmlui-root .same-rule {
color: #336699ff;
--html-current-color: #336699ff;
border-top-width: 2px;
border-top-color: #336699ff;
border-right-width: 2px;
border-right-color: #336699ff;
border-bottom-width: 2px;
border-bottom-color: #336699ff;
border-left-width: 2px;
border-left-color: #336699ff;
--html-box-shadow: 0px 0px 4px #336699ff;
box-shadow: var(--html-outline-shadow, 0 0 0 0 #0000), var(--html-box-shadow, 0 0 0 0 #0000);
}
#htmlui-root .companion {
background-color: var(--html-current-color, #000000ff);
--html-outline-shadow: 0 0 0 1px var(--html-current-color, #000000ff);
box-shadow: var(--html-outline-shadow, 0 0 0 0 #0000), var(--html-box-shadow, 0 0 0 0 #0000);
}
#htmlui-root .borders-no-color {
border-right-width: 3px;
border-right-color: var(--html-current-color, #000000ff);
border-bottom-width: 3px;
border-bottom-color: var(--html-current-color, #000000ff);
border-left-width: 3px;
border-left-color: var(--html-current-color, #000000ff);
border-top-width: 1px;
border-top-color: var(--html-current-color, #000000ff);
}
#htmlui-root .color-itself {
color: var(--html-unset);
}
#htmlui-root .icon {
fill: currentcolor;
stroke: currentcolor;
}
#htmlui-root .gradient {
background-color: transparent;
decorator: linear-gradient(var(--html-current-color, #000000ff), #00000000) border-box;
}
#htmlui-root .var-color {
color: var(--theme);
}
