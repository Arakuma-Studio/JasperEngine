#htmlui-root .t {
transform: translate(-50%, -50%) rotate(45deg) scale(1.5);
transform-origin: left top;
}
#htmlui-root .p {
perspective: 800px;
perspective-origin: 50% 0;
}
#htmlui-root .individual {
transform: translate(10px, 20px) rotate(45deg) scale(1.2);
}
#htmlui-root .with-transform {
transform: translate(0px, -2px) skewX(10deg);
}
#htmlui-root .transform-after {
transform: scale(2) rotate(10deg);
}
#htmlui-root .axis {
transform: translate3d(1px, 2px, 3px) rotateX(90deg) scale3d(1, 2, 3);
}
#htmlui-root .vector {
transform: rotate3d(1, 1, 0, 45deg);
}
#htmlui-root .percent-scale {
transform: scale(0.5, 1.5);
}
#htmlui-root .none {
transform: none;
}
#htmlui-root .base {
transform: translateY(0);
}
#htmlui-root .base:hover {
transform: translate(0px, -4px) translateY(0);
}
#htmlui-root .three-d {
transform: translate3d(0, 0, 10px) rotateX(10deg) matrix(1, 0, 0, 1, 0, 0);
}
#htmlui-root .invalid {
transform: none;
}
