<html>
<head>
    <link type="text/css" href="../common/base.css"/>
    <link type="text/css" href="p1.css"/>
    <style>
        /* G10: a filter chain, applied left to right */
        #chain { left: 60px; top: 60px; width: 200px; height: 200px; background-color: #e04020; filter: blur(2px) grayscale(1) opacity(0.7); }
        #chain div { position: absolute; left: 50px; top: 50px; width: 100px; height: 100px; background-color: #20a0e0; }
        #reference { left: 300px; top: 60px; width: 150px; height: 150px; background-color: #e04020; }
    </style>
</head>
<body>
    <div id="chain" class="abs"><div/></div>
    <div id="reference" class="abs"/>
</body>
</html>
