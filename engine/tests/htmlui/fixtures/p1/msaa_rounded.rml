<html>
<head>
    <link type="text/css" href="../common/base.css"/>
    <link type="text/css" href="p1.css"/>
    <style>
        /* G16: large radii and thin rotated borders, where MSAA smooths the edges */
        #disc { left: 30px; top: 30px; width: 200px; height: 200px; border-radius: 100px; background-color: #e0e0e0; }
        #ring { left: 270px; top: 30px; width: 200px; height: 200px; border-radius: 100px; border: 2px #ffcc00; }
        #thin { left: 60px; top: 270px; width: 380px; height: 60px; border: 1px #ffffff; transform: rotate(4deg); }
    </style>
</head>
<body>
    <div id="disc" class="abs"/><div id="ring" class="abs"/><div id="thin" class="abs"/>
</body>
</html>
