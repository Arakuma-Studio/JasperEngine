<html>
<head>
    <title>update mode</title>
    <style>
        body { width: 100%; height: 100%; margin: 0px; }
        #slide { position: absolute; left: 0px; top: 0px; width: 10px; height: 10px; background-color: #ff0000ff; transition: left 1s linear-in-out; }
        #keys { position: absolute; left: 0px; top: 20px; width: 10px; height: 10px; background-color: #00ff00ff; animation: 4s linear-in-out slide; }
        #move { position: absolute; left: 0px; top: 40px; width: 10px; height: 10px; background-color: #0000ffff; }
        @keyframes slide { from { left: 0px; } to { left: 400px; } }
    </style>
</head>
<body>
    <div id="slide"></div>
    <div id="keys"></div>
    <div id="move"></div>
</body>
</html>
