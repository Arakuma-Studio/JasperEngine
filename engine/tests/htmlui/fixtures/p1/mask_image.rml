<html>
<head>
    <link type="text/css" href="../common/base.css"/>
    <link type="text/css" href="p1.css"/>
    <style>
        /* G15: mask-image (SaveLayerAsMaskImage) from a gradient and from an image */
        .m { top: 60px; width: 200px; height: 200px; background-color: #e04020; }
        .m div { position: absolute; left: 50px; top: 50px; width: 100px; height: 100px; background-color: #2040e0; }
        #gradient { left: 30px; mask-image: linear-gradient(90deg, #000000ff, #00000000); }
        #image { left: 280px; mask-image: image(../common/alpha50.png); }
    </style>
</head>
<body>
    <div id="gradient" class="abs m"><div/></div>
    <div id="image" class="abs m"><div/></div>
</body>
</html>
