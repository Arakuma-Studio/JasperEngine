<html>
<head>
    <title>texture form</title>
    <link type="text/css" href="../common/base.css"/>
    <style>
        /* a TEXTURE-mode document with a text field and a data model (keys, text, scripting) */
        body { position: absolute; left: 0; top: 0; width: 100%; height: 100%; margin: 0; padding: 0; }
        #name { position: absolute; left: 0; top: 0; width: 256px; height: 64px; font-size: 24px;
                background-color: #ffffff; color: #000000; display: block; }
        #bound { position: absolute; left: 0; top: 160px; font-size: 24px; color: #ffff00; }
    </style>
</head>
<body>
    <input id="name" type="text" value=""/>
    <div data-model="form"><span id="bound">{{ label }}</span></div>
</body>
</html>
