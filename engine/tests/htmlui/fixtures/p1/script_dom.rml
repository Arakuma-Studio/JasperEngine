<html>
<head>
    <title>script dom</title>
    <link type="text/css" href="../common/base.css"/>
    <style>
        body { width: 100%; height: 100%; margin: 0px; }
        input { display: inline-block; width: 120px; height: 20px; }
        .item { height: 20px; }
        #scroller { position: absolute; left: 0px; top: 200px; width: 100px; height: 50px; overflow: auto; }
        #tall { height: 400px; }
        scrollbarvertical { width: 10px; }
        scrollbarvertical sliderbar { height: 20px; background-color: #ffffffff; }
        #btn { position: absolute; left: 300px; top: 20px; width: 100px; height: 40px; background-color: #808080ff; }
        #moved { position: absolute; left: 10px; top: 300px; width: 50px; height: 20px; transform: translateX(30px); }
    </style>
</head>
<body>
    <div id="outer" class="a b" data-user-name="ann" title="T">
        <div id="list"><div class="item" id="i1">one</div><div class="item" id="i2">two</div><div class="item" id="i3">three</div></div>
    </div>
    <input id="text" type="text" value="hello"/>
    <input id="check" type="checkbox"/>
    <div id="scroller"><div id="tall"></div></div>
    <div id="btn"><span id="label">Button</span></div>
    <div id="moved"></div>
</body>
</html>
