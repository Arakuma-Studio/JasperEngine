<html>
<head>
    <link type="text/css" href="../common/base.css"/>
    <link type="text/css" href="p1.css"/>
    <style>
        /* G03: an inset box-shadow with a radius, which RmlUi clips with SetInverse */
        #inset { left: 60px; top: 60px; width: 240px; height: 180px; border-radius: 40px; background-color: #e0e0e0;
                 box-shadow: #c02020 0px 0px 0px 20px inset; }
    </style>
</head>
<body>
    <div id="inset" class="abs"/>
</body>
</html>
