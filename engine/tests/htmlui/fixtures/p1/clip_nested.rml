<html>
<head>
    <link type="text/css" href="../common/base.css"/>
    <link type="text/css" href="p1.css"/>
    <style>
        /* G02: three nested rounded clips (Set, Intersect, Intersect: refs 1, 2, 3) */
        #a { left: 20px; top: 20px; width: 300px; height: 300px; border-radius: 60px; overflow: hidden; background-color: #802020; }
        #b { position: absolute; left: 100px; top: 40px; width: 300px; height: 200px; border-radius: 40px; overflow: hidden; background-color: #208020; }
        #c { position: absolute; left: -80px; top: 60px; width: 250px; height: 250px; border-radius: 30px; overflow: hidden; background-color: #202080; }
        #fill { position: absolute; left: -500px; top: -500px; width: 2000px; height: 2000px; background-color: #e0e040; }
    </style>
</head>
<body>
    <div id="a" class="abs"><div id="b"><div id="c"><div id="fill"/></div></div></div>
</body>
</html>
