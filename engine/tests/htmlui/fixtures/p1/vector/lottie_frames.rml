<html>
<head>
    <link type="text/css" href="../../common/base.css"/>
    <link type="text/css" href="vector.css"/>
    <style>
        #json { left: 16px; top: 16px; width: 200px; height: 200px; }
        #dot { left: 248px; top: 16px; width: 200px; height: 200px; }
        #tinted { left: 16px; top: 240px; width: 120px; height: 120px; image-color: #80ff80; opacity: 0.75; }
        #wide { left: 160px; top: 260px; width: 320px; height: 100px; background-color: #303030; }
    </style>
</head>
<body>
    <lottie id="json" class="abs" src="../lottie/shapes.json" autoplay="autoplay" loop="loop"/>
    <lottie id="dot" class="abs" src="../lottie/deflate_v2.lottie" marker="loop"/>
    <lottie id="tinted" class="abs" src="../lottie/shapes.json"/>
    <lottie id="wide" class="abs" src="../lottie/shapes.json"/>
</body>
</html>
