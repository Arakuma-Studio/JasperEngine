<html>
<head>
    <link type="text/css" href="../../common/base.css"/>
    <link type="text/css" href="vector.css"/>
    <style>
        #inline { left: 16px; top: 16px; width: 480px; height: 352px; }
    </style>
</head>
<body>
    <svg id="inline" class="abs" width="480" height="352" viewBox="0 0 480 352">
        <defs>
            <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#ff3030"/>
                <stop offset="100%" stop-color="#3030ff"/>
            </linearGradient>
            <radialGradient id="glow" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#ffffff"/>
                <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
            </radialGradient>
        </defs>
        <rect x="10" y="10" width="300" height="100" rx="16" fill="url(#grad)"/>
        <circle cx="400" cy="60" r="50" fill="url(#glow)"/>
        <path d="M20 150 C 120 110, 200 210, 300 150 S 440 170, 460 140" fill="none" stroke="#40e0a0" stroke-width="8" stroke-linecap="round"/>
        <polyline points="20,220 80,190 140,230 200,200" fill="none" stroke="#ffd040" stroke-width="4" stroke-dasharray="12 6"/>
        <text x="20" y="300" font-family="sans-serif" font-size="40" fill="#ffffff">Vector 123</text>
        <rect x="300" y="250" width="150" height="80" fill="none" stroke="#e0e0e0" stroke-width="3" stroke-linejoin="round"/>
    </svg>
</body>
</html>
