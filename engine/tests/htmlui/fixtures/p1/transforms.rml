<html>
<head>
    <link type="text/css" href="../common/base.css"/>
    <link type="text/css" href="p1.css"/>
    <style>
        /* G05: 2D transforms and a 3D rotation under perspective */
        .t { width: 80px; height: 60px; }
        #translate { left: 20px; top: 20px; background-color: #e04040; transform: translate(20px, 10px); }
        #rotate { left: 150px; top: 30px; background-color: #40e040; transform: rotate(30deg); }
        #scale { left: 280px; top: 30px; background-color: #4040e0; transform: scale(1.4, 0.7); }
        #skew { left: 400px; top: 30px; background-color: #e0e040; transform: skew(20deg, 0deg); }
        #stage { left: 100px; top: 160px; width: 300px; height: 200px; perspective: 400px; background-color: #303030; }
        #persp { position: absolute; left: 75px; top: 50px; width: 150px; height: 100px; background-color: #c040c0; transform: rotateY(45deg); }
    </style>
</head>
<body>
    <div id="translate" class="abs t"/>
    <div id="rotate" class="abs t"/>
    <div id="scale" class="abs t"/>
    <div id="skew" class="abs t"/>
    <div id="stage" class="abs"><div id="persp"/></div>
</body>
</html>
