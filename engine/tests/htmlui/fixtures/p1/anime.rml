<html>
<head>
    <title>anime</title>
    <style>
        body { width: 100%; height: 100%; margin: 0px; font-family: sans-serif; }
        #box { position: absolute; left: 10px; top: 10px; width: 100px; height: 50px; background-color: #ff0000ff; }
        #styled { position: absolute; left: 200px; top: 10px; width: 40px; height: 40px; background-color: #00ff00ff; }
        .card { display: block; width: 50px; height: 20px; margin: 2px; background-color: #0000ffff; }
        #holder { position: absolute; left: 10px; top: 120px; width: 200px; }
        #label { position: absolute; left: 300px; top: 10px; font-size: 16px; color: #000000ff; }
        #vars { position: absolute; left: 300px; top: 60px; width: 20px; height: 20px; --glow: 0px; }
    </style>
</head>
<body>
    <div id="box"></div>
    <div id="styled" style="transform: translateY(10px) rotate(5deg);"></div>
    <div id="holder">
        <div class="card"></div>
        <div class="card"></div>
        <div class="card"></div>
        <div id="dyn"></div>
    </div>
    <p id="label">0</p>
    <div id="vars"></div>
</body>
</html>
