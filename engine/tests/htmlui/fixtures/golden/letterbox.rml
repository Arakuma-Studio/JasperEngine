<html>
<head>
    <title>letterbox</title>
    <link type="text/css" href="../common/base.css"/>
    <link type="text/css" href="golden.css"/>
    <style>
        /* fills the canvas: the letterboxed view rect shows exactly this */
        body { background-color: #3060c0; }
        .mark { width: 40px; height: 40px; }
        #tl { left: 0px; top: 0px; background-color: #ff0000; }
        #tr { right: 0px; top: 0px; background-color: #00ff00; }
        #bl { left: 0px; bottom: 0px; background-color: #ffff00; }
        #br { right: 0px; bottom: 0px; background-color: #ff00ff; }
        #label { left: 200px; top: 160px; font-size: 32px; }
    </style>
</head>
<body>
    <div id="tl" class="abs mark"/>
    <div id="tr" class="abs mark"/>
    <div id="bl" class="abs mark"/>
    <div id="br" class="abs mark"/>
    <div id="label" class="abs">Letterbox</div>
</body>
</html>
