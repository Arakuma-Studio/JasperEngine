<html>
<head>
    <title>flexbox</title>
    <link type="text/css" href="../common/base.css"/>
    <link type="text/css" href="golden.css"/>
    <style>
        .row { left: 10px; width: 300px; height: 40px; display: flex; flex-direction: row; gap: 10px; background-color: #303030; }
        .item { width: 40px; height: 30px; }
        .a { background-color: #e04040; }
        .b { background-color: #40e040; }
        .c { background-color: #4040e0; }
        #start { top: 10px; justify-content: flex-start; }
        #center { top: 60px; justify-content: center; }
        #between { top: 110px; justify-content: space-between; }
        #grow { top: 160px; }
        #grow .item { width: 10px; }
        #grow .g1 { flex-grow: 1; }
        #grow .g2 { flex-grow: 2; }
        .align { top: 210px; width: 90px; height: 80px; display: flex; flex-direction: row; gap: 5px; background-color: #303030; }
        .align .item { width: 25px; }
        .align .tall { height: 60px; }
        #astart { left: 10px; align-items: flex-start; }
        #acenter { left: 115px; align-items: center; }
        #aend { left: 220px; align-items: flex-end; }
        /* six 40 px items and five gaps per 290 px line: the seventh wraps */
        #wrap { left: 10px; top: 300px; width: 300px; height: 50px; display: flex; flex-wrap: wrap; gap: 10px; background-color: #303030; }
        #wrap .item { width: 40px; height: 20px; }
        /* a card centered in its area (the usual menu layout) */
        #stage { left: 330px; top: 10px; width: 300px; height: 230px; display: flex; justify-content: center; align-items: center; background-color: #283848; }
        #card { width: 200px; height: 130px; display: flex; flex-direction: column; background-color: #f0f0f0; border: 2px #c0c0c0; border-radius: 8px; }
        #card-header { height: 30px; background-color: #3060c0; }
        #card-body { flex-grow: 1; display: flex; flex-direction: row; gap: 8px; padding: 8px; }
        #card-body .cell { flex-grow: 1; background-color: #d0a030; }
        #card-footer { height: 30px; display: flex; flex-direction: row; justify-content: space-between; align-items: center; padding: 0 8px; }
        #card-footer .button { width: 60px; height: 20px; background-color: #40a040; }
        #column { left: 330px; top: 250px; width: 300px; height: 100px; display: flex; flex-direction: column; justify-content: space-between; align-items: center; background-color: #303030; }
        #column .item { width: 50px; height: 20px; }
    </style>
</head>
<body>
    <div id="start" class="row abs"><div class="item a"/><div class="item b"/><div class="item c"/></div>
    <div id="center" class="row abs"><div class="item a"/><div class="item b"/><div class="item c"/></div>
    <div id="between" class="row abs"><div class="item a"/><div class="item b"/><div class="item c"/></div>
    <div id="grow" class="row abs"><div class="item a g1"/><div class="item b g2"/><div class="item c g1"/></div>
    <div id="astart" class="align abs"><div class="item a"/><div class="item b tall"/><div class="item c"/></div>
    <div id="acenter" class="align abs"><div class="item a"/><div class="item b tall"/><div class="item c"/></div>
    <div id="aend" class="align abs"><div class="item a"/><div class="item b tall"/><div class="item c"/></div>
    <div id="wrap" class="abs">
        <div class="item a"/><div class="item b"/><div class="item c"/><div class="item a"/>
        <div class="item b"/><div class="item c"/><div class="item a"/><div class="item b"/>
    </div>
    <div id="stage" class="abs">
        <div id="card">
            <div id="card-header"/>
            <div id="card-body"><div class="cell"/><div class="cell"/><div class="cell"/></div>
            <div id="card-footer"><div class="button"/><div class="button"/></div>
        </div>
    </div>
    <div id="column" class="abs"><div class="item a"/><div class="item b"/><div class="item c"/></div>
</body>
</html>
