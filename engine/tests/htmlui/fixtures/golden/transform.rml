<html>
<head>
    <title>transform</title>
    <link type="text/css" href="../common/base.css"/>
    <link type="text/css" href="golden.css"/>
    <style>
        .box { width: 100px; height: 60px; font-size: 18px; line-height: 60px; text-align: center; color: #ffffff; }
        #reference { left: 20px; top: 40px; background-color: #606060; }
        #rotate { left: 160px; top: 40px; background-color: #e04040; transform: rotate(15deg); }
        #scale { left: 320px; top: 40px; background-color: #40a040; transform: scale(1.5); }
        #translate { left: 20px; top: 200px; background-color: #4040e0; transform: translate(30px, 20px); }
        #stage { left: 200px; top: 180px; width: 200px; height: 150px; perspective: 300px; background-color: #303030; }
        #persp { position: absolute; left: 50px; top: 40px; width: 100px; height: 70px; font-size: 18px; line-height: 70px;
                 text-align: center; color: #000000; background-color: #e0c040; transform: rotateY(40deg); }
        #origin { left: 480px; top: 200px; background-color: #40c0e0; transform-origin: 0 0; transform: rotate(-20deg) scale(0.8);
                  border: 4px solid #ffffff; border-radius: 10px; }
    </style>
</head>
<body>
    <div id="reference" class="abs box">Text</div>
    <div id="rotate" class="abs box">Rotate</div>
    <div id="scale" class="abs box">Scale</div>
    <div id="translate" class="abs box">Move</div>
    <div id="stage" class="abs"><div id="persp">Persp</div></div>
    <div id="origin" class="abs box">Origin</div>
</body>
</html>
