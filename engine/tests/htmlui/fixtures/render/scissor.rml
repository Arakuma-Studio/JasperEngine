<html>
<head>
    <link type="text/css" href="../common/base.css"/>
    <link type="text/css" href="render.css"/>
    <style>
        #clip { left: 20px; top: 20px; width: 200px; height: 100px; overflow: hidden; background-color: #303060; }
        /* children in normal flow: RmlUi clips what overflows the scrollable area, and an
           absolutely placed child does not add to it */
        #big { margin-left: -50px; margin-top: 30px; width: 300px; height: 200px; background-color: #e08020; }
        #outer { left: 260px; top: 20px; width: 160px; height: 160px; overflow: hidden; background-color: #306030; }
        #innerclip { margin-left: 80px; margin-top: 80px; width: 160px; height: 160px; overflow: hidden; background-color: #603030; }
        #innerbig { margin-left: 20px; margin-top: 20px; width: 400px; height: 400px; background-color: #20c0c0; }
        #list { left: 460px; top: 20px; width: 160px; height: 200px; overflow: hidden; background-color: #202020; }
        .stripe { height: 20px; }
        .s0 { background-color: #ff4040; }
        .s1 { background-color: #40ff40; }
        .s2 { background-color: #4040ff; }
        .s3 { background-color: #ffff40; }
        #unclipped { left: 20px; top: 260px; width: 600px; height: 40px; background-color: #808080; }
    </style>
</head>
<body>
    <div id="clip" class="abs"><div id="big"/></div>
    <div id="outer" class="abs"><div id="innerclip"><div id="innerbig"/></div></div>
    <div id="list" class="abs">
        <div class="stripe s0"/><div class="stripe s1"/><div class="stripe s2"/><div class="stripe s3"/>
        <div class="stripe s0"/><div class="stripe s1"/><div class="stripe s2"/><div class="stripe s3"/>
        <div class="stripe s0"/><div class="stripe s1"/><div class="stripe s2"/><div class="stripe s3"/>
        <div class="stripe s0"/><div class="stripe s1"/><div class="stripe s2"/><div class="stripe s3"/>
    </div>
    <div id="unclipped" class="abs"/>
</body>
</html>
