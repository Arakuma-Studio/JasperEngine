<html>
<head>
    <link type="text/css" href="../common/base.css"/>
    <link type="text/css" href="render.css"/>
    <style>
        #checker1 { left: 20px; top: 20px; }
        #checker25 { left: 110px; top: 20px; width: 160px; height: 160px; }
        #white { left: 300px; top: 20px; width: 64px; height: 64px; background-color: #ffffff; }
        #alpha { position: absolute; left: 16px; top: 16px; }
        #decorated { left: 400px; top: 20px; width: 64px; height: 64px; decorator: image(../common/checker.png); }
        #icon1 { left: 500px; top: 20px; }
        #icon3 { left: 540px; top: 20px; width: 72px; height: 72px; }
        #alphabg { left: 300px; top: 120px; }
    </style>
</head>
<body>
    <img id="checker1" class="abs" src="../common/checker.png"/>
    <img id="checker25" class="abs" src="../common/checker.png"/>
    <div id="white" class="abs"><img id="alpha" src="../common/alpha50.png"/></div>
    <div id="decorated" class="abs"/>
    <img id="icon1" class="abs" src="../common/icon.svg"/>
    <img id="icon3" class="abs" src="../common/icon.svg"/>
    <img id="alphabg" class="abs" src="../common/alpha50.png"/>
</body>
</html>
