# The prebuilt player variants (docs/specs/S34-player-size.md R4, D2): engine/player/variants.json
# names the module sets release players are built for. tools/build.sh players, the CI jobs and the
# Android player's Gradle build pass -DJASPERENGINE_PLAYER_VARIANT=<name>; the editor reads the
# modules a runtime has from its player-info.json.

include_guard(DIRECTORY)

set(JASPERENGINE_PLAYER_VARIANTS_FILE "${CMAKE_CURRENT_LIST_DIR}/../player/variants.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${JASPERENGINE_PLAYER_VARIANTS_FILE}")

# module name -> the option that compiles it
set(JASPERENGINE_MODULE_OPTION_htmlui JASPERENGINE_HTMLUI)
set(JASPERENGINE_MODULE_OPTION_video JASPERENGINE_VIDEO)
set(JASPERENGINE_MODULE_OPTION_runtimeshaders JASPERENGINE_RUNTIME_SHADERS)
set(JASPERENGINE_MODULE_OPTION_physics3d JASPERENGINE_PHYSICS_3D)
set(JASPERENGINE_MODULE_OPTION_physics2d JASPERENGINE_PHYSICS_2D)
set(JASPERENGINE_MODULE_OPTION_navigation JASPERENGINE_NAVIGATION)
set(JASPERENGINE_MODULE_OPTION_soundlayer JASPERENGINE_SOUND_LAYER)

# jasperengine_player_variant(<name> <suffix variable>): sets every module option of the caller's
# scope ON or OFF as the variant lists it, and the variant's id suffix ("" for the full player)
macro(jasperengine_player_variant variantName suffixVariable)
    file(READ "${JASPERENGINE_PLAYER_VARIANTS_FILE}" _jeVariantsJson)
    string(JSON _jeModuleCount LENGTH "${_jeVariantsJson}" modules)
    string(JSON _jeVariantCount LENGTH "${_jeVariantsJson}" variants)
    set(_jeVariantIndex -1)
    set(_jeVariantNames "")
    math(EXPR _jeLastVariant "${_jeVariantCount} - 1")
    foreach(_jeIndex RANGE ${_jeLastVariant})
        string(JSON _jeName GET "${_jeVariantsJson}" variants ${_jeIndex} name)
        list(APPEND _jeVariantNames ${_jeName})
        if(_jeName STREQUAL "${variantName}")
            set(_jeVariantIndex ${_jeIndex})
        endif()
    endforeach()
    if(_jeVariantIndex EQUAL -1)
        string(REPLACE ";" ", " _jeVariantNames "${_jeVariantNames}")
        message(FATAL_ERROR "JASPERENGINE_PLAYER_VARIANT=${variantName} is not in engine/player/variants.json (${_jeVariantNames})")
    endif()
    string(JSON ${suffixVariable} GET "${_jeVariantsJson}" variants ${_jeVariantIndex} suffix)
    set(_jeVariantModules "")
    string(JSON _jeCount LENGTH "${_jeVariantsJson}" variants ${_jeVariantIndex} modules)
    if(_jeCount GREATER 0)
        math(EXPR _jeLast "${_jeCount} - 1")
        foreach(_jeIndex RANGE ${_jeLast})
            string(JSON _jeModule GET "${_jeVariantsJson}" variants ${_jeVariantIndex} modules ${_jeIndex})
            list(APPEND _jeVariantModules ${_jeModule})
        endforeach()
    endif()
    math(EXPR _jeLastModule "${_jeModuleCount} - 1")
    foreach(_jeIndex RANGE ${_jeLastModule})
        string(JSON _jeModule GET "${_jeVariantsJson}" modules ${_jeIndex})
        if(NOT DEFINED JASPERENGINE_MODULE_OPTION_${_jeModule})
            message(FATAL_ERROR "engine/player/variants.json: unknown module ${_jeModule}")
        endif()
        if(_jeModule IN_LIST _jeVariantModules)
            set(${JASPERENGINE_MODULE_OPTION_${_jeModule}} ON)
        else()
            set(${JASPERENGINE_MODULE_OPTION_${_jeModule}} OFF)
        endif()
    endforeach()
    foreach(_jeModule IN LISTS _jeVariantModules)
        if(NOT DEFINED JASPERENGINE_MODULE_OPTION_${_jeModule})
            message(FATAL_ERROR "engine/player/variants.json: variant ${variantName} lists the unknown module ${_jeModule}")
        endif()
    endforeach()
    string(REPLACE ";" " " _jeVariantModulesText "${_jeVariantModules}")
    message(STATUS "Player variant ${variantName}: ${_jeVariantModulesText}")
endmacro()
