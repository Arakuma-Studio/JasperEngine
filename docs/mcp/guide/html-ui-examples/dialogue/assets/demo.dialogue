      ],
      "params": {
        "speaker": "Captain Mira",
        "text": "The archive doors are sealed and the tide is rising. We have one shot at this. How do we get in?",
        "variants": [],
        "variant_mode": "random",
        "mood": "",
        "tags": [],
        "options": [
          {
            "id": "o1",
            "text": "Blow the doors with a charge."
          },
          {
            "id": "o2",
            "text": "Look for the old maintenance shaft."
          },
          {
            "id": "o3",
            "text": "Wait for the tide to turn."
          }
        ],
